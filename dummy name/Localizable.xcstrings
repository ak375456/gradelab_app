        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canale rosso. Alzarlo aggiunge rosso; abbassarlo tende al ciano."
          }
        }
      }
    },
    "Red, green and blue levels against horizontal image position" : {
      "localizations" : {
