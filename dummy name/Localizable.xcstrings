        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier existe déjà à la destination d'export choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file nella destinazione di esportazione scelta."
          }
        }
      }
    },
    "A fill color with zero opacity leaves an outline-only shape. Set a stroke width under Stroke." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Füllfarbe mit null Deckkraft ergibt eine Form, die nur aus ihrer Kontur besteht. Die Konturstärke stellst du unter „Kontur“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un color de relleno con opacidad cero deja una forma hecha solo de contorno. Ajusta el grosor en Contorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une couleur de remplissage à opacité nulle laisse une forme réduite à son contour. Réglez son épaisseur dans Contour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un colore di riempimento con opacità zero lascia una forma fatta solo di contorno. Imposta lo spessore in Contorno."
          }
        }
      }
    },
