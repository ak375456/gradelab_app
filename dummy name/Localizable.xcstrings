    "A freehand mask needs at least three points. Tap around the subject to draw one." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Freihandmaske braucht mindestens drei Punkte. Tippe rund um das Motiv, um eine zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una máscara a mano alzada necesita al menos tres puntos. Toca alrededor del sujeto para dibujarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vapaakätinen maski tarvitsee vähintään kolme pistettä. Napauta kohteen ympäri piirtääksesi yhden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
