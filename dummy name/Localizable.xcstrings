    "Tracking stopped after 120,000 frames. Draw the lasso again later in the clip to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tracking wurde nach 120.000 Frames gestoppt. Zeichne das Lasso später im Clip erneut, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rastreo se ha detenido tras 120 000 fotogramas. Vuelve a dibujar el lazo más adelante en el clip para continuar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jäljitys pysähtyi 120 000 kuvan jälkeen. Piirrä lasso uudelleen myöhemmin leike, jotta voit jatkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi s’est arrêté après 120 000 images. Redessinez le lasso plus loin dans le clip pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tracciamento si è interrotto dopo 120.000 fotogrammi. Ridisegna il lazo più avanti nella clip per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120,000フレームでトラッキングを停止しました。続けるには、クリップの後の位置で投げなわを描き直してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårningen stoppade efter 120 000 bildrutor. Rita lassot igen längre fram i klippet för att fortsätta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟踪在120,000帧后停止。稍后在片段中再次绘制套索以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤在120,000影格後停止。稍後在片段中再次繪製套索以繼續。"
          }
        }
      }
    },
    "Tracking stopped because the clip or mask geometry changed. Start tracking again from the current frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tracking wurde gestoppt, weil sich die Clip- oder Maskengeometrie geändert hat. Starte das Tracking ab dem aktuellen Frame neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rastreo se ha detenido porque la geometría del clip o de la máscara ha cambiado. Vuelve a iniciar el rastreo desde el fotograma actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seuranta loppui, koska leikkeen tai maski geometria muuttui. Aloita seuranta uudelleen nykyisestä ruutu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi s’est arrêté car la géométrie du clip ou du masque a changé. Relancez le suivi depuis l’image actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tracciamento si è interrotto perché la geometria della clip o della maschera è cambiata. Riavvia il tracciamento dal fotogramma corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップまたはマスクの形状が変わったため、トラッキングを停止しました。現在のフレームからやり直してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårningen stoppade eftersom klippets eller maskens geometri ändrades. Börja spåra igen från den aktuella bildrutan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于片段或蒙版几何形状发生变化，跟踪停止。从当前帧再次开始跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於片段或遮罩幾何形狀發生變化，追蹤停止。從當前影格再次開始追蹤。"
          }
        }
      }
    },
