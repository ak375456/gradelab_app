        }
      }
    },
    "The P3 original is preserved. GradeLab converts its colors to Rec.709 at 10-bit precision for consistent editing and export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das P3-Original bleibt erhalten. GradeLab wandelt seine Farben mit 10-Bit-Präzision in Rec.709 um, für einheitliche Bearbeitung und Export."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The P3 original is preserved. GradeLab converts its colors to Rec.709 at 10-bit precision for consistent editing and export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conserva el original P3. GradeLab convierte sus colores a Rec.709 con precisión de 10 bits para editar y exportar de forma coherente."
