          }
        }
      }
    },
    "A freeze needs the source's frame rate, and this media does not report one." : {
      "comment" : "Error message when a freeze is requested on a media that does not report a frame rate.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Standbild braucht die Bildrate der Quelle, und dieses Medium gibt keine an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un congelado necesita la velocidad de fotogramas del origen, y este material no indica ninguna."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jäädytys vaatii lähteen kuvanopeuden, eikä tämä media raportoi siitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arrêt sur image a besoin de la cadence de la source, et ce média n'en indique aucune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fermo immagine richiede il frame rate della sorgente, e questo contenuto non lo dichiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フリーズにはソースのフレームレートが必要ですが、このメディアにはフレームレート情報がありません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En frysbild behöver källans bildfrekvens, och det här mediet anger ingen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冻结需要源的帧率，而此媒体不报告帧率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凍結需要源的影格率，而此媒體不報告影格率。"
          }
        }
      }
    },
    "A gentle pass for clean daylight footage with a little grain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter Durchgang für sauberes Tageslichtmaterial mit etwas Korn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pasada suave para material limpio de luz de día con algo de grano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hellävarainen syöttö puhtaaseen päivänvalon kuvamateriaaliin, jossa on vähän jyviä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passage doux pour des images propres en lumière du jour avec un peu de grain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passaggio delicato per materiale pulito in luce diurna con un po' di grana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し粒子感のある、明るい日中の映像向けの穏やかな処理。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mild behandling för rent dagsljusmaterial med lite korn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合干净日光素材的轻度处理，并保留少量颗粒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適合乾淨日光素材的輕度處理，並保留少量顆粒。"
          }
        }
      }
    },
    "A gradient replaces the flat fill. Stroke, shadow and glow keep their own colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verlauf ersetzt die einfarbige Füllung. Kontur, Schatten und Glow behalten ihre eigenen Farben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un degradado sustituye al relleno plano. El contorno, la sombra y el glow conservan sus propios colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaltevuus korvaa tasaisen täytteen. Isku, varjo ja hehku säilyttävät omat värinsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dégradé remplace le remplissage uni. Le contour, l'ombre et le glow conservent leurs propres couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gradiente sostituisce il riempimento pieno. Contorno, ombra e glow mantengono i propri colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単色の塗りをグラデーションに置き換えます。線、シャドウ、グローの色は維持されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gradient ersätter den enfärgade fyllningen. Kantlinje, skugga och glow behåller sina egna färger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以渐变替代纯色填充，描边、阴影和辉光仍保留各自的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以漸層替代純色填充，描邊、陰影和輝光仍保留各自的顏色。"
          }
        }
      }
    },
    "A gradient replaces the flat text color. Stroke, background, shadow and glow keep their own colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verlauf ersetzt die einfarbige Textfarbe. Kontur, Hintergrund, Schatten und Glow behalten ihre eigenen Farben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un degradado sustituye al color plano del texto. El contorno, el fondo, la sombra y el glow conservan sus propios colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaltevuus korvaa litteän tekstin värin. Stroke, tausta, varjo ja hehku säilyttävät omat värinsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dégradé remplace la couleur unie du texte. Le contour, l'arrière-plan, l'ombre et le glow conservent leurs propres couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gradiente sostituisce il colore pieno del testo. Contorno, sfondo, ombra e glow mantengono i propri colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
