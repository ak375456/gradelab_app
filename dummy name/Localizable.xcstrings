    "Every animated property keeps the value you can see now. Masked grades are cleared too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede animierte Eigenschaft behält den Wert, den du jetzt siehst. Maskierte Gradings werden ebenfalls gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada propiedad animada conserva el valor que se ve ahora. Los etalonajes enmascarados también se borran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque propriété animée conserve la valeur affichée actuellement. Les étalonnages masqués sont également effacés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
