    "Tap the picture to pick a colour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Bild, um eine Farbe auszuwählen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la imagen para tomar un color"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'image pour prélever une couleur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l'immagine per prelevare un colore"
          }
        }
      }
    },
    "Tap to delete this one keyframe. Other properties are untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um genau diesen Keyframe zu löschen. Andere Eigenschaften bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para eliminar solo este fotograma clave. Las demás propiedades no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour supprimer cette seule image clé. Les autres propriétés ne sont pas touchées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per eliminare solo questo fotogramma chiave. Le altre proprietà non vengono toccate."
          }
        }
      }
    },
    "Tapping a preset replaces the current grade. You can keep editing afterwards, and the preset stays as it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen auf ein Preset ersetzt das aktuelle Grading. Du kannst danach weiter bearbeiten, und das Preset bleibt so, wie es gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar un preajuste sustituye el etalonaje actual. Puedes seguir editando después, y el preajuste se queda tal y como se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher un préréglage remplace l'étalonnage actuel. Vous pouvez continuer à modifier ensuite, et le préréglage reste tel qu'il a été enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccare un preset sostituisce il grading attuale. Puoi continuare a modificare dopo, e il preset resta come è stato salvato."
          }
        }
      }
    },
    "Temperature" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Température"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        }
      }
    },
    "Temperature balances warm and cool. Tint balances green and magenta. Vibrance gently boosts quieter colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Temperatur gleicht warm und kühl aus. Die Tönung gleicht Grün und Magenta aus. Die Dynamik hebt zurückhaltende Farben sanft an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura equilibra el cálido y el frío. El matiz equilibra el verde y el magenta. Vibrance realza suavemente los colores más apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La température équilibre le chaud et le froid. La nuance équilibre le vert et le magenta. La vibrance renforce doucement les couleurs les plus discrètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura bilancia caldo e freddo. La tinta bilancia verde e magenta. La vividezza esalta delicatamente i colori più spenti."
          }
        }
      }
    },
    "Temporary tracking frames could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporäre Tracking-Frames konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer los fotogramas temporales de rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images temporaires de suivi n’ont pas pu être lues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere i fotogrammi temporanei di tracciamento."
          }
        }
      }
    },
    "Terms of Use" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
