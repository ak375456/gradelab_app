    "Lifts the blacks toward a matte, washed-print look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebt die Schwarztöne an — matt, wie ein ausgewaschener Abzug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanta los negros hacia un acabado mate, de copia desgastada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nostaa mustat kohti mattapintaista, pestyä kuviota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remonte les noirs vers un rendu mat, façon tirage délavé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza i neri verso una resa opaca, da copia slavata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黒を持ち上げ、色あせたマットプリントのような質感にします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyfter svärtan mot en matt, urtvättad kopiekänsla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抬高黑位，营造哑光、褪色印片质感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抬高黑位，營造霧面、褪色印片質感。"
          }
        }
      }
    },
