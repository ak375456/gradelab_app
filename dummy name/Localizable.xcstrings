            "value" : "paiement unique"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pagamento unico"
          }
        }
      }
    },
    "Only a layer that draws a picture can use a track matte." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eine Ebene, die ein Bild zeichnet, kann eine Track Matte verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo una capa que dibuje una imagen puede usar una máscara de pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un calque qui dessine une image peut utiliser un cache de piste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un livello che disegna un’immagine può usare una maschera traccia."
          }
        }
      }
    },
    "Only the area marked on the picture receives your colour adjustments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der im Bild markierte Bereich erhält deine Farbanpassungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la zona marcada sobre la imagen recibe tus ajustes de color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la zone marquée sur l'image reçoit vos réglages de couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'area segnata sull'immagine riceve le tue regolazioni di colore."
          }
        }
      }
    },
    "Only this screen. Your footage, the editor and every export stay neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieser Bildschirm. Dein Material, der Editor und jeder Export bleiben neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo esta pantalla. Tu material, el editor y todas las exportaciones se mantienen neutros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran uniquement. Vos rushes, l'éditeur et tous les exports restent neutres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo questa schermata. Il tuo girato, l'editor e tutte le esportazioni restano neutri."
          }
        }
      }
    },
    "Only video and image clips can move between visual layers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Video- und Bildclips können zwischen visuellen Ebenen verschoben werden."
