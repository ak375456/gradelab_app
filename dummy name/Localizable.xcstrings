        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off on tavallinen valinta: lähde käytetään tämän kerroksen leikkaamiseen sen sijaan, että se vedettäisiin myös sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé est le choix habituel : la source est consommée pour découper ce calque au lieu d’être également dessinée par-dessus."
