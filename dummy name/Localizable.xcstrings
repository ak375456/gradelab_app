          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When on, export uses %1$lld × %2$lld and %3$@. Turn off to choose a different output size or frame rate in Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, la exportación usa %lld × %lld y %@. Desactívalo para elegir otro tamaño de salida o frecuencia de fotogramas en Exportar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun on kyse vientikäytöstä %lld × %lld sekä %@. Sammuta valitaksesi erilaisen tulostuskoon tai kuvanopeuden Exportissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, l'export utilise %lld × %lld et %@. Désactivez-la pour choisir une autre taille de sortie ou fréquence d'images dans Export."
