    "Eases into slow motion and back out." : {
      "comment" : "Description of a time remap preset called \"Smooth Slow\".",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleitet sanft in die Zeitlupe und wieder heraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra suavemente en cámara lenta y vuelve a salir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hidasta vauhtia ja peräänny."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse en douceur vers le ralenti et en ressort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scivola dolcemente nel rallentatore e ne esce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりスローモーションに入り、元の速度に戻ります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glider mjukt in i slow motion och ut igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻松进入慢动作，然后退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕鬆進入慢動作，然後退出。"
          }
        }
      }
    },
