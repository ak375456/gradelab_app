    "Near puts the light in front of everything; far puts it behind the subject, as a rim or background light." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nah setzt das Licht vor alles, fern setzt es hinter das Motiv – als Rim- oder Hintergrundlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca coloca la luz delante de todo; lejos la coloca detrás del sujeto, como contraluz o luz de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lähellä valo on kaiken edessä; kaukana se on kohteen takana, reuna- tai taustavalona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proche place la lumière devant tout ; lointaine la place derrière le sujet, comme un contre-jour ou une lumière d’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vicino mette la luce davanti a tutto; lontano la mette dietro il soggetto, come controluce o luce di sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くするとすべての手前に、遠くすると被写体の後ろにライトを置き、リムライトや背景ライトとして使えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nära placerar ljuset framför allt; långt bort placerar det bakom motivet, som kantljus eller bakgrundsljus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近将光线放在一切事物的前面；远将光线放在主体的后面，作为边框或背景光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近將光線放在一切事物的前面；遠將光線放在主體的後面，作為邊框或背景光。"
          }
        }
      }
    },
