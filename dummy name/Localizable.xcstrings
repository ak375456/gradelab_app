            "value" : "Decodifica Apple Log in luce di scena per il grading, e consegna in Rec.709."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Logをシーンの光へデコードして調整し、Rec.709で出力します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avkodar Apple Log till scenljus för grading, och levererar Rec.709."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解码 Apple Log 到场景光进行调色，并交付 Rec.709。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解碼 Apple Log 到場景光進行調色，並交付 Rec.709。"
          }
        }
      }
    },
    "Deep blacks, vivid blue skies and warm, punchy midtones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe Schwarztöne, leuchtend blauer Himmel und warme, kräftige Mitteltöne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep blacks, vivid blue skies and warm, punchy midtones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negros profundos, cielos azules vivos y medios tonos cálidos e intensos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvät mustat, eloisat siniset taivaat ja lämpimät, voimakkaat keskisävyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noirs profonds, ciels bleu vif et tons moyens chauds et intenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neri profondi, cieli blu vividi e mezzitoni caldi e incisivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い黒、鮮やかな青空、暖かく力強いミッドトーンを表現します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djupa svarta toner, livfull blå himmel och varma, kraftfulla mellantoner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深邃的黑色、鲜艳的蓝天和温暖、有力的中色调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深邃的黑色、鮮豔的藍天和溫暖、有力的中色調。"
          }
        }
      }
    },
    "Deep cyan greens, rich blues and warm film-like skin tones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe Cyangrüntöne, satte Blautöne und warme, filmische Hauttöne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep cyan greens, rich blues and warm film-like skin tones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdes cian profundos, azules intensos y tonos de piel cálidos de cine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syviä syaaninvihreitä, täyteläisiä sinisiä ja lämpimiä filmimäisiä ihonsävyjä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verts cyan profonds, bleus riches et teintes de peau chaudes au rendu argentique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdi ciano profondi, blu intensi e incarnati caldi dall’aspetto cinematografico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深いシアングリーン、豊かな青、フィルム調の暖かい肌色を表現します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djupa cyangröna toner, fylliga blå färger och varma filmlika hudtoner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深蓝绿色、浓郁的蓝色和温暖的薄膜般的肤色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深藍綠色、濃郁的藍色和溫暖的薄膜般的膚色。"
          }
        }
      }
    },
