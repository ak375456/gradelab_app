    "Only a layer that draws a picture can use a track matte." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eine Ebene, die ein Bild zeichnet, kann eine Track Matte verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo una capa que dibuje una imagen puede usar una máscara de pista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vain kuvan piirtävä kerros voi käyttää raitamattaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul un calque qui dessine une image peut utiliser un cache de piste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un livello che disegna un’immagine può usare una maschera traccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックマットは、画像を描画するレイヤーでのみ使用できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara ett lager som ritar en bild kan använda en track matte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有绘制图片的图层才能使用轨道遮罩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有繪製圖片的圖層才能使用軌道遮色片。"
          }
        }
      }
    },
    "Only the area marked on the picture receives your colour adjustments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der im Bild markierte Bereich erhält deine Farbanpassungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la zona marcada sobre la imagen recibe tus ajustes de color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vain kuvassa merkitty alue saa värisi muutettua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la zone marquée sur l'image reçoit vos réglages de couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'area segnata sull'immagine riceve le tue regolazioni di colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像に示された範囲にだけ、カラー調整が適用されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara det område som markerats på bilden får dina färgjusteringar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有图片上标记的区域才会收到您的颜色调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有圖片上標記的區域才會收到您的顏色調整。"
          }
        }
      }
    },
    "Only this screen. Your footage, the editor and every export stay neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieser Bildschirm. Dein Material, der Editor und jeder Export bleiben neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo esta pantalla. Tu material, el editor y todas las exportaciones se mantienen neutros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vain tämä näyttö, kuvamateriaalisi, editori ja jokainen vienti on neutraalia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran uniquement. Vos rushes, l'éditeur et tous les exports restent neutres."
          }
        },
