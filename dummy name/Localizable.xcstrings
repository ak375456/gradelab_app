          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme dans l'aperçu. Pincez pour la redimensionner ; tournez à deux doigts pour la faire pivoter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma nell'anteprima. Pizzica per ridimensionarla; ruotala con due dita."
          }
        }
      }
    },
    "Drag the shape on the picture to position it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form im Bild, um sie zu positionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma sobre la imagen para colocarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme sur l'image pour la positionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma sull'immagine per posizionarla."
          }
        }
      }
    },
    "Drag the shape to move it, or its handles to resize, rotate and soften it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form, um sie zu bewegen, oder ihre Griffe, um sie zu skalieren, zu drehen und weichzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma para moverla, o sus tiradores para redimensionarla, girarla y suavizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme pour la déplacer, ou ses poignées pour la redimensionner, la faire pivoter et l'adoucir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma per spostarla, o le sue maniglie per ridimensionarla, ruotarla e ammorbidirla."
          }
        }
      }
    },
    "Drag to compare. Every look in GradeLab is this one gesture away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh zum Vergleichen. Jeder Look in GradeLab ist nur diese eine Geste entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para comparar. Todos los looks de GradeLab están a un solo gesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour comparer. Chaque look de GradeLab est à un seul geste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per confrontare. Ogni look di GradeLab è a un solo gesto di distanza."
          }
