    "Drop video, photos and audio here, or use Import Media. Then drag one onto the canvas or the timeline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Videos, Fotos und Audio hier ab oder nutze „Medien importieren“. Zieh dann eines auf die Arbeitsfläche oder die Timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta aquí vídeos, fotos y audio, o usa Importar material. Después arrastra uno al lienzo o a la línea de tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pudota video, kuvat ja ääni tähän tai käytä Import Mediaa. Vedä toinen kankaalle tai aikajanalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
