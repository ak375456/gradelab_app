          }
        }
      }
    },
    "Tip: on a layered timeline, select the top visible clip. A clip above the selected one can hide its colour change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Wähle in einer mehrschichtigen Timeline den obersten sichtbaren Clip. Ein Clip über dem ausgewählten kann dessen Farbänderung verdecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: en una línea de tiempo con varias capas, selecciona el clip visible más alto. Un clip por encima del seleccionado puede ocultar su cambio de color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : sur une timeline multicalque, sélectionnez le clip visible le plus haut. Un clip situé au-dessus de celui sélectionné peut masquer son changement de couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerimento: su una timeline a più livelli, seleziona la clip visibile più in alto. Una clip sopra quella selezionata può nascondere il suo cambio di colore."
          }
        }
      }
    },
