    "HLG video cannot be interpreted as Rec.709 in an Apple Log timeline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HLG-Video kann in einer Apple-Log-Timeline nicht als Rec.709 interpretiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vídeo HLG no se puede interpretar como Rec.709 en una línea de tiempo Apple Log."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HLG-videota ei voi tulkita Apple Login aikajanalla Rec.709:ksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vidéo HLG ne peut pas être interprétée comme du Rec.709 dans une timeline Apple Log."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
