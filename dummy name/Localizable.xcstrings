    },
    "This name appears in the timeline and in this list. Leaving it empty restores the default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Name erscheint in der Timeline und in dieser Liste. Bleibt er leer, wird der Standard wiederhergestellt."
