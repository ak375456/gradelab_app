    "Pause the preview before measuring. While it plays the picture is rendered smaller, and a smaller picture carries less noise than the real one." : {
      "comment" : "Warning text to be displayed when the user tries to measure noise while the preview is playing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere die Vorschau, bevor du messen lässt. Während der Wiedergabe wird das Bild kleiner gerendert, und ein kleineres Bild trägt weniger Rauschen als das echte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la previsualización antes de medir. Mientras se reproduce, la imagen se renderiza más pequeña, y una imagen más pequeña lleva menos ruido que la real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keskeytä esikatselu ennen mittaamista. Kuvaa näytettäessä se on pienempi, ja pienemmässä kuvassa on vähemmän melua kuin todellisessa kuvassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez l'aperçu en pause avant de mesurer. Pendant la lecture, l'image est rendue plus petite, et une image plus petite porte moins de bruit que la vraie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa l'anteprima prima di misurare. Durante la riproduzione l'immagine viene renderizzata più piccola, e un'immagine più piccola porta meno rumore di quella vera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa förhandsvisningen innan du mäter. Under uppspelning renderas bilden mindre, och en mindre bild bär mindre brus än den verkliga."
          }
        }
      }
    },
    "Payment is charged to your Apple Account. Renews automatically until cancelled in account settings at least 24 hours before renewal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung wird über deinen Apple-Account abgerechnet. Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor der Verlängerung in den Account-Einstellungen gekündigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se carga a tu cuenta de Apple. Se renueva automáticamente hasta que la canceles en los ajustes de la cuenta, al menos 24 horas antes de la renovación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maksu veloitetaan Apple-tililtäsi. Uudistaa automaattisesti, kunnes tiliasetus perutaan vähintään 24 tuntia ennen uusimista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement est débité de votre compte Apple. L'abonnement se renouvelle automatiquement jusqu'à sa résiliation dans les réglages du compte, au moins 24 heures avant le renouvellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento viene addebitato sul tuo account Apple. Si rinnova automaticamente finché non lo annulli nelle impostazioni dell'account, almeno 24 ore prima del rinnovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalningen debiteras ditt Apple-konto. Förnyas automatiskt till dess att den avbryts i kontoinställningarna minst 24 timmar före förnyelsen."
          }
        }
      }
    },
