    "Highlights fine edges to help judge focus. Higher sensitivity can also highlight noise. Preview only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert feine Kanten zur Fokusbeurteilung. Höhere Empfindlichkeit kann auch Rauschen markieren. Nur Vorschau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highlights fine edges to help judge focus. Higher sensitivity can also highlight noise. Preview only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resalta bordes finos para evaluar el enfoque. Una sensibilidad mayor también puede resaltar ruido. Solo en la vista previa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korostaa hienoja reunoja tarkennuksen arviointiin. Suurempi herkkyys voi korostaa myös kohinaa. Vain esikatselussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souligne les détails fins pour évaluer la mise au point. Une sensibilité élevée peut aussi souligner le bruit. Aperçu uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evidenzia i bordi fini per valutare la messa a fuoco. Una maggiore sensibilità può evidenziare anche il rumore. Solo anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細かい輪郭を強調し、ピントの確認を助けます。感度を上げるとノイズも強調される場合があります。プレビュー専用です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerar fina kanter för att bedöma fokus. Högre känslighet kan även markera brus. Endast förhandsvisning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "突出显示细小边缘，帮助判断对焦。较高灵敏度也可能突出噪点。仅影响预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "突出顯示細小邊緣，幫助判斷對焦。較高靈敏度也可能突出雜訊。僅影響預覽。"
          }
        }
      }
    },
