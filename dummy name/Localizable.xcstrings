        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attivo, l'esportazione usa %lld × %lld e %@. Disattivalo per scegliere un'altra dimensione di uscita o frequenza fotogrammi in Esporta."
