    "Only the area marked on the picture receives your colour adjustments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der im Bild markierte Bereich erhält deine Farbanpassungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la zona marcada sobre la imagen recibe tus ajustes de color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la zone marquée sur l'image reçoit vos réglages de couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'area segnata sull'immagine riceve le tue regolazioni di colore."
          }
        }
      }
    },
    "Only this screen. Your footage, the editor and every export stay neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieser Bildschirm. Dein Material, der Editor und jeder Export bleiben neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo esta pantalla. Tu material, el editor y todas las exportaciones se mantienen neutros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran uniquement. Vos rushes, l'éditeur et tous les exports restent neutres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo questa schermata. Il tuo girato, l'editor e tutte le esportazioni restano neutri."
