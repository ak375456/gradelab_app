    "Support & contact" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support & Kontakt"
          }
        }
      }
    },
    "Swipe animation: keyframe Position X, move the playhead, then drag the line across the picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe-Animation: Setze einen Keyframe auf Position X, bewege den Abspielkopf und zieh dann die Linie über das Bild."
          }
        }
      }
    },
    "Swipe up or down to adjust. Use the Reset action to return to neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streich nach oben oder unten, um anzupassen. Mit „Zurücksetzen“ geht es zurück auf neutral."
          }
        }
      }
    },
    "Take the encoder's controls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimm die Kontrolle über den Encoder."
          }
        }
      }
    },
    "Tap a colour in the picture" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Farbe im Bild"
          }
        }
      }
    },
    "Tap a point to select it — the numbers above the graph are its exact values. Tap it again to remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Punkt, um ihn auszuwählen — die Zahlen über dem Graphen sind seine genauen Werte. Tippe erneut, um ihn zu entfernen."
          }
        }
      }
    },
    "Tap a property's name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Namen einer Eigenschaft tippen"
          }
        }
      }
    },
    "Tap any slider's value to enter an exact number instead of dragging for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Wert eines Reglers, um eine genaue Zahl einzugeben, statt sie durch Ziehen einzustellen."
          }
        }
      }
    },
    "Tap around the subject on the picture. Three points or more make a shape; tap a point to remove it once you are done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe rund um das Motiv im Bild. Drei Punkte oder mehr ergeben eine Form; tippe auf einen Punkt, um ihn zu entfernen, sobald du fertig bist."
          }
        }
      }
    },
    "Tap the diamond" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf die Raute tippen"
          }
        }
      }
    },
    "Tap the diamond to start animating %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Raute, um %@ zu animieren."
          }
        }
      }
    },
    "Tap the graph to add a point, drag a point to shape the curve, tap a selected point to remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Graphen, um einen Punkt hinzuzufügen, zieh einen Punkt, um die Kurve zu formen, und tippe auf einen ausgewählten Punkt, um ihn zu entfernen."
          }
        }
      }
    },
    "Tap the graph to drop a point, then drag that point to shape the curve." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Graphen, um einen Punkt zu setzen, und zieh ihn dann, um die Kurve zu formen."
          }
        }
      }
    },
    "Tap the number to type it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Zahl, um sie einzugeben"
          }
        }
      }
    },
    "Tap the picture to pick a colour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Bild, um eine Farbe auszuwählen"
          }
        }
      }
    },
    "Tap to delete this one keyframe. Other properties are untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um genau diesen Keyframe zu löschen. Andere Eigenschaften bleiben unberührt."
          }
        }
      }
    },
    "Tapping a preset replaces the current grade. You can keep editing afterwards, and the preset stays as it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen auf ein Preset ersetzt das aktuelle Grading. Du kannst danach weiter bearbeiten, und das Preset bleibt so, wie es gesichert wurde."
          }
        }
      }
    },
    "Temperature" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur"
          }
        }
      }
    },
    "Terms of Use" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsbedingungen"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text"
          }
        }
      }
    },
    "Text content" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textinhalt"
          }
        }
      }
    },
    "Text layers use their on-screen text as the name until you rename them. Top layers appear above lower layers. Hiding a layer also silences its linked audio. Locked layers still play and export, and can still be renamed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textebenen verwenden ihren angezeigten Text als Namen, bis du sie umbenennst. Obere Ebenen erscheinen über unteren. Wird eine Ebene ausgeblendet, verstummt auch ihr verknüpftes Audio. Gesperrte Ebenen werden weiterhin wiedergegeben und exportiert und können weiterhin umbenannt werden."
          }
        }
      }
    },
    "That saves the value you can see right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sichert den Wert, den du gerade siehst."
          }
        }
      }
    },
    "The .cube file is deleted from the app. Any clip using it goes back to no look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die .cube-Datei wird aus der App gelöscht. Jeder Clip, der sie verwendet, hat danach keinen Look mehr."
          }
        }
      }
    },
    "The %@ source bit depth could not be verified as 8-bit. Export is blocked to avoid flattening higher-bit-depth video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bittiefe der %@-Quelle konnte nicht als 8 Bit bestätigt werden. Der Export wird blockiert, um Video mit höherer Bittiefe nicht abzuflachen."
          }
        }
      }
    },
    "The AAC encoder rejected audio from track %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der AAC-Encoder hat Audio aus Spur %lld abgelehnt."
          }
        }
      }
    },
    "The agreement covering the app and purchases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vereinbarung für die App und für Käufe."
          }
        }
      }
    },
    "The decoder changed the source dimensions; export stopped instead of resizing silently." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Decoder hat die Quellabmessungen geändert; der Export wurde gestoppt, statt still zu skalieren."
          }
        }
      }
    },
    "The decoder did not provide the required %@ video frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Decoder lieferte nicht die erforderlichen %@-Videoframes."
          }
        }
      }
    },
    "The destination extension must match the selected container." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateiendung des Ziels muss zum gewählten Container passen."
          }
        }
      }
    },
    "The encoder frame pool did not provide 10-bit 4:2:0 surfaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Frame-Pool des Encoders lieferte keine 10-Bit-4:2:0-Surfaces."
          }
        }
      }
    },
    "The encoder frame pool did not provide BGRA surfaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Frame-Pool des Encoders lieferte keine BGRA-Surfaces."
          }
        }
      }
    },
    "The export destination must be a local file URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Exportziel muss eine lokale Datei-URL sein."
          }
        }
      }
    },
    "The export session could not be prepared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Export-Sitzung konnte nicht vorbereitet werden."
          }
        }
      }
    },
    "The exported file has no readable video track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die exportierte Datei hat keine lesbare Videospur."
          }
        }
      }
    },
    "The exported file is not tagged as HLG BT.2020 — it reports %@. The file was written but its colour would be misread, so it is being reported as a failure rather than a success." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die exportierte Datei ist nicht als HLG BT.2020 gekennzeichnet — sie meldet %@. Die Datei wurde geschrieben, ihre Farbe würde aber falsch gelesen. Deshalb wird dies als Fehler und nicht als Erfolg gemeldet."
          }
        }
      }
    },
    "The exported file reports %lld-bit precision, not 10-bit. Reported as a failure rather than a silent quality reduction." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die exportierte Datei meldet %lld Bit Präzision statt 10 Bit. Dies wird als Fehler gemeldet statt als stille Qualitätsminderung."
          }
        }
      }
    },
    "The finishing effects could not be prepared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die abschließenden Effekte konnten nicht vorbereitet werden."
          }
        }
      }
    },
    "The finishing-effects pass could not be encoded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Durchgang für die abschließenden Effekte konnte nicht kodiert werden."
          }
        }
      }
    },
    "The GPU could not accept the export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GPU konnte den Export nicht annehmen."
          }
        }
      }
    },
    "The graded pixels could not be assembled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gegradeten Pixel konnten nicht zusammengesetzt werden."
          }
        }
      }
    },
    "The HDR compositor needs half-float render surfaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der HDR-Compositor benötigt Half-Float-Render-Surfaces."
          }
        }
      }
    },
    "The image could not be written." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild konnte nicht geschrieben werden."
          }
        }
      }
    },
    "The look or curve tables could not be prepared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Look- oder Kurventabellen konnten nicht vorbereitet werden."
          }
        }
      }
    },
    "The mask is ready, but the grade is neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Maske ist bereit, aber das Grading ist neutral."
