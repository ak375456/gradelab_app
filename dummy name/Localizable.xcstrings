          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un léger reflet sur les surfaces tournées à la fois vers la lumière et vers la caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lucentezza discreta sulle superfici rivolte sia verso la luce sia verso la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトとカメラの両方を向く面に、控えめな光沢を加えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En diskret glans på ytor som vetter mot både ljuset och kameran."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面对光线和相机的表面上有抑制的光亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面對光線和相機的表面上有抑制的光亮。"
          }
        }
      }
    },
    "A short burst of speed that skips the dull part without a cut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Temposchub, der die langweilige Stelle ohne Schnitt überspringt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un breve acelerón que se salta la parte aburrida sin necesidad de un corte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lyhyt vauhdinpuuska, joka ohittaa tylsän osan ilman leikkausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une brève accélération qui saute le passage sans intérêt, sans couper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un breve scatto di velocità che salta la parte noiosa senza uno stacco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットせずに単調な部分を飛ばす、短いスピードアップ。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kort fartökning som hoppar över den tråkiga biten utan en klippning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暂的爆发速度，跳过沉闷的部分，没有切割。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暫的爆發速度，跳過沉悶的部分，沒有切割。"
          }
        }
      }
    },
    "A soft diffusion across the whole frame, not only the highlights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine weiche Diffusion über das ganze Bild, nicht nur über die Lichter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una difusión suave por todo el fotograma, no solo en las altas luces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pehmeä diffuusio koko runkoon, ei vain kohokohtiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une diffusion douce sur toute l'image, pas seulement sur les hautes lumières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una diffusione morbida su tutto il fotogramma, non solo sulle alte luci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイライトだけでなく、画面全体に柔らかな拡散効果を加えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mjuk diffusion över hela bilden, inte bara högdagrarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为整个画面添加柔和的扩散效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為整個畫面新增柔和的擴散效果。"
          }
        }
      }
    },
    "A source audio track has an unreadable format and cannot be preserved." : {
      "localizations" : {
        "de" : {
