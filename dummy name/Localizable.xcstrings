            "state" : "translated",
            "value" : "Zieh den Text in der Vorschau. Zusammenziehen ändert die Größe; mit zwei Fingern drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el texto en la previsualización. Pellizca para redimensionarlo; gíralo con dos dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le texte dans l'aperçu. Pincez pour le redimensionner ; tournez à deux doigts pour le faire pivoter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il testo nell'anteprima. Pizzica per ridimensionarlo; ruotalo con due dita."
          }
        }
      }
    },
    "Drag the line on the picture to place it; rotate to change its direction." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Linie im Bild, um sie zu platzieren; drehe sie, um ihre Richtung zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la línea sobre la imagen para colocarla; gírala para cambiar su dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la ligne sur l'image pour la placer ; faites-la pivoter pour changer sa direction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la linea sull'immagine per posizionarla; ruotala per cambiarne la direzione."
          }
