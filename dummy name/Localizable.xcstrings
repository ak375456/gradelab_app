        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写意蒙版至少需要三个点。轻点主题周围以绘制一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
