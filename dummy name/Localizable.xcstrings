    "Add a second layer — a title, a shape, a logo or another clip — to use as the matte." : {
      "comment" : "A hint explaining that a second layer is needed to use as a track matte.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine zweite Ebene hinzu – einen Titel, eine Form, ein Logo oder einen weiteren Clip – und nutze sie als Matte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una segunda capa —un título, una forma, un logotipo u otro clip— para usarla como máscara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un deuxième calque — un titre, une forme, un logo ou un autre clip — à utiliser comme cache."
          }
        },
