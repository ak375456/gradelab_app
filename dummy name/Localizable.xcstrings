        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese contorno era demasiado pequeño. Dibuja todo el contorno alrededor del objeto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piirros oli liian pieni."
          }
