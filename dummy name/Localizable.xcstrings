    "Carries tone, palette and saturation across. Leaves exposure close to where you have it. For a film still or a photograph." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überträgt Ton, Palette und Sättigung. Lässt die Belichtung nahe an deiner. Für ein Filmstill oder ein Foto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada el tono, la paleta y la saturación. Deja la exposición cerca de como la tienes. Para un fotograma de película o una fotografía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kannetaan sävyä, palettia ja saturaatiota läpikotaisin ja jätetään valotus lähelle paikkaa, jossa se on. Elokuvaa tai valokuvaa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transporte la tonalité, la palette et la saturation. Laisse l'exposition proche de la vôtre. Pour un photogramme de film ou une photographie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta tono, palette e saturazione. Lascia l'esposizione vicina a dove l'hai messa. Per un fotogramma di film o una fotografia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色調、配色、彩度を取り入れ、露出は現在の状態に近く保ちます。映画のスチルや写真に適しています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar med ton, palett och mättnad. Lämnar exponeringen nära där du har den. För en filmstillbild eller ett fotografi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带有色调、调色板和饱和度。暴露在你拥有它的地方附近。对于电影剧照或照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帶有色調、調色盤和飽和度。暴露在你擁有它的地方附近。對於電影劇照或照片。"
          }
        }
      }
    },
