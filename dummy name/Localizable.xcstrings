    "Audio follows the clip and keeps its pitch. Later clips shift to stay in step." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio folgt dem Clip und behält seine Tonhöhe. Spätere Clips verschieben sich, um im Takt zu bleiben."
          }
        }
      }
    },
    "Audio track %lld cannot be added to the output movie." : {
      "localizations" : {
