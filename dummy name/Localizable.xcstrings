    "Higher bit rates preserve more detail and use more storage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Bitraten erhalten mehr Details und benötigen mehr Speicher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher bit rates preserve more detail and use more storage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tasas más altas conservan más detalle y usan más almacenamiento"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurempi bittinopeus säilyttää enemmän yksityiskohtia ja käyttää enemmän tilaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un débit plus élevé préserve plus de détails et utilise plus d’espace"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate più elevati preservano più dettagli e usano più spazio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いビットレートほど細部を保ち、保存容量を多く使用します"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre bithastigheter bevarar fler detaljer och använder mer lagring"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的码率保留更多的细节并使用更多的存储空间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的位元率保留更多的細節並使用更多的儲存空間"
          }
        }
      }
    },
    "Higher bitrate uses more storage. Quality presets choose an average target automatically; actual file size varies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine höhere Bitrate braucht mehr Speicher. Qualitäts-Presets wählen automatisch einen Durchschnittswert; die tatsächliche Dateigröße variiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tasa de bits más alta ocupa más almacenamiento. Los preajustes de calidad eligen un objetivo medio automáticamente; el tamaño real del archivo varía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Korkeampi bittinopeus käyttää enemmän tallennustilaa. Laadukkaat esiasetukset valitsevat kohteen automaattisesti, varsinainen tiedostokoko vaihtelee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un débit plus élevé occupe plus de stockage. Les préréglages de qualité choisissent une cible moyenne automatiquement ; la taille réelle du fichier varie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bitrate più alto occupa più spazio. I preset di qualità scelgono automaticamente un obiettivo medio; la dimensione reale del file varia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレートを上げると容量が増えます。画質プリセットは平均目標値を自動で設定します。実際のファイルサイズは変動します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre bithastighet tar mer lagringsutrymme. Kvalitetsförinställningar väljer ett genomsnittligt mål automatiskt; den faktiska filstorleken varierar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的码率占用更多的存储空间。质量预设自动选择平均目标；实际文件大小各不相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的位元率佔用更多的儲存空間。品質預設自動選擇平均目標；實際檔案大小各不相同。"
          }
        }
      }
    },
