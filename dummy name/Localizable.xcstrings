    "Waveform, RGB parade and vectorscope in the editor. Camera monitoring and the histogram stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellenform, RGB-Parade und Vektorskop im Editor. Kamerakontrolle und Histogramm bleiben kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waveform, RGB parade and vectorscope in the editor. Camera monitoring and the histogram stay free."
          }
