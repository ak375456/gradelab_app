    "Off is the usual choice: the source is used up cutting this layer instead of being drawn over it as well." : {
      "comment" : "A description of why the \"Also draw the matte source\" toggle should be set to \"Off\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aus“ ist die übliche Wahl: Die Quelle wird beim Ausschneiden dieser Ebene verbraucht, statt zusätzlich darüber gezeichnet zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado es la opción habitual: el origen se consume al recortar esta capa en lugar de dibujarse también encima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off on tavallinen valinta: lähde käytetään tämän kerroksen leikkaamiseen sen sijaan, että se vedettäisiin myös sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé est le choix habituel : la source est consommée pour découper ce calque au lieu d’être également dessinée par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off è la scelta abituale: la sorgente viene consumata per ritagliare questo livello invece di essere disegnata anche sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常はオフにします。ソースを重ねて描画せず、このレイヤーの切り抜きだけに使用します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av är det vanliga valet: källan går åt till att skära ut det här lagret i stället för att också ritas över det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭是通常的选择：源被用于切割此层，而不是在它上面绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉是通常的選擇：源被用於切割此層，而不是在它上面繪製。"
          }
        }
      }
    },
