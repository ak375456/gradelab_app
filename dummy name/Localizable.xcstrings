        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä LUT käyttää muuta verkkotunnusta kuin 0-1, mikä tarkoittaa yleensä sitä, että kyseessä on pikemminkin loki- tai kameramuunnos LUT kuin katse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette LUT utilise un domaine autre que 0 à 1, ce qui indique généralement une LUT de conversion log ou caméra plutôt qu'un look."
