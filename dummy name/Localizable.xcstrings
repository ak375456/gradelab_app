    "Off is the usual choice: the source is used up cutting this layer instead of being drawn over it as well." : {
      "comment" : "A description of why the \"Also draw the matte source\" toggle should be set to \"Off\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aus“ ist die übliche Wahl: Die Quelle wird beim Ausschneiden dieser Ebene verbraucht, statt zusätzlich darüber gezeichnet zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado es la opción habitual: el origen se consume al recortar esta capa en lugar de dibujarse también encima."
          }
