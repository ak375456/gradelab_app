        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3-alkuperäinen säilytetään. GradeLab muuntaa sen värit Rec.709-muotoon 10-bittisellä tarkkuudella yhtenäistä muokkausta ja vientiä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
