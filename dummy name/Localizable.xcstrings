    "Audio clips on this track cannot overlap. Paste onto a new audio track to mix them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audioclips auf dieser Spur dürfen sich nicht überlappen. Setze sie auf eine neue Audiospur ein, um sie zu mischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips de audio de esta pista no pueden solaparse. Pégalos en una pista de audio nueva para mezclarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
