    "Drag to the end for fully rounded. A square shape becomes a circle; a wider one becomes a capsule." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh bis ans Ende für vollständig abgerundet. Eine quadratische Form wird zum Kreis, eine breitere zur Kapsel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra hasta el final para redondearla del todo. Una forma cuadrada se convierte en un círculo; una más ancha, en una cápsula."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vedä loppuun pyöristettynä. Neliöstä tulee ympyrä, laajemmasta tulee kapseli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser jusqu'au bout pour un arrondi complet. Une forme carrée devient un cercle ; une forme plus large devient une capsule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina fino in fondo per arrotondarla del tutto. Una forma quadrata diventa un cerchio; una più larga diventa una capsula."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra hela vägen för helt rundade hörn. En kvadratisk form blir en cirkel; en bredare blir en kapsel."
          }
        }
      }
    },
    "Draw a closed outline around the object you want to keep." : {
