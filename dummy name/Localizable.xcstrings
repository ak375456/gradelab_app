          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma nell'anteprima. Pizzica per ridimensionarla; ruotala con due dita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra formen i förhandsvisningen. Knip för att ändra storlek; vrid med två fingrar för att rotera."
          }
        }
      }
    },
    "Drag the shape on the picture to position it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
