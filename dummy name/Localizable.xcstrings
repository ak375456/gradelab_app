    "Position and size animation will be replaced only over successfully tracked frames. Rotation, feather, strength and local grading are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positions- und Größenanimation werden nur über erfolgreich getrackte Frames ersetzt. Drehung, weiche Kante, Stärke und lokales Grading bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La animación de posición y tamaño se sustituirá solo en los fotogramas seguidos con éxito. La rotación, el suavizado, la intensidad y el etalonaje local se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'animation de position et de taille ne sera remplacée que sur les images suivies avec succès. La rotation, l'adoucissement, l'intensité et l'étalonnage local sont préservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'animazione di posizione e dimensione verrà sostituita solo sui fotogrammi tracciati con successo. Rotazione, sfumatura, intensità e grading locale vengono conservati."
          }
        }
      }
    },
