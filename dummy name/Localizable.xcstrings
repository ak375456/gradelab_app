    "Apply updates the video layer in both preview and export. X/Y 0.5 centers the video. The canvas pinch zoom is separate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Anwenden“ aktualisiert die Videoebene in Vorschau und Export. X/Y 0,5 zentriert das Video. Der Zoom der Arbeitsfläche ist davon getrennt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar actualiza la capa de vídeo tanto en la previsualización como en la exportación. X/Y 0,5 centra el vídeo. El zoom con dos dedos sobre el lienzo es independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer met à jour le calque vidéo dans l'aperçu comme à l'export. X/Y 0,5 centre la vidéo. Le zoom par pincement sur le canevas est indépendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica aggiorna il livello video sia nell'anteprima sia nell'esportazione. X/Y 0,5 centra il video. Lo zoom con le dita sul canvas è indipendente."
          }
        }
      }
    },
