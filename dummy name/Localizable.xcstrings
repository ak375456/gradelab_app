    "Add one, drag it over the part of the picture you want to change, then use Light and Color as usual — only that area moves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine hinzu, zieh sie über den Bildbereich, den du ändern willst, und nutze Licht und Farbe wie gewohnt — nur dieser Bereich verändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una, arrástrala sobre la parte de la imagen que quieras cambiar y usa Luz y Color como siempre: solo se moverá esa zona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisää yksi, vedä se sen kuvan osan päälle, jonka haluat muuttaa, ja käytä Valoa ja Väriä tavalliseen tapaan – vain tuo alue liikkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en un, faites-le glisser sur la partie de l'image à modifier, puis utilisez Lumière et Couleur comme d'habitude — seule cette zone bouge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungine una, trascinala sulla parte dell'immagine che vuoi modificare, poi usa Luce e Colore come sempre: si muoverà solo quell'area."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en, dra den över den del av bilden du vill ändra och använd sedan Ljus och Färg som vanligt — bara det området påverkas."
          }
        }
      }
    },
