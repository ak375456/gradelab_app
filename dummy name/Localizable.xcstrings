    "Import a clip or a photograph, inspect its real format, grade on the GPU, and export at its original dimensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere einen Clip oder ein Foto, sieh dir sein echtes Format an, grade auf der GPU und exportiere in den Originalabmessungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un clip o una fotografía, inspecciona su formato real, etalona en la GPU y exporta a sus dimensiones originales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tuo klippi tai valokuva, tarkasta sen todellinen muoto, arvosana GPU:ssa ja vie alkuperäiset mitat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un clip ou une photographie, inspectez son format réel, étalonnez sur le GPU et exportez à ses dimensions d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una clip o una fotografia, ispeziona il suo formato reale, fai il grading sulla GPU ed esporta alle dimensioni originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画や写真を読み込み、実際の形式を確認し、GPUでカラーグレーディングして元のサイズで書き出せます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera ett klipp eller ett fotografi, granska dess verkliga format, grada på GPU:n och exportera i originalmåtten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入片段或照片，检查其真实格式，在GPU上进行调色，并以原始尺寸导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入片段或照片，檢查其真實格式，在GPU上進行調色，並以原始尺寸匯出。"
          }
        }
      }
    },
