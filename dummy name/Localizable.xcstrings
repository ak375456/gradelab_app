            "value" : "呼吸"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸"
          }
        }
      }
    },
    "Bright areas bleed into what surrounds them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle Bereiche laufen in ihre Umgebung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las zonas luminosas se derraman sobre lo que las rodea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirkkaat alueet vuotavat niiden ympärille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones lumineuses débordent sur ce qui les entoure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le zone luminose sbordano su ciò che le circonda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい部分が周囲ににじみます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljusa partier blöder ut i det som omger dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让高光向周围柔和扩散。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓亮部向周圍柔和擴散。"
          }
        }
      }
    },
    "Bright Voice" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明瞭な声"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清亮人声"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清亮人聲"
          }
        }
      }
    },
    "Bright, warm color for a sunlit feel. Lower the strength for a softer finish." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日差しを感じさせる明るく温かい色。強さを下げると柔らかな仕上がりになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明亮、温暖的颜色，营造出阳光普照的感觉。降低强度以获得更柔软的表面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明亮、溫暖的顏色，營造出陽光普照的感覺。降低強度以獲得更柔軟的表面。"
          }
        }
      }
    },
    "Brightness by saturation. Lowering the right darkens the most colorful areas and leaves neutrals alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit nach Sättigung. Die rechte Seite abzusenken dunkelt die farbigsten Bereiche ab und lässt Neutraltöne unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillo según la saturación. Bajar la derecha oscurece las zonas más coloridas y deja intactos los neutros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirkkaus kylläisyyden kautta. Oikean korkeuden alentaminen pimentää värikkäimmät alueet ja jättää neutraalit yksin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité en fonction de la saturation. Baisser la droite assombrit les zones les plus colorées et laisse les neutres intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità in base alla saturazione. Abbassare la destra scurisce le aree più colorate e lascia intatti i neutri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩度に応じた明るさ。右側を下げると、無彩色を保ちながら鮮やかな部分を暗くします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljusstyrka efter mättnad. Att sänka höger sida gör de mest färgstarka partierna mörkare och lämnar neutrala toner i fred."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "饱和度的亮度。降低右侧会使色彩最丰富的区域变暗，留下中性色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飽和度的亮度。降低右側會使色彩最豐富的區域變暗，留下中性色。"
          }
        }
      }
    },
    "Brightness of one color. Pick a hue, then drag down to darken it — a deeper sky, for instance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit einer einzelnen Farbe. Wähle einen Farbton und zieh nach unten, um ihn abzudunkeln — für einen tieferen Himmel zum Beispiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillo de un solo color. Elige un tono y arrastra hacia abajo para oscurecerlo: un cielo más profundo, por ejemplo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse värin kirkkaus, valitse väri ja raahaudu sen jälkeen tummaksi – esimerkiksi syvemmäksi taivaaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité d'une seule couleur. Choisissez une teinte, puis faites glisser vers le bas pour l'assombrir — un ciel plus profond, par exemple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità di un singolo colore. Scegli una tonalità, poi trascina verso il basso per scurirla: un cielo più profondo, per esempio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特定の色の明るさ。色相を選んで下にドラッグすると、その色が暗くなります。空の青を深くする場合などに使えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljusstyrkan i en enda färg. Välj en nyans och dra nedåt för att göra den mörkare — till exempel en djupare himmel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一种颜色的亮度。选择一个色调，然后向下拖动以使其变暗——例如，更深的天空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一種顏色的亮度。選擇一個色調，然後向下拖動以使其變暗——例如，更深的天空。"
          }
        }
      }
    },
    "Bring this shot closer to another one.\n\nPick a reference — another clip on the timeline, or an image you import — and GradeLab measures both pictures and works out the grade that moves this one toward it. Exposure, white balance, contrast, saturation and the tint of the shadows, midtones and highlights.\n\nWhat it writes are ordinary values in the tools beside this one. Open Light after a match and Exposure will have moved; open Wheels and the shadows will have a tint. Every one of them is still yours to drag, and Reset puts back exactly the grade you had before.\n\nShot matches two shots meant to cut together. Look carries the style of a film still across without relighting your scene. Strength moves the whole result between nothing and everything, and the component switches decide what it is allowed to touch at all.\n\nIt is a starting point, not an answer. A reference from a different world will say so." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring diese Einstellung näher an eine andere.\n\nWähle eine Referenz – einen anderen Clip auf der Timeline oder ein importiertes Bild – und GradeLab misst beide Bilder und errechnet das Grading, das dieses in Richtung des anderen bewegt. Belichtung, Weißabgleich, Kontrast, Sättigung und die Tönung von Schatten, Mitteltönen und Lichtern.\n\nWas es schreibt, sind gewöhnliche Werte in den Werkzeugen daneben. Öffne nach einem Abgleich Licht, und die Belichtung hat sich bewegt; öffne Wheels, und die Schatten haben eine Tönung. Jeder davon gehört weiterhin dir, und Zurücksetzen stellt genau das Grading wieder her, das du vorher hattest.\n\nShot gleicht zwei Einstellungen ab, die zusammengeschnitten werden sollen. Look überträgt den Stil eines Filmstills, ohne deine Szene neu auszuleuchten. Stärke bewegt das gesamte Ergebnis zwischen nichts und allem, und die Komponentenschalter entscheiden, was es überhaupt anfassen darf.\n\nEs ist ein Ausgangspunkt, keine Antwort. Eine Referenz aus einer anderen Welt wird das auch sagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca esta toma a otra.\n\nElige una referencia — otro clip de la línea de tiempo, o una imagen que importes — y GradeLab mide las dos imágenes y calcula el etalonaje que acerca esta a la otra. Exposición, balance de blancos, contraste, saturación y el matiz de las sombras, los tonos medios y las altas luces.\n\nLo que escribe son valores normales en las herramientas de al lado. Abre Luz después de un ajuste y la Exposición se habrá movido; abre Ruedas y las sombras tendrán un matiz. Cada uno sigue siendo tuyo para arrastrarlo, y Restablecer devuelve exactamente el etalonaje que tenías antes.\n\nToma ajusta dos tomas pensadas para ir seguidas. Look traslada el estilo de un fotograma de película sin volver a iluminar tu escena. Intensidad mueve todo el resultado entre nada y todo, y los interruptores de componentes deciden qué puede tocar siquiera.\n\nEs un punto de partida, no una respuesta. Una referencia de otro mundo te lo dirá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tuo tämä kuva lähemmäs toista. Valitse viittaus – toinen aikajanan klikkaus tai tuomasi kuva – ja GradeLab mittaa sekä kuvia että määrittää arvosanan, joka liikuttaa tätä kohti. Altistuminen, valkoinen tasapaino, kontrasti, kylläisyys ja varjojen sävyt, keskisävyt ja kohokohdat. Se, mitä se kirjoittaa, on tavallisia arvoja työkaluissa tämän kanssa. Avataan Valo ottelun jälkeen ja Altistuminen on siirtynyt; avaa Wheels ja varjot ovat sävyjä. Jokainen niistä on yhä sinun vetämässä, ja Reset palauttaa täsmälleen aiemman arvosanan. Laukaus vastaa kahta laukausta, jotka on tarkoitettu leikkaamaan yhteen. Katso kantaa tyyliä, joka on yhä läpi kuvaamatta kohtaustasi. Vahvuus siirtää koko tuloksen tyhjän"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapprochez ce plan d'un autre.\n\nChoisissez une référence — un autre plan de la timeline, ou une image que vous importez — et GradeLab mesure les deux images et calcule l'étalonnage qui rapproche celle-ci de l'autre. Exposition, balance des blancs, contraste, saturation et nuance des ombres, des tons moyens et des hautes lumières.\n\nCe qu'il écrit, ce sont des valeurs ordinaires dans les outils voisins. Ouvrez Lumière après une correspondance et l'Exposition aura bougé ; ouvrez Roues et les ombres auront une nuance. Chacune reste la vôtre à faire glisser, et Réinitialiser remet exactement l'étalonnage que vous aviez avant.\n\nPlan fait correspondre deux plans destinés à se suivre au montage. Look transporte le style d'une photogramme de film sans réeclairer votre scène. Intensité déplace tout le résultat entre rien et tout, et les interrupteurs de composantes décident de ce qu'il a le droit de toucher.\n\nC'est un point de départ, pas une réponse. Une référence venue d'un autre monde vous le dira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvicina questa inquadratura a un'altra.\n\nScegli un riferimento — un altro clip sulla timeline, o un'immagine che importi — e GradeLab misura entrambe le immagini e calcola il grading che sposta questa verso quella. Esposizione, bilanciamento del bianco, contrasto, saturazione e la tinta di ombre, mezzitoni e alte luci.\n\nQuello che scrive sono valori ordinari negli strumenti accanto a questo. Apri Luce dopo un abbinamento e l'Esposizione si sarà spostata; apri Ruote e le ombre avranno una tinta. Ognuno di essi resta tuo da trascinare, e Reimposta rimette esattamente il grading che avevi prima.\n\nInquadratura abbina due inquadrature destinate a stare una dopo l'altra. Look porta lo stile di un fotogramma di film senza rilluminare la tua scena. Intensità muove tutto il risultato tra niente e tutto, e gli interruttori dei componenti decidono cosa può toccare.\n\nÈ un punto di partenza, non una risposta. Un riferimento venuto da un altro mondo te lo dirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このショットの色を別の画像に近づけます。\n\nタイムラインの別のクリップや読み込んだ画像を参照に選ぶと、GradeLabが両方を測定し、露出、ホワイトバランス、コントラスト、彩度、シャドウ・中間調・ハイライトの色味を調整します。\n\n設定されるのは、他のツールにある通常の値です。マッチ後に「ライト」を開くと露出が変わり、「ホイール」を開くとシャドウに色味が加わっています。どの値も自由に調整でき、「リセット」でマッチ前のグレードに戻せます。\n\n「ショット」は続けてつなぐ映像同士の色を合わせます。「ルック」はシーンの照明を大きく変えずに、映画のスチルなどのスタイルを取り入れます。「強さ」で全体の適用量を調整し、各項目のスイッチで変更を許可する範囲を選びます。\n\nこれは仕上がりではなく、調整の出発点です。参照画像の条件が大きく異なる場合は、そのことをお知らせします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta den här tagningen närmare en annan.\n\nVälj en referens — ett annat klipp på tidslinjen, eller en bild du importerar — och GradeLab mäter båda bilderna och räknar ut den grading som flyttar den här mot den. Exponering, vitbalans, kontrast, mättnad och färgtonen i skuggor, mellantoner och högdagrar.\n\nVad den skriver är vanliga värden i verktygen intill det här. Öppna Ljus efter en matchning och Exponering har flyttat sig; öppna Hjul och skuggorna har en färgton. Varje enskilt värde är fortfarande ditt att dra i, och Återställ lägger tillbaka exakt den grading du hade förut.\n\nTagning matchar två tagningar som är tänkta att klippas ihop. Look tar med stilen från en filmstillbild utan att ljussätta om din scen. Styrka flyttar hela resultatet mellan ingenting och allt, och komponentbrytarna avgör vad den alls får röra.\n\nDet är en utgångspunkt, inte ett svar. En referens från en annan värld kommer att säga det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让当前镜头接近另一张参考画面。\n\n选择时间线上的其他片段或导入图像作为参考，GradeLab 会测量两张画面，并计算让当前镜头接近参考所需的调色，包括曝光、白平衡、对比度、饱和度，以及阴影、中间调和高光的色调。\n\n匹配结果会写入旁边工具中的常规参数。匹配后打开“光线”，你会看到曝光数值已改变；打开“色轮”，你会看到暗部已带有相应色调。所有数值仍可自由调整；点击“重置”可恢复匹配前的调色。\n\n“镜头”模式用于匹配需要衔接的两个镜头。“风格”模式则借鉴电影剧照的色彩风格，而不改变场景照明。“强度”控制整体匹配幅度，各分项开关决定允许修改哪些参数。\n\n匹配结果只是调整的起点。若参考与当前画面差异过大，工具会提示你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓當前鏡頭接近另一張參考畫面。\n\n選擇時間軸上的其他片段或匯入影象作為參考，GradeLab 會測量兩張畫面，並計算讓當前鏡頭接近參考所需的調色，包括曝光、白平衡、對比度、飽和度，以及陰影、中間調和亮部的色調。\n\n匹配結果會寫入旁邊工具中的常規引數。匹配後開啟「光線」，你會看到曝光數值已改變；開啟「色輪」，你會看到暗部已帶有相應色調。所有數值仍可自由調整；點選「重置」可恢復匹配前的調色。\n\n「鏡頭」模式用於匹配需要銜接的兩個鏡頭。「風格」模式則借鑑電影劇照的色彩風格，而不改變場景照明。「強度」控制整體匹配幅度，各分項開關決定允許修改哪些引數。\n\n匹配結果只是調整的起點。若參考與當前畫面差異過大，工具會提示你。"
          }
        }
      }
    },
