    "Recording stopped because the encoder could not keep up. Captured footage has been kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde gestoppt, weil der Encoder nicht mithalten konnte. Das aufgenommene Material wurde behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording stopped because the encoder could not keep up. Captured footage has been kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo porque el codificador no pudo seguir el ritmo. Se ha conservado el material capturado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus pysähtyi, koska pakkain ei pysynyt mukana. Kuvattu materiaali on säilytetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement s’est arrêté car l’encodeur ne suivait plus. Les images capturées ont été conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è interrotta perché il codificatore non riusciva a tenere il passo. Il filmato acquisito è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンコーダーの処理が追いつかず録画を停止しました。撮影済みの映像は保管されています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen stoppades eftersom kodaren inte hann med. Det inspelade materialet har behållits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编码器无法及时处理，录制已停止。已保留录到的素材。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編碼器無法及時處理，錄製已停止。已保留錄到的素材。"
          }
        }
      }
    },
