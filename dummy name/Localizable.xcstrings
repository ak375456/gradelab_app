      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, verwendet der Export %lld × %lld und %@. Schalte es aus, um in Export eine andere Ausgabegröße oder Bildrate zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
