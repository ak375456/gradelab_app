    "Estimated from the selected resolution, frame rate and codec. During a take it updates from the recorded file size. Scene detail can change file sizes. Includes a 200 MB safety reserve." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung anhand von Auflösung, Bildrate und Codec. Während der Aufnahme wird die Dateigröße berücksichtigt. Bilddetails beeinflussen die Größe. 200 MB bleiben reserviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated from the selected resolution, frame rate and codec. During a take it updates from the recorded file size. Scene detail can change file sizes. Includes a 200 MB safety reserve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estima según resolución, frecuencia y códec. Durante la toma se actualiza con el tamaño del archivo. El detalle de la escena influye en el tamaño. Incluye una reserva de 200 MB."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvio perustuu tarkkuuteen, kuvataajuuteen ja koodekkiin. Tallennuksen aikana se päivittyy tiedostokoon mukaan. Kuvan yksityiskohdat vaikuttavat kokoon. Sisältää 200 Mt:n varan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation selon la résolution, la fréquence d’images et le codec. Elle s’ajuste à la taille du fichier pendant la prise. Les détails de la scène influencent cette taille. Réserve de 200 Mo incluse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stima basata su risoluzione, frequenza e codec. Durante la ripresa si aggiorna in base al file. I dettagli della scena possono modificarne le dimensioni. Include una riserva di 200 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した解像度、フレームレート、コーデックに基づく推定です。撮影中は録画ファイルのサイズに合わせて更新します。場面の細かさでサイズは変わります。200 MBの予備容量を含みます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppskattat från upplösning, bildfrekvens och kodek. Under tagningen uppdateras tiden från filstorleken. Motivets detaljer påverkar storleken. Inkluderar 200 MB reserv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据所选分辨率、帧率和编解码器估算。录制时会按实际文件大小更新；场景细节也会影响文件大小。估算已预留 200 MB 安全空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據所選解析度、影格率和編解碼器估算。錄製時會按實際檔案大小更新；場景細節也會影響檔案大小。估算已預留 200 MB 安全空間。"
          }
        }
      }
    },
