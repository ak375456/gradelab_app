    "%lld points. Drag a point on the picture to move it, or drag inside the shape to move the whole mask." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Punkte. Zieh einen Punkt im Bild, um ihn zu bewegen, oder zieh innerhalb der Form, um die ganze Maske zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld puntos. Arrastra un punto sobre la imagen para moverlo, o arrastra dentro de la forma para mover toda la máscara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld pisteitä. Vedä kuvaan kohta siirtääksesi sitä, tai raahaa muodon sisään siirtääksesi koko maski."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld points. Faites glisser un point sur l'image pour le déplacer, ou glissez à l'intérieur de la forme pour déplacer tout le masque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld punti. Trascina un punto sull'immagine per spostarlo, oppure trascina all'interno della forma per spostare l'intera maschera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のポイント。画像上のポイントをドラッグして移動するか、図形の内側をドラッグしてマスク全体を移動します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld punkter. Dra en punkt på bilden för att flytta den, eller dra inuti formen för att flytta hela masken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个点。拖动画面上的点可移动该点，在形状内部拖动可移动整个蒙版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個點。拖動畫面上的點可移動該點，在形狀內部拖動可移動整個遮罩。"
          }
        }
      }
    },
    "%lld points. Tap a point to show curve handles; drag a point or handle to refine the edge. Drag inside to move the mask. Pinch to zoom; pan with two fingers." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のポイント。ポイントをタップするとカーブハンドルが表示されます。ポイントやハンドルをドラッグして輪郭を調整します。内側をドラッグしてマスクを移動、ピンチでズーム、2本指でパンできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个点。轻点控制点以显示曲线控制柄；拖动控制点或控制柄以细调边缘。在形状内部拖动可移动蒙版。双指捏合缩放，双指拖动平移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個點。輕點控制點以顯示曲線控制柄；拖動控制點或控制柄以細調邊緣。在形狀內部拖動可移動遮罩。雙指捏合縮放，雙指拖動平移。"
          }
        }
      }
    },
