    "Live camera preview. Tap to focus and meter exposure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Kameravorschau. Zum Fokussieren und Messen der Belichtung tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live camera preview. Tap to focus and meter exposure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa en directo. Toca para enfocar y medir la exposición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran reaaliaikainen esikatselu. Tarkenna ja mittaa valotus napauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu en direct. Touchez pour faire le point et mesurer l’exposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima in tempo reale. Tocca per mettere a fuoco e misurare l’esposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブカメラプレビュー。タップしてピントと露出を合わせます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveförhandsvisning. Tryck för att fokusera och mäta exponeringen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时摄像头预览。点击对焦并测量曝光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時相機預覽。點選對焦並測量曝光。"
          }
        }
      }
    },
    "Live preview · X/Y 0.5 is the canvas center. Reset also clears this clip's animation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Vorschau · X/Y 0,5 ist die Mitte der Arbeitsfläche. „Zurücksetzen“ löscht auch die Animation dieses Clips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
