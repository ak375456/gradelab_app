    "To light only part of the picture, draw a window in Masks and choose it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nur einen Teil des Bildes zu beleuchten, zeichne in Masken ein Fenster und wähle es hier aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para iluminar solo una parte de la imagen, dibuja una ventana en Máscaras y elígela aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos haluat valaista vain osan kuvasta, piirrä ikkuna Maskeissa ja valitse se tästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour n’éclairer qu’une partie de l’image, dessinez une fenêtre dans Masques et choisissez-la ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per illuminare solo una parte dell’immagine, disegna una finestra in Maschere e sceglila qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の一部だけを照らすには、「マスク」で範囲を描き、ここで選択してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du bara vill ljussätta en del av bilden ritar du ett fönster i Masker och väljer det här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要只照亮图片的一部分，请在“蒙版”中画一个窗口，然后在这里选择它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要只照亮圖片的一部分，請在「遮罩」中畫一個視窗，然後在這裡選擇它。"
          }
        }
      }
    },
