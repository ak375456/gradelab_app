            "value" : "Sovelltaa tätä esiasetettua valittuun klippiin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique ce préréglage au clip sélectionné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica questo preset alla clip selezionata"
          }
        },
