        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le nombre pour le saisir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il numero per digitarlo"
