    "Paint this frame, then use Next Frame to continue. Add is blue; Remove is red. A magnifier appears below your finger." : {
      "comment" : "A description of how to use the background refinement controls.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Male diesen Frame, und nutze dann „Nächster Frame“, um fortzufahren. „Hinzufügen“ ist blau, „Entfernen“ rot. Unter deinem Finger erscheint eine Lupe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta este fotograma y luego usa Fotograma siguiente para continuar. Añadir es azul; Quitar es rojo. Aparece una lupa bajo tu dedo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maalaa tämä kehys ja jatka sitten seuraavalla ruutu. Lisää sininen; Poista punainen. Suurennuslasi ilmestyy sormesi alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peignez cette image, puis utilisez Image suivante pour continuer. Ajouter est en bleu ; Retirer en rouge. Une loupe apparaît sous votre doigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipingi questo fotogramma, poi usa Fotogramma successivo per continuare. Aggiungi è blu, Rimuovi è rosso. Sotto il dito compare una lente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måla den här bildrutan och använd sedan Nästa bildruta för att fortsätta. Lägg till är blått; Ta bort är rött. En lupp visas under fingret."
          }
        }
      }
    },
