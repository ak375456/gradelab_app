    "Limits the light to one of this clip's masks — the same window, feather and tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt das Licht auf eine der Masken dieses Clips – mit demselben Fenster, derselben weichen Kante und demselben Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la luz a una de las máscaras de este clip, con la misma ventana, desvanecido y seguimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rajaa valon johonkin tämän klipin maskeista – sama ikkuna, pehmennys ja seuranta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la lumière à l’un des masques de ce plan, avec la même fenêtre, le même adoucissement et le même suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la luce a una delle maschere di questa clip, con la stessa finestra, sfumatura e tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップのマスク内だけにライトを当てます。範囲、境界のぼかし、トラッキングも同じ設定を使います。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar ljuset till en av klippets masker – samma fönster, mjuka kant och spårning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将光线限制在这个片段的其中一个蒙版上——相同的窗口、羽毛和跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將光線限制在這個片段的其中一個遮罩上——相同的視窗、羽毛和追蹤。"
          }
        }
      }
    },
