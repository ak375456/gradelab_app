        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動分隔線以微調預覽和工具區域"
          }
        }
      }
    },
    "Drag the gradient on the picture; Rotation changes its direction." : {
      "localizations" : {
