          }
        }
      }
    },
    "A double tap on an animated property resets its value at the playhead. Use Reset in the property's Animation menu to clear its keyframes as well." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Doppeltippen auf eine animierte Eigenschaft setzt ihren Wert am Abspielkopf zurück. Verwende „Zurücksetzen“ im Animationsmenü der Eigenschaft, um auch ihre Keyframes zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un doble toque sobre una propiedad animada restablece su valor en el cabezal de reproducción. Usa Restablecer en el menú Animación de la propiedad para borrar también sus fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un double toucher sur une propriété animée réinitialise sa valeur à la tête de lecture. Utilisez Réinitialiser dans le menu Animation de la propriété pour effacer aussi ses images clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un doppio tocco su una proprietà animata ne reimposta il valore alla testina di riproduzione. Usa Reimposta nel menu Animazione della proprietà per cancellare anche i suoi fotogrammi chiave."
          }
        }
      }
    },
    "A file already exists at the selected export destination." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am gewählten Exportziel existiert bereits eine Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo en el destino de exportación elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier existe déjà à la destination d'export choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file nella destinazione di esportazione scelta."
          }
        }
      }
    },
    "A gradient replaces the flat text color. Stroke, background, shadow and glow keep their own colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verlauf ersetzt die einfarbige Textfarbe. Kontur, Hintergrund, Schatten und Glow behalten ihre eigenen Farben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un degradado sustituye al color plano del texto. El contorno, el fondo, la sombra y el glow conservan sus propios colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dégradé remplace la couleur unie du texte. Le contour, l'arrière-plan, l'ombre et le glow conservent leurs propres couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gradiente sostituisce il colore pieno del testo. Contorno, sfondo, ombra e glow mantengono i propri colori."
          }
        }
      }
    },
    "A keyframe is here" : {
