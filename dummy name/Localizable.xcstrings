    "Format choices follow the selected lens. Guides, scopes and preview looks never change the original recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Formate richten sich nach dem Objektiv. Hilfslinien, Scopes und Vorschau-Looks verändern die Originalaufnahme nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format choices follow the selected lens. Guides, scopes and preview looks never change the original recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los formatos dependen de la lente. Las guías, los monitores y los looks de vista previa no modifican la grabación original."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muodot määräytyvät objektiivin mukaan. Apuviivat, mittarit ja esikatselutyylit eivät muuta alkuperäistä tallennetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formats dépendent de l’objectif. Les repères, scopes et looks d’aperçu ne modifient jamais l’enregistrement original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I formati dipendono dall’obiettivo. Guide, scope e look di anteprima non modificano la registrazione originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選べる形式はレンズによって異なります。ガイド、スコープ、プレビューのルックは元の録画を変更しません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatvalen följer objektivet. Guider, skop och förhandsvisningslookar ändrar aldrig originalinspelningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用格式取决于所选镜头。构图辅助、示波器和预览风格均不会写入原始录制文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用格式取決於所選鏡頭。構圖輔助、示波器和預覽風格均不會寫入原始錄製檔案。"
          }
        }
      }
    },
