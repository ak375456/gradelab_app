    "GradeLab" : {
      "shouldTranslate" : false
    },
    "GradeLab collects no data. No accounts, no analytics, no advertising and no trackers — your footage never leaves this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab erhebt keine Daten. Keine Accounts, keine Analyse, keine Werbung und keine Tracker — dein Material verlässt dieses Gerät nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab no recopila ningún dato. Sin cuentas, sin analíticas, sin publicidad y sin rastreadores: tu material nunca sale de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab ne collecte aucune donnée. Pas de comptes, pas d'analyse d'audience, pas de publicité, pas de traqueurs — vos rushes ne quittent jamais cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab non raccoglie alcun dato. Nessun account, nessuna analisi, nessuna pubblicità e nessun tracciatore: il tuo girato non lascia mai questo dispositivo."
          }
        }
      }
    },
    "GradeLab couldn’t copy the selected video into its project storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab konnte das ausgewählte Video nicht in seinen Projektspeicher kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab no ha podido copiar el vídeo seleccionado en su almacenamiento de proyectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab n’a pas pu copier la vidéo sélectionnée dans son stockage de projets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab non è riuscito a copiare il video selezionato nel suo archivio progetti."
          }
        }
      }
    },
    "GradeLab couldn’t read its saved projects, and couldn’t set the unreadable file aside. Reinstalling the app will clear it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab konnte seine gesicherten Projekte nicht lesen und die unlesbare Datei nicht beiseitelegen. Eine Neuinstallation der App entfernt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab no ha podido leer sus proyectos guardados ni apartar el archivo ilegible. Reinstalar la app lo eliminará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab n’a pas pu lire ses projets enregistrés ni mettre de côté le fichier illisible. Réinstaller l’app l’effacera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab non è riuscito a leggere i progetti salvati né a mettere da parte il file illeggibile. Reinstallare l’app lo eliminerà."
          }
        }
      }
    },
    "GradeLab couldn’t read its saved projects. The unreadable file has been kept as “%@” in the app’s Recovered folder, and the library has started again empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab konnte seine gesicherten Projekte nicht lesen. Die unlesbare Datei wurde als „%@“ im Ordner „Recovered“ der App behalten, und die Mediathek beginnt wieder leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab no ha podido leer sus proyectos guardados. El archivo ilegible se ha conservado como «%@» en la carpeta Recovered de la app, y la biblioteca vuelve a empezar vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab n’a pas pu lire ses projets enregistrés. Le fichier illisible a été conservé sous « %@ » dans le dossier Recovered de l’app, et la bibliothèque repart vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab non è riuscito a leggere i progetti salvati. Il file illeggibile è stato conservato come “%@” nella cartella Recovered dell’app e la libreria riparte vuota."
          }
        }
      }
    },
    "GradeLab couldn’t read this image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab konnte dieses Bild nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
