    "Drag a light on the picture to move it. Arrow keys nudge the selected light — Shift for larger steps, Option for finer ones. Delete removes it and ⌘D duplicates it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Licht im Bild, um es zu verschieben. Die Pfeiltasten verschieben das ausgewählte Licht – mit Umschalt in größeren, mit Wahl in feineren Schritten. Rückschritt löscht es, ⌘D dupliziert es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra una luz sobre la imagen para moverla. Las flechas desplazan la luz seleccionada: Mayúsculas para pasos más grandes, Opción para pasos más finos. Eliminar la borra y ⌘D la duplica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siirrä valoa vetämällä sitä kuvassa. Nuolinäppäimet siirtävät valittua valoa – vaihto isommin askelin, optio hienommin. Poistonäppäin poistaa sen ja ⌘D monistaa sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une lumière sur l’image pour la déplacer. Les flèches déplacent la lumière sélectionnée : Maj pour de plus grands pas, Option pour des pas plus fins. Supprimer la retire et ⌘D la duplique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una luce sull’immagine per spostarla. I tasti freccia spostano la luce selezionata: Maiuscole per passi più ampi, Opzione per passi più fini. Elimina la rimuove e ⌘D la duplica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像上のライトをドラッグして移動します。矢印キーで選択中のライトを動かせます。Shiftで大きく、Optionで細かく移動します。Deleteで削除、⌘Dで複製します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra ett ljus i bilden för att flytta det. Piltangenterna flyttar det markerade ljuset – Skift för större steg, Alternativ för finare. Delete tar bort det och ⌘D duplicerar det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图片上拖动一盏灯以移动它。箭头键推动选定的灯光——Shift用于更大的步骤，Option用于更精细的步骤。删除它，⌘D复制它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在圖片上拖動一盞燈以移動它。箭頭鍵推動選定的燈光——Shift用於更大的步驟，Option用於更精細的步驟。刪除它，⌘D複製它。"
          }
        }
      }
    },
    "Drag edges to trim · Hold to move · Keep holding for more" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanten ziehen zum Trimmen · Halten zum Bewegen · Weiter halten für mehr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los bordes para recortar · Mantén pulsado para mover · Sigue pulsando para más opciones"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vedä reunat leikata · Pidä liikkua · Pidä kiinni enemmän"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les bords pour ajuster · Maintenez pour déplacer · Maintenez encore pour plus d'options"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i bordi per regolare · Tieni premuto per spostare · Continua a premere per altre opzioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端をドラッグしてトリム · 長押しで移動 · 押し続けるとその他の操作"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra i kanterna för att trimma · Håll för att flytta · Håll kvar för fler val"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动边缘进行修剪·按住移动·继续按住以获得更多"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動邊緣進行修剪·按住移動·繼續按住以獲得更多"
          }
        }
      }
    },
    "Drag text in the preview. Pinch to resize; turn with two fingers to rotate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Text in der Vorschau. Zusammenziehen ändert die Größe; mit zwei Fingern drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el texto en la previsualización. Pellizca para redimensionarlo; gíralo con dos dedos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vedä tekstiä esikatseluun. Pinch muuttaa kokoa, käännä kahdella sormella pyörimään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le texte dans l'aperçu. Pincez pour le redimensionner ; tournez à deux doigts pour le faire pivoter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il testo nell'anteprima. Pizzica per ridimensionarlo; ruotalo con due dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューのテキストをドラッグして移動します。ピンチでサイズ変更、2本指を回して回転できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra texten i förhandsvisningen. Knip för att ändra storlek; vrid med två fingrar för att rotera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在预览中拖动文本。捏紧以调整大小；用两根手指转动以旋转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在預覽中拖動文字。捏緊以調整大小；用兩根手指轉動以旋轉。"
          }
        }
      }
    },
    "Drag the divider to fine-tune the preview and tool area" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动分隔线以微调预览和工具区域"
