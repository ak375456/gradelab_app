    "Colour Selection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbauswahl"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selección de color"
          }
        },
        "fi" : {
          "stringUnit" : {
