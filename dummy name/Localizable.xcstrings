          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将视频、照片和音频放在这里，或者使用导入媒体。然后将一个拖到画布或时间线上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
