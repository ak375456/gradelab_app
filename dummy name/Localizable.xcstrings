          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma per spostarla, o le sue maniglie per ridimensionarla, ruotarla e ammorbidirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェイプをドラッグして移動し、ハンドルでサイズ、回転、境界のぼかしを調整します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra formen för att flytta den, eller dess handtag för att ändra storlek, rotera och mjuka upp den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
