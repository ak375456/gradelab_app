    "Keep this grade and add the copied one, or replace it?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Grading behalten und das kopierte hinzufügen oder ersetzen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conservar este etalonaje y añadir el copiado, o sustituirlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä tämä arvosana ja lisää kopio tai korvaa se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver cet étalonnage et ajouter celui qui a été copié, ou le remplacer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi mantenere questo grading e aggiungere quello copiato, o sostituirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグレードにコピーした設定を重ねますか？それとも置き換えますか？"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behålla den här gradingen och lägga till den kopierade, eller ersätta den?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留这个调色并添加复制的调色，还是替换它？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留這個調色並新增複製的調色，還是替換它？"
          }
        }
      }
    },
    "Keeps the deepest shadows from being lifted into grey." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass die tiefsten Schatten ins Graue angehoben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que las sombras más profundas se vuelvan grises."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estää syvimpiä varjoja vaalenemasta harmaiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche les ombres les plus profondes de virer au gris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita che le ombre più profonde diventino grigie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も暗いシャドウが灰色に持ち上がるのを防ぎます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindrar de djupaste skuggorna från att lyftas till grått."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止最深的阴影变成灰色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止最深的陰影變成灰色。"
          }
        }
      }
    },
    "Keeps the filter from reaching across a real edge. Black text on a white wall stays sharp however far the radius is pushed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass der Filter über eine echte Kante hinweggreift. Schwarze Schrift auf weißer Wand bleibt scharf, wie weit der Radius auch aufgedreht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que el filtro cruce un borde real. El texto negro sobre una pared blanca sigue nítido por mucho que se suba el radio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se estää suodatinta kurkottamasta oikean reunan yli. Musta teksti valkoisella seinällä pysyy terävänä riippumatta siitä, kuinka kauas säde on työnnetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche le filtre de franchir un véritable contour. Un texte noir sur un mur blanc reste net, aussi loin que le rayon soit poussé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisce al filtro di attraversare un bordo vero. Un testo nero su un muro bianco resta nitido per quanto si spinga il raggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の輪郭を越えてフィルターがかかるのを防ぎます。半径を大きくしても、白い壁の黒い文字はくっきり保たれます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindrar filtret från att sträcka sig över en verklig kant. Svart text på en vit vägg förblir skarp hur långt radien än dras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止过滤器穿过真实边缘。无论半径推多远，白墙上的黑色文字都保持清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止過濾器穿過真實邊緣。無論半徑推多遠，白牆上的黑色文字都保持清晰。"
          }
        }
      }
    },
    "Keeps the grade you have now, including the last match, and matches on top of it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält das Grading, das du jetzt hast, einschließlich des letzten Abgleichs, und gleicht darauf ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el etalonaje que tienes ahora, incluido el último ajuste, y ajusta encima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitää arvosanan, joka sinulla on nyt, myös viimeisen ottelun, ja sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve l'étalonnage que vous avez maintenant, y compris la dernière correspondance, et fait correspondre par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene il grading che hai ora, incluso l'ultimo abbinamento, e abbina sopra di esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前のマッチを含む現在のグレードを保持し、その上に新しいマッチを適用します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller gradingen du har nu, inklusive den senaste matchningen, och matchar ovanpå den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持你现在的成绩，包括上一场比赛，以及上面的比赛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持你現在的成績，包括上一場比賽，以及上面的比賽。"
          }
        }
      }
    },
