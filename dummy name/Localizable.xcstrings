    "Drag to resize. Double tap to restore the automatic size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh, um die Größe zu ändern. Doppeltippen stellt die automatische Größe wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
