    "This layer is kept where the matte source is opaque." : {
      "comment" : "Explanation of a track matte mode when the mode is `.alpha`.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ebene bleibt dort erhalten, wo die Matte-Quelle deckend ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta capa se conserva donde el origen de la máscara es opaco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä kerros säilytetään siellä, missä mattalähde on läpinäkymätön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
