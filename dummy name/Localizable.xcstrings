          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leikkeissä ei ole tarpeeksi lähderuutu siirtymää varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips n’ont pas assez d’images sources pour une transition."
          }
