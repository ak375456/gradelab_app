          }
        }
      }
    },
    "This frame and the one before it. Fastest, and never waits on a frame that has not been decoded yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Frame und der davor. Am schnellsten, und wartet nie auf einen Frame, der noch nicht dekodiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este fotograma y el anterior. Lo más rápido, y nunca espera a un fotograma que aún no se ha descodificado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä ja sitä edeltänyt kehys on nopein, eikä koskaan odota ruutu, jota ei ole vielä purettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette image et celle d'avant. Le plus rapide, et n'attend jamais une image qui n'est pas encore décodée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo fotogramma e quello prima. Il più rapido, e non attende mai un fotogramma non ancora decodificato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
