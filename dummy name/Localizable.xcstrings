    "HDR preview · %.1f× display headroom. The system applies HLG display tone mapping, the same as Photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR-Vorschau · %.1f× Display-Headroom. Das System wendet HLG-Display-Tonemapping an, genau wie „Fotos“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa HDR · margen de pantalla %.1f×. El sistema aplica el mapeo tonal de pantalla HLG, igual que Fotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR- esikatselu · %.1f× näytön päätila. Järjestelmässä käytetään HLG-näyttöjen äänikartoitusta, kuten Valokuvissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu HDR · marge d’affichage %.1f×. Le système applique le tone mapping d’affichage HLG, comme Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima HDR · headroom del display %.1f×. Il sistema applica il tone mapping HLG del display, come Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRプレビュー · ディスプレイのヘッドルーム%.1f倍。「写真」と同じHLG表示トーンマッピングをシステムが適用します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR-förhandsvisning · %.1f× skärmutrymme. Systemet tillämpar HLG-tonmappning för skärmen, samma som i Bilder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
