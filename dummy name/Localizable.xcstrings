    "An HDR frame reached the SDR compositing path. This is a bug; the frame was refused rather than clipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein HDR-Frame ist in den SDR-Compositing-Pfad gelangt. Das ist ein Fehler; der Frame wurde abgewiesen statt beschnitten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fotograma HDR llegó a la cadena de composición SDR. Es un fallo; el fotograma se rechazó en lugar de recortarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR-kehikko saavutti SDR:n säveltämispolun. Tämä on vika; kehys hylättiin sen sijaan, että se olisi leikattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une image HDR est arrivée dans la chaîne de composition SDR. C'est un bug ; l'image a été refusée plutôt qu'écrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fotogramma HDR è arrivato alla catena di composizione SDR. È un bug; il fotogramma è stato rifiutato anziché tagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRフレームがSDR合成処理に渡されました。これは不具合です。クリッピングを避けるため、このフレームの処理を中止しました。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En HDR-bildruta nådde SDR-kompositionskedjan. Det är ett fel; bildrutan avvisades i stället för att klippas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 帧进入了 SDR 合成流程。由于流程异常，已拒绝此帧，以防高光被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
