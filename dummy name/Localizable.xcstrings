        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画、写真、音声をここにドロップするか、「メディアを読み込む」を使います。その後、キャンバスやタイムラインにドラッグして配置できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
