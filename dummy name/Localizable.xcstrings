    "Keyframes belong to the clip, so they move, copy and split with it, and the preview always matches the export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframes gehören zum Clip — sie werden mit ihm verschoben, kopiert und geteilt, und die Vorschau entspricht immer dem Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fotogramas clave pertenecen al clip: se mueven, se copian y se dividen con él, y la previsualización siempre coincide con la exportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images clés appartiennent au clip : elles se déplacent, se copient et se divisent avec lui, et l'aperçu correspond toujours à l'export."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fotogrammi chiave appartengono alla clip: si spostano, si copiano e si dividono con lei, e l'anteprima corrisponde sempre all'esportazione."
