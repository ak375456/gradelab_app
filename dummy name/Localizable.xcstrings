    "Green channel. Raising adds green; lowering leans magenta." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grünkanal. Anheben fügt Grün hinzu; Absenken neigt zu Magenta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal verde. Subirlo añade verde; bajarlo tira hacia el magenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vihreä kanava. Nousu lisää viheriötä, laskeminen magentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal vert. Monter ajoute du vert ; descendre tire vers le magenta."
          }
        },
        "it" : {
