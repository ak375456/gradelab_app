    "4K and original-resolution export, your own frame rate and bitrate, and ProRes where supported" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export in 4K und Originalauflösung, eigene Bildrate und Bitrate sowie ProRes, wo unterstützt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportación en 4K y a resolución original, tu propia frecuencia de fotogramas y tasa de bits, y ProRes donde sea compatible"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "4K:n ja alkuperäisen resoluution vienti, oma kehysnopeus ja bittinopeus sekä ProRes, jossa tuetaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export en 4K et en résolution d'origine, fréquence d'images et débit personnalisés, et ProRes là où il est pris en charge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportazione in 4K e alla risoluzione originale, frequenza fotogrammi e bitrate personalizzati, e ProRes dove supportato"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export i 4K och originalupplösning, egen bildfrekvens och bithastighet, och ProRes där det stöds"
          }
        }
      }
    },
