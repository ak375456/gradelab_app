    "Pause the preview before measuring. While it plays the picture is rendered smaller, and a smaller picture carries less noise than the real one." : {
      "comment" : "Warning text to be displayed when the user tries to measure noise while the preview is playing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere die Vorschau, bevor du messen lässt. Während der Wiedergabe wird das Bild kleiner gerendert, und ein kleineres Bild trägt weniger Rauschen als das echte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la previsualización antes de medir. Mientras se reproduce, la imagen se renderiza más pequeña, y una imagen más pequeña lleva menos ruido que la real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keskeytä esikatselu ennen mittaamista. Kuvaa näytettäessä se on pienempi, ja pienemmässä kuvassa on vähemmän melua kuin todellisessa kuvassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez l'aperçu en pause avant de mesurer. Pendant la lecture, l'image est rendue plus petite, et une image plus petite porte moins de bruit que la vraie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa l'anteprima prima di misurare. Durante la riproduzione l'immagine viene renderizzata più piccola, e un'immagine più piccola porta meno rumore di quella vera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定前にプレビューを停止してください。再生中は小さな画像で描画するため、本来の画像よりノイズが少なく見えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa förhandsvisningen innan du mäter. Under uppspelning renderas bilden mindre, och en mindre bild bär mindre brus än den verkliga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先暂停预览再测量。播放时会降低预览分辨率，画面中的噪点看起来也会比原始素材更少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先暫停預覽再測量。播放時會降低預覽解析度，畫面中的雜訊看起來也會比原始素材更少。"
          }
        }
      }
    },
    "Paused — the device is hot" : {
