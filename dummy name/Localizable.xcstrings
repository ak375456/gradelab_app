        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pista de audio de origen tiene un formato ilegible y no se puede conservar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lähteen ääniraita on lukukelvoton, eikä sitä voi säilyttää."
          }
