          }
        }
      }
    },
    "Your grade, transforms and keyframes carry over." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グレード、変形、キーフレームを引き継ぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
