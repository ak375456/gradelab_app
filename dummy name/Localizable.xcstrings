        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela enregistre la valeur actuellement affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo salva il valore visibile in questo momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sparar värdet du ser just nu."
          }
        }
      }
    },
    "That speed would leave the clip with no duration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
