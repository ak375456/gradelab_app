        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黒を持ち上げ、色を抑え、ハイライトを滑らかにした、柔らかく少し色あせたルック。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjuk, lätt urblekt look med lyft svärta, dämpad färg och mjuka högdagrar."
