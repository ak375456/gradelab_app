    "Remaps saturation. Lowering the right compresses colors that are already strong; lifting the left brings up quiet ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet die Sättigung neu ab. Die rechte Seite abzusenken komprimiert bereits kräftige Farben; die linke anzuheben holt zurückhaltende hervor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redistribuye la saturación. Bajar la derecha comprime los colores que ya son intensos; subir la izquierda realza los más apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redistribue la saturation. Baisser la droite comprime les couleurs déjà fortes ; remonter la gauche relève les plus discrètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridistribuisce la saturazione. Abbassare la destra comprime i colori già intensi; alzare la sinistra fa emergere quelli più sommessi."
          }
        }
      }
    },
