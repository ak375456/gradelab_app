    "This project has only one clip, so there is nothing on the timeline to match to. Import a reference image instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt hat nur einen Clip, es gibt also auf der Timeline nichts, worauf abgeglichen werden könnte. Importiere stattdessen ein Referenzbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto solo tiene un clip, así que no hay nada en la línea de tiempo con lo que ajustar. Importa en su lugar una imagen de referencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tässä projektissa on vain yksi klippi, joten aikajanalla ei ole mitään sopivaa. Tuo sen sijaan viitekuva."
          }
        },
        "fr" : {
          "stringUnit" : {
