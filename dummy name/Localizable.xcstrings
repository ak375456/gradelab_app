    "This is a 1D LUT. Looks need a 3D LUT — one with a LUT_3D_SIZE line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein 1D-LUT. Looks brauchen ein 3D-LUT — eines mit einer LUT_3D_SIZE-Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una LUT 1D. Los looks necesitan una LUT 3D, con una línea LUT_3D_SIZE."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä on 1D LUT. Näyttää tarvitsevan 3D LUT:n, jossa on LUT_3D_SIZE-linja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est une LUT 1D. Les looks exigent une LUT 3D — avec une ligne LUT_3D_SIZE."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una LUT 1D. I look richiedono una LUT 3D, con una riga LUT_3D_SIZE."
          }
        },
        "sv" : {
          "stringUnit" : {
