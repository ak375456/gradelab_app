        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina solo il preset salvato. Le clip a cui lo hai già applicato conservano il loro grading."
          }
        }
      }
    },
    "This source declares itself as %@, not %@, so it is not processed through the %@ transform." : {
