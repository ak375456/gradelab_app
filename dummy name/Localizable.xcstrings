            "value" : "Schwarz"
          }
        }
      }
    },
    "Blend" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blend"
          }
        }
      }
    },
    "Blend modes other than Normal are not available in HDR projects yet. They are defined on 0-1 values, and an HDR image is not." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Mischmodi als Normal sind in HDR-Projekten noch nicht verfügbar. Sie sind auf Werten von 0 bis 1 definiert, ein HDR-Bild ist das nicht."
          }
        }
      }
    },
    "Blending between source frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überblendung zwischen Quellframes."
          }
        }
      }
    },
    "Blends adjacent frames instead of repeating them, which removes the stepping in slow motion on footage that was not shot at a high frame rate. Fast movement softens rather than gaining detail — no new frames are invented." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet benachbarte Frames ineinander, statt sie zu wiederholen. Das entfernt das Ruckeln in Zeitlupen aus Material, das nicht mit hoher Bildrate aufgenommen wurde. Schnelle Bewegung wird weicher, statt an Detail zu gewinnen — es werden keine neuen Frames erfunden."
          }
        }
      }
    },
    "Bloom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom"
          }
        }
      }
    },
    "Bloom, glow, halation and grain. Fade and sharpening stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom, Glow, Halation und Korn. Fade und Schärfen bleiben kostenlos."
          }
        }
      }
    },
    "Blue" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blau"
          }
        }
      }
    },
    "Blue channel. Raising adds blue; lowering leans yellow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blaukanal. Anheben fügt Blau hinzu; Absenken neigt zu Gelb."
          }
        }
      }
    },
    "Bold" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fett"
          }
        }
      }
    },
    "Bold and Italic are available only when this font includes that variation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fett und Kursiv sind nur verfügbar, wenn diese Schrift die jeweilige Variante enthält."
          }
        }
      }
    },
    "Bright areas bleed into what surrounds them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle Bereiche laufen in ihre Umgebung aus."
          }
        }
      }
    },
    "Brightness by saturation. Lowering the right darkens the most colorful areas and leaves neutrals alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit nach Sättigung. Die rechte Seite abzusenken dunkelt die farbigsten Bereiche ab und lässt Neutraltöne unberührt."
          }
        }
      }
    },
    "Brightness of one color. Pick a hue, then drag down to darken it — a deeper sky, for instance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit einer einzelnen Farbe. Wähle einen Farbton und zieh nach unten, um ihn abzudunkeln — für einen tieferen Himmel zum Beispiel."
          }
        }
      }
    },
    "Bring your own typography." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deine eigene Typografie mit."
          }
        }
      }
    },
    "Bring your signature look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deinen eigenen Look mit."
          }
        }
      }
    },
    "Built for %@ footage. Applied before the other tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@-Material gebaut. Wird vor den anderen Werkzeugen angewendet."
          }
        }
      }
    },
    "Built into GradeLab" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In GradeLab integriert"
          }
        }
      }
    },
    "Buy now and it stays yours forever, whatever the price becomes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauf jetzt, und er bleibt für immer deiner — ganz gleich, wie sich der Preis entwickelt."
