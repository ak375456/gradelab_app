    "Choose a .ttf font file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine .ttf-Schriftdatei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de fuente .ttf."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse .ttf-kirjasintiedosto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier de police .ttf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un file di font .ttf."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en .ttf-teckensnittsfil."
          }
        }
      }
    },
    "Choose a color, then change its hue, saturation, or lightness. Try reducing blue lightness for a deeper sky. Nearby colors blend smoothly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Farbe und ändere dann ihren Farbton, ihre Sättigung oder ihre Helligkeit. Versuche, die Helligkeit von Blau zu senken, für einen tieferen Himmel. Benachbarte Farben gehen weich ineinander über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un color y luego cambia su tono, su saturación o su luminosidad. Prueba a reducir la luminosidad del azul para un cielo más denso. Los colores cercanos se funden con suavidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse väri, muuta värisävyä, värikylläisyyttä tai vaaleutta. Yritä vähentää sinistä vaaleutta syvemmälle taivaalle. Lähivärit sekoittuvat sulavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une couleur, puis modifiez sa teinte, sa saturation ou sa luminosité. Essayez de réduire la luminosité du bleu pour un ciel plus dense. Les couleurs voisines se fondent en douceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un colore, poi modificane tonalità, saturazione o luminosità. Prova a ridurre la luminosità del blu per un cielo più intenso. I colori vicini si fondono in modo morbido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en färg och ändra sedan dess nyans, mättnad eller ljushet. Prova att minska blåets ljushet för en djupare himmel. Närliggande färger övergår mjukt."
          }
        }
      }
    },
    "Choose a delivery size and frame rate below. The canvas layout stays the same." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
