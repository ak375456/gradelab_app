        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3のオリジナルは保持されます。GradeLabでは色を10ビット精度でRec.709に変換し、編集と書き出しの色を統一します。"
          }
        },
        "sv" : {
          "stringUnit" : {
