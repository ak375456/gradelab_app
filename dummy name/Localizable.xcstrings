            "value" : "Lyhyt vauhdinpuuska, joka ohittaa tylsän osan ilman leikkausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une brève accélération qui saute le passage sans intérêt, sans couper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un breve scatto di velocità che salta la parte noiosa senza uno stacco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kort fartökning som hoppar över den tråkiga biten utan en klippning."
          }
        }
      }
    },
    "A soft diffusion across the whole frame, not only the highlights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine weiche Diffusion über das ganze Bild, nicht nur über die Lichter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una difusión suave por todo el fotograma, no solo en las altas luces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pehmeä diffuusio koko runkoon, ei vain kohokohtiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une diffusion douce sur toute l'image, pas seulement sur les hautes lumières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una diffusione morbida su tutto il fotogramma, non solo sulle alte luci."
