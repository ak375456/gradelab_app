    "Apple Log" : {
      "shouldTranslate" : false
    },
    "Apple Log 2" : {
      "shouldTranslate" : false
    },
    "Apple Log layers need BGRA preview or 10-bit 4:2:2 export surfaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-Log-Ebenen benötigen BGRA-Vorschau- oder 10-Bit-4:2:2-Export-Surfaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capas Apple Log necesitan una previsualización BGRA o superficies de exportación de 10 bits 4:2:2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calques Apple Log exigent un aperçu BGRA ou des surfaces d'export 10 bits 4:2:2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli Apple Log richiedono un'anteprima BGRA o superfici di esportazione a 10 bit 4:2:2."
          }
        }
      }
    },
    "Apple Log layers require untouched full-range 10-bit 4:2:2 source frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-Log-Ebenen benötigen unveränderte 10-Bit-4:2:2-Quellframes im vollen Wertebereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capas Apple Log requieren fotogramas de origen intactos de 10 bits 4:2:2 a rango completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calques Apple Log exigent des images sources intactes en 10 bits 4:2:2 pleine plage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli Apple Log richiedono fotogrammi sorgente intatti a 10 bit 4:2:2 a gamma piena."
          }
        }
      }
    },
    "Apple's Apple Log to Rec.709 rendering LUT could not be loaded, so the export has no defined display transform." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Rendering-LUT von Apple Log nach Rec.709 konnte nicht geladen werden, daher hat der Export keine definierte Display-Transformation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la LUT de renderizado de Apple Log a Rec.709 de Apple, así que la exportación no tiene una transformación de visualización definida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La LUT de rendu Apple Log vers Rec.709 d'Apple n'a pas pu être chargée : l'export n'a donc aucune transformation d'affichage définie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare la LUT di rendering da Apple Log a Rec.709 di Apple, quindi l'esportazione non ha una trasformazione di visualizzazione definita."
          }
        }
      }
    },
    "Apple's Apple Log to Rec.709 rendering LUT could not be loaded. Apple Log layers have no defined display transform without it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples Rendering-LUT von Apple Log nach Rec.709 konnte nicht geladen werden. Ohne es haben Apple-Log-Ebenen keine definierte Display-Transformation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la LUT de renderizado de Apple Log a Rec.709 de Apple. Sin ella, las capas Apple Log no tienen una transformación de visualización definida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La LUT de rendu Apple Log vers Rec.709 d'Apple n'a pas pu être chargée. Sans elle, les calques Apple Log n'ont aucune transformation d'affichage définie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare la LUT di rendering da Apple Log a Rec.709 di Apple. Senza di essa i livelli Apple Log non hanno una trasformazione di visualizzazione definita."
          }
        }
      }
    },
    "Applied top to bottom, over your main grade." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von oben nach unten angewendet, über deinem Haupt-Grading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica de arriba abajo, sobre tu etalonaje principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliqué de haut en bas, par-dessus votre étalonnage principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applicato dall'alto verso il basso, sopra il tuo grading principale."
          }
        }
      }
    },
    "Applies this preset to the selected clip" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wendet dieses Preset auf den ausgewählten Clip an"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica este preajuste al clip seleccionado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique ce préréglage au clip sélectionné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica questo preset alla clip selezionata"
          }
        }
      }
    },
    "Applies while playing only. Paused, the picture is always at the project's own resolution, and export is unaffected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur während der Wiedergabe. Pausiert liegt das Bild immer in der Projektauflösung vor, und der Export bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica durante la reproducción. En pausa, la imagen siempre está a la resolución del proyecto, y la exportación no se ve afectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne s'applique qu'à la lecture. En pause, l'image est toujours à la résolution du projet, et l'export n'est pas affecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica solo durante la riproduzione. In pausa l'immagine è sempre alla risoluzione del progetto, e l'esportazione non ne risente."
          }
        }
      }
    },
    "Apply" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
