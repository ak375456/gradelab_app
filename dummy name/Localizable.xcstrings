    "Clips fit inside the canvas. Use Transform to reposition or enlarge them." : {
      "comment" : "A description below the canvas size controls, explaining that users can resize the clips within the canvas.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips werden in die Arbeitsfläche eingepasst. Verwende Transformieren, um sie zu verschieben oder zu vergrößern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips se ajustan dentro del lienzo. Usa Transformar para recolocarlos o ampliarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clipsit sopivat kankaan sisään. Käytä Transformia niiden uudelleenasetteluun tai suurentamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans sont ajustés à l'intérieur du canevas. Utilisez Transformer pour les repositionner ou les agrandir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I clip vengono adattati all'interno del canvas. Usa Trasforma per riposizionarli o ingrandirli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippen passas in i arbetsytan. Använd Transform för att flytta eller förstora dem."
          }
        }
      }
    },
    "Clips fit inside the canvas. Use Transform to reposition or enlarge them. Export Original preserves this canvas size." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips werden in die Arbeitsfläche eingepasst. Mit „Transformieren“ kannst du sie neu positionieren oder vergrößern. „Original exportieren“ behält diese Arbeitsflächengröße bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips se ajustan dentro del lienzo. Usa Transformar para recolocarlos o agrandarlos. Exportar Original conserva este tamaño de lienzo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kankaan sisään mahtuvat Clipsit. Aseta ne uudelleen tai suurenna Transformilla. Vie alkuperäinen säilyttää tämän kokoisen kankaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips s'ajustent à l'intérieur du canevas. Utilisez Transformer pour les repositionner ou les agrandir. L'export Original conserve cette taille de canevas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip si adattano all'interno del canvas. Usa Trasforma per riposizionarle o ingrandirle. L'esportazione Originale conserva questa dimensione del canvas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippen passas in i arbetsytan. Använd Transform för att flytta eller förstora dem. Exportera original bevarar den här arbetsytans storlek."
          }
        }
      }
    },
    "Clips on the same track cannot overlap. Use an overlay track." : {
      "localizations" : {
        "de" : {
