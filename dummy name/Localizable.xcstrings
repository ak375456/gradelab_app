    "Answers there often come faster than by email, and feature requests get discussed in the open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort kommen Antworten oft schneller als per E-Mail, und Feature-Wünsche werden öffentlich diskutiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allí las respuestas suelen llegar antes que por correo, y las peticiones de funciones se debaten a la vista de todos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vastaukset tulevat usein nopeammin kuin sähköpostilla, ja ominaisuuspyynnöistä keskustellaan avoimesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses y arrivent souvent plus vite que par e-mail, et les demandes de fonctionnalités s'y discutent au grand jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lì le risposte arrivano spesso prima che via e-mail, e le richieste di funzioni si discutono alla luce del sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールより早く回答を得られることもあり、機能の要望についても公開で話し合えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar där kommer ofta snabbare än via e-post, och funktionsönskemål diskuteras öppet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那里的答案通常比电子邮件更快，功能请求会公开讨论。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那裡的答案通常比電子郵件更快，功能請求會公開討論。"
          }
        }
      }
    },
