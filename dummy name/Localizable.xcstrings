    "Frames are repeated or dropped. Speed and audio timing stay unchanged; no motion interpolation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frames werden wiederholt oder ausgelassen. Tempo und Audio-Timing bleiben unverändert; keine Bewegungsinterpolation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fotogramas se repiten o se descartan. La velocidad y la sincronía del audio no cambian; no hay interpolación de movimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Runkoja toistetaan tai pudotetaan. Nopeus ja äänen ajoitus pysyvät ennallaan, ei liikkeen interpolointia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images sont répétées ou supprimées. La vitesse et la synchronisation audio restent inchangées ; aucune interpolation de mouvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fotogrammi vengono ripetuti o scartati. Velocità e sincronia dell'audio restano invariate; nessuna interpolazione di movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームを複製または間引きます。速度と音声のタイミングは維持され、動きの補間は行いません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildrutor upprepas eller hoppas över. Hastighet och ljudtajming förblir oförändrade; ingen rörelseinterpolering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
