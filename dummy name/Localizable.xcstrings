          }
        }
      }
    },
    "Tapping a preset replaces the current grade. You can keep editing afterwards, and the preset stays as it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen auf ein Preset ersetzt das aktuelle Grading. Du kannst danach weiter bearbeiten, und das Preset bleibt so, wie es gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar un preajuste sustituye el etalonaje actual. Puedes seguir editando después, y el preajuste se queda tal y como se guardó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetuksen valinta korvaa nykyisen värimäärittelyn. Voit jatkaa muokkausta sen jälkeen; tallennettu esiasetus säilyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher un préréglage remplace l'étalonnage actuel. Vous pouvez continuer à modifier ensuite, et le préréglage reste tel qu'il a été enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccare un preset sostituisce il grading attuale. Puoi continuare a modificare dopo, e il preset resta come è stato salvato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att trycka på en förinställning ersätter den aktuella gradingen. Du kan fortsätta redigera efteråt, och förinställningen förblir som den sparades."
          }
        }
      }
    },
    "Temperature" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Värilämpötila"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Température"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur"
          }
        }
      }
    },
    "Temperature balances warm and cool. Tint balances green and magenta. Vibrance gently boosts quieter colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Temperatur gleicht warm und kühl aus. Die Tönung gleicht Grün und Magenta aus. Die Dynamik hebt zurückhaltende Farben sanft an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura equilibra el cálido y el frío. El matiz equilibra el verde y el magenta. Vibrance realza suavemente los colores más apagados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lämpötila tasapainottaa lämmintä ja viileää. Tint tasapainottaa vihreää ja magentaa. Vibrence lisää hellävaraisesti hiljaisempia värejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La température équilibre le chaud et le froid. La nuance équilibre le vert et le magenta. La vibrance renforce doucement les couleurs les plus discrètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura bilancia caldo e freddo. La tinta bilancia verde e magenta. La vividezza esalta delicatamente i colori più spenti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur balanserar varmt och kallt. Färgton balanserar grönt och magenta. Lyster lyfter försiktigt de tystare färgerna."
          }
        }
      }
    },
    "Temporal · %lld frames" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitlich · %lld Frames"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporal · %lld fotogramas"
