    "Export always renders at high quality and uses the same engine the preview does, so the file matches what you tuned." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export rendert immer in hoher Qualität und verwendet dieselbe Engine wie die Vorschau, sodass die Datei dem entspricht, was du eingestellt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación se renderiza siempre en alta calidad y usa el mismo motor que la previsualización, así que el archivo coincide con lo que ajustaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vie aina korkealaatuisena ja käyttää esikatselussa samaa moottoria, joten tiedosto vastaa virittämääsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'export est toujours rendu en haute qualité et utilise le même moteur que l'aperçu, si bien que le fichier correspond à ce que vous avez réglé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione viene sempre renderizzata in alta qualità e usa lo stesso motore dell'anteprima, così il file corrisponde a ciò che hai regolato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しは常に高画質で、プレビューと同じエンジンを使用します。調整したとおりの映像がファイルになります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporten renderas alltid med hög kvalitet och använder samma motor som förhandsvisningen, så filen stämmer med det du ställde in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
