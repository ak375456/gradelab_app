    "Tap a point to edit it, or double tap the graph to add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe einen Punkt an, um ihn zu bearbeiten, oder doppeltippe auf die Grafik, um einen hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un punto para editarlo, o toca dos veces el gráfico para añadir uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napauta pistettä muokataksesi sitä, tai napauta käyrää kaksin käsin lisätäksesi yhden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un point pour le modifier, ou touchez deux fois le graphique pour en ajouter un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un punto per modificarlo, o tocca due volte il grafico per aggiungerne uno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en punkt för att redigera den, eller dubbeltryck på grafen för att lägga till en."
          }
        }
      }
    },
    "Tap a point to select it — the numbers above the graph are its exact values. Tap it again to remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Punkt, um ihn auszuwählen — die Zahlen über dem Graphen sind seine genauen Werte. Tippe erneut, um ihn zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un punto para seleccionarlo: los números sobre la gráfica son sus valores exactos. Vuelve a tocarlo para quitarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napauta kohtaa valitaksesi sen – kuvion yläpuolella olevat numerot ovat sen tarkkoja arvoja. Napauta sitä uudelleen poistaaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un point pour le sélectionner — les chiffres au-dessus du graphique sont ses valeurs exactes. Touchez-le à nouveau pour le retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un punto per selezionarlo: i numeri sopra il grafico sono i suoi valori esatti. Toccalo di nuovo per rimuoverlo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en punkt för att välja den — siffrorna ovanför grafen är dess exakta värden. Tryck igen för att ta bort den."
          }
        }
      }
    },
    "Tap a property's name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Namen einer Eigenschaft tippen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre de una propiedad"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napauta kiinteistön nimeä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le nom d'une propriété"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il nome di una proprietà"
          }
        },
        "sv" : {
