    "Preview keeps the timeline responsive. High is used for export either way." : {
      "comment" : "A description of the optical flow quality setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschau hält die Timeline flüssig. Für den Export wird ohnehin Hoch verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa mantiene la línea de tiempo con respuesta rápida. La exportación usa Alta en cualquier caso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esikatselu pitää aikajanan reagoivana. Korkeaa käytetään vientiin joka tapauksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu garde la timeline réactive. L'export utilise Haute dans tous les cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima mantiene la timeline reattiva. L'esportazione usa Alta in ogni caso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プレビュー」はタイムラインの応答性を優先します。どちらを選んでも書き出しには「高」を使用します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsvisning håller tidslinjen responsiv. Export använder Hög oavsett."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览使时间线保持响应。无论哪种方式，High都用于导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預覽使時間軸保持響應。無論哪種方式，High都用於匯出。"
          }
        }
      }
    },
