    "Faded cool shadows, warm skin and a soft blue film palette." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verblasste kühle Schatten, warme Haut und eine weiche blaue Filmpalette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faded cool shadows, warm skin and a soft blue film palette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sombras frías desvanecidas, piel cálida y una suave paleta azul de película."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häivytettyjä viileitä varjoja, lämpimiä ihonsävyjä ja pehmeä sininen filmipaletti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombres froides estompées, peaux chaudes et palette argentique bleu doux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombre fredde sfumate, incarnati caldi e una morbida palette blu cinematografica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フェードした寒色のシャドウ、暖かい肌色、柔らかな青のフィルムパレット。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonade svala skuggor, varm hud och en mjuk blå filmpalett."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "褪色的冷影、温暖的皮肤和柔和的蓝色薄膜调色板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "褪色的冷影、溫暖的皮膚和柔和的藍色薄膜調色盤。"
          }
        }
      }
    },
