    "Runs at normal speed and accelerates away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft in Normalgeschwindigkeit und beschleunigt davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va a velocidad normal y acelera al final."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se juoksee normaalilla nopeudella ja kiihtyy pois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance à vitesse normale puis accélère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procede a velocità normale e poi accelera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går i normal hastighet och accelererar bort."
          }
        }
      }
    },
    "Rushes in, drops into slow motion, and settles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rauscht heran, fällt in Zeitlupe und beruhigt sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra a toda velocidad, cae en cámara lenta y se estabiliza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ryntää sisään, putoaa hidasteeseen ja asettuu aloilleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre à toute vitesse, bascule en ralenti, puis se stabilise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra di slancio, scende al rallentatore e si assesta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rusar in, faller ner i slow motion och lugnar sig."
          }
        }
      }
    },
