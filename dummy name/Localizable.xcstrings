    "Dolby Vision is not supported. Its dynamic metadata cannot be carried through grading, and GradeLab will not attach stale metadata to graded frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolby Vision wird nicht unterstützt. Die dynamischen Metadaten lassen sich nicht durch das Grading tragen, und GradeLab hängt keine veralteten Metadaten an gegradete Frames."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolby Vision no es compatible. Sus metadatos dinámicos no pueden atravesar el etalonaje, y GradeLab no va a adjuntar metadatos caducados a fotogramas etalonados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Dolby Vision n'est pas pris en charge. Ses métadonnées dynamiques ne peuvent pas traverser l'étalonnage, et GradeLab n'attachera pas de métadonnées périmées à des images étalonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolby Vision non è supportato. I suoi metadati dinamici non possono attraversare il grading, e GradeLab non allegherà metadati obsoleti a fotogrammi con grading applicato."
          }
        }
      }
    },
