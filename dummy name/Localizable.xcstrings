        }
      }
    },
    "Tap the picture to pick a colour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Bild, um eine Farbe auszuwählen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la imagen para tomar un color"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'image pour prélever une couleur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l'immagine per prelevare un colore"
          }
        }
      }
    },
    "Tap to delete this one keyframe. Other properties are untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um genau diesen Keyframe zu löschen. Andere Eigenschaften bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para eliminar solo este fotograma clave. Las demás propiedades no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour supprimer cette seule image clé. Les autres propriétés ne sont pas touchées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per eliminare solo questo fotogramma chiave. Le altre proprietà non vengono toccate."
          }
        }
      }
    },
    "Tapping a preset replaces the current grade. You can keep editing afterwards, and the preset stays as it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen auf ein Preset ersetzt das aktuelle Grading. Du kannst danach weiter bearbeiten, und das Preset bleibt so, wie es gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar un preajuste sustituye el etalonaje actual. Puedes seguir editando después, y el preajuste se queda tal y como se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher un préréglage remplace l'étalonnage actuel. Vous pouvez continuer à modifier ensuite, et le préréglage reste tel qu'il a été enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccare un preset sostituisce il grading attuale. Puoi continuare a modificare dopo, e il preset resta come è stato salvato."
          }
        }
      }
    },
    "Temperature" : {
