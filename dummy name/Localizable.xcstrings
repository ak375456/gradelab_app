    "The timeline and preview use this frame rate. A 60 fps clip on a 30 fps canvas plays at normal speed with fewer frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeline und Vorschau verwenden diese Bildrate. Ein 60-fps-Clip auf einer 30-fps-Arbeitsfläche läuft in normalem Tempo mit weniger Frames."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea de tiempo y la previsualización usan esta frecuencia de fotogramas. Un clip a 60 fps en un lienzo a 30 fps se reproduce a velocidad normal con menos fotogramas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aikajanassa ja esikatselussa käytetään tätä kuvanopeutta. 30 fps:n kankaalla oleva 60 fps:n klipsi pelaa normaalilla nopeudella harvemmilla karmeilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La timeline et l'aperçu utilisent cette fréquence d'images. Un plan à 60 ips sur un canevas à 30 ips est lu à vitesse normale avec moins d'images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La timeline e l'anteprima usano questa frequenza fotogrammi. Un clip a 60 fps su un canvas a 30 fps viene riprodotto a velocità normale con meno fotogrammi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインとプレビューには、このフレームレートを使用します。60 fpsのクリップを30 fpsのキャンバスに置くと、フレームを間引いて通常速度で再生します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidslinjen och förhandsvisningen använder den här bildfrekvensen. Ett klipp i 60 fps på en arbetsyta i 30 fps spelas i normal hastighet med färre bildrutor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间线和预览使用此帧率。30 fps画布上的60 fps片段以正常速度播放，帧数更少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間軸和預覽使用此影格率。30 fps畫布上的60 fps片段以正常速度播放，影格數更少。"
          }
        }
      }
    },
