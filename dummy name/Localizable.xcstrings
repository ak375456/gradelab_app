          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido dividir el clip en el cabezal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leikkiä ei voitu jakaa toistokohta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip n’a pas pu être scindé à la tête de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
