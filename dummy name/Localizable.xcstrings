        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso guarda el valor que se ve ahora mismo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se säästää arvoa, jonka näet juuri nyt."
          }
