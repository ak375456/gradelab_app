    "Green channel. Raising adds green; lowering leans magenta." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grünkanal. Anheben fügt Grün hinzu; Absenken neigt zu Magenta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal verde. Subirlo añade verde; bajarlo tira hacia el magenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vihreä kanava. Nousu lisää viheriötä, laskeminen magentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal vert. Monter ajoute du vert ; descendre tire vers le magenta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canale verde. Alzarlo aggiunge verde; abbassarlo tende al magenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑チャンネル。上げると緑が増え、下げるとマゼンタに近づきます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grön kanal. Höj för mer grönt; sänk för att luta mot magenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿色频道。提高增加绿色；降低倾向于洋红色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綠色頻道。提高增加綠色；降低傾向於洋紅色。"
          }
        }
      }
    },
