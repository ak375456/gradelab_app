    "You already have Pro. Use Manage Subscription to review your plan." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにProをご利用中です。「サブスクリプションを管理」でプランをご確認ください。"
