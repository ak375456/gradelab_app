          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Abgleich bearbeitet. Das Bewegen von Stärke baut vom Abgleich neu auf und verwirft diese Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editado desde el ajuste. Mover Intensidad reconstruye a partir del ajuste y descarta esas ediciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving Strength rakentaa ottelusta uudelleen ja hylkää muokkaukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifié depuis la correspondance. Déplacer Intensité reconstruit à partir de la correspondance et abandonne ces modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificato dall'abbinamento. Muovere Intensità ricostruisce dall'abbinamento e scarta quelle modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッチ後に編集されています。「強さ」を変更するとマッチ結果から再構築され、その後の編集は失われます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrad sedan matchningen. Att flytta Styrka bygger om från matchningen och kastar de ändringarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配后已编辑。移动强度从比赛中重建，并丢弃这些编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配後已編輯。移動強度從比賽中重建，並丟棄這些編輯。"
          }
        }
      }
    },
    "Edited timelines render on the canvas frame grid. Source files remain unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitete Timelines werden auf dem Bildraster der Arbeitsfläche gerendert. Die Quelldateien bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas de tiempo editadas se renderizan en la rejilla de fotogramas del lienzo. Los archivos de origen no se modifican."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muokatut aikajanat renderöivät kankaalle runkoruudukon. Lähdetiedostot pysyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les timelines modifiées sont rendues sur la grille d'images du canevas. Les fichiers source restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le timeline modificate vengono renderizzate sulla griglia di fotogrammi del canvas. I file sorgente restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集したタイムラインはキャンバスのフレーム間隔でレンダリングします。ソースファイルは変更されません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigerade tidslinjer renderas på arbetsytans bildrutenät. Källfilerna förblir oförändrade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑的时间线在画布帧网格上呈现。源文件保持不变。"
