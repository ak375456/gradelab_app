    },
    "A decoded source frame was unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein dekodierter Quellframe war nicht verfügbar."
          }
        }
      }
    },
    "A double tap on an animated property resets its value at the playhead. Use Reset in the property's Animation menu to clear its keyframes as well." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Doppeltippen auf eine animierte Eigenschaft setzt ihren Wert am Abspielkopf zurück. Verwende „Zurücksetzen“ im Animationsmenü der Eigenschaft, um auch ihre Keyframes zu löschen."
          }
        }
      }
    },
    "A file already exists at the selected export destination." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am gewählten Exportziel existiert bereits eine Datei."
          }
        }
      }
    },
    "A gradient replaces the flat text color. Stroke, background, shadow and glow keep their own colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verlauf ersetzt die einfarbige Textfarbe. Kontur, Hintergrund, Schatten und Glow behalten ihre eigenen Farben."
          }
        }
      }
    },
    "A keyframe is here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier liegt ein Keyframe"
          }
        }
      }
    },
    "A keyframe pins a value to one moment" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Keyframe heftet einen Wert an einen Moment"
          }
        }
      }
    },
    "A multichannel source audio track has no channel layout and cannot be preserved safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine mehrkanalige Quell-Audiospur hat kein Kanal-Layout und kann nicht sicher erhalten werden."
