          }
        }
      }
    },
    "Choose a color, then change its hue, saturation, or lightness. Try reducing blue lightness for a deeper sky. Nearby colors blend smoothly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Farbe und ändere dann ihren Farbton, ihre Sättigung oder ihre Helligkeit. Versuche, die Helligkeit von Blau zu senken, für einen tieferen Himmel. Benachbarte Farben gehen weich ineinander über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un color y luego cambia su tono, su saturación o su luminosidad. Prueba a reducir la luminosidad del azul para un cielo más denso. Los colores cercanos se funden con suavidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse väri, muuta värisävyä, värikylläisyyttä tai vaaleutta. Yritä vähentää sinistä vaaleutta syvemmälle taivaalle. Lähivärit sekoittuvat sulavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une couleur, puis modifiez sa teinte, sa saturation ou sa luminosité. Essayez de réduire la luminosité du bleu pour un ciel plus dense. Les couleurs voisines se fondent en douceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un colore, poi modificane tonalità, saturazione o luminosità. Prova a ridurre la luminosità del blu per un cielo più intenso. I colori vicini si fondono in modo morbido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色を選び、色相、彩度、明度を調整します。青の明度を下げると、空の色が深まります。近い色は滑らかにつながります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en färg och ändra sedan dess nyans, mättnad eller ljushet. Prova att minska blåets ljushet för en djupare himmel. Närliggande färger övergår mjukt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种颜色，然后更改其色调、饱和度或亮度。尝试减少蓝光度，以获得更深的天空。附近的颜色流畅地融合在一起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一種顏色，然後更改其色調、飽和度或亮度。嘗試減少藍光度，以獲得更深的天空。附近的顏色流暢地融合在一起。"
          }
        }
      }
    },
    "Choose a delivery size and frame rate below. The canvas layout stays the same." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle unten eine Ausgabegröße und Bildrate. Das Layout der Arbeitsfläche bleibt gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige abajo un tamaño de entrega y una frecuencia de fotogramas. La disposición del lienzo no cambia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse toimituskoko ja kuvanopeus alla. Kansio pysyy samana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ci-dessous une taille de livraison et une fréquence d'images. La disposition du canevas reste la même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli sotto una dimensione di consegna e una frequenza fotogrammi. La disposizione del canvas resta la stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下で書き出しサイズとフレームレートを選択してください。キャンバスの配置は維持されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj leveransstorlek och bildfrekvens nedan. Arbetsytans layout förblir densamma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下面选择一个交付大小和帧率。画布布局保持不变。"
