    "Guides help you compose. They never crop the recording. Exposure aids measure the displayed look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfslinien unterstützen die Bildgestaltung, ohne die Aufnahme zuzuschneiden. Belichtungshilfen messen den angezeigten Look."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guides help you compose. They never crop the recording. Exposure aids measure the displayed look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las guías ayudan a componer sin recortar la grabación. Las ayudas de exposición miden el look mostrado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apuviivat auttavat sommittelussa eivätkä rajaa tallennetta. Valotusavut mittaavat näytettävää tyyliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les repères aident à composer sans recadrer l’enregistrement. Les aides à l’exposition mesurent le look affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guide aiutano a comporre senza ritagliare la registrazione. Gli assistenti esposizione misurano il look visualizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガイドは構図の調整を助け、録画を切り取りません。露出アシストは表示中のルックを測定します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guider hjälper dig komponera utan att beskära inspelningen. Exponeringshjälpen mäter den visade looken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参考线帮助构图，不会裁切录制画面。曝光辅助工具测量的是当前显示的风格画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "參考線幫助構圖，不會裁切錄製畫面。曝光輔助工具測量的是當前顯示的風格畫面。"
          }
        }
      }
    },
