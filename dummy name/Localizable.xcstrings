    "Tap a duration value to enter exact seconds in any display format." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe bei jedem Anzeigeformat auf einen Zeitwert, um die genaue Sekundenzahl einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un valor de duración para introducir los segundos exactos en cualquier formato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kestoarvoa syöttääksesi tarkan ajan sekunteina missä tahansa näyttömuodossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une durée pour saisir les secondes exactes, quel que soit le format d’affichage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un valore di durata per inserire i secondi esatti in qualsiasi formato di visualizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの表示形式でも、長さの値をタップすると秒単位で正確に入力できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ett tidsvärde för att ange exakta sekunder oavsett visningsformat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
