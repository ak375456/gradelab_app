    "Red channel. Raising adds red; lowering leans cyan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotkanal. Anheben fügt Rot hinzu; Absenken neigt zu Cyan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal rojo. Subirlo añade rojo; bajarlo tira hacia el cian."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Punaista kanavaa. Nousu lisää punaista, laiha syaani laskee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal rouge. Monter ajoute du rouge ; descendre tire vers le cyan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canale rosso. Alzarlo aggiunge rosso; abbassarlo tende al ciano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Röd kanal. Höj för mer rött; sänk för att luta mot cyan."
          }
        }
      }
    },
    "Red, green and blue levels against horizontal image position" : {
      "localizations" : {
