    "Each source frame is held. Fastest, and the only honest choice for fast motion." : {
      "comment" : "Description of how frames are interpolated when using \"Sampling\" as the interpolation method.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Quell-Frame wird gehalten. Am schnellsten und die einzige ehrliche Wahl für schnelle Bewegung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fotograma de origen se mantiene. Lo más rápido y la única opción honesta para el movimiento rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jokainen lähdekehys on nopein ja ainoa rehellinen valinta nopeaan liikkumiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image source est maintenue. Le plus rapide, et le seul choix honnête pour un mouvement rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni fotogramma sorgente viene mantenuto. Il più rapido, e l'unica scelta onesta per il movimento veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ソースフレームを保持します。最も高速で、速い動きをそのまま表現するのに適しています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje källbildruta hålls kvar. Snabbast, och det enda ärliga valet vid snabb rörelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个源帧都被保留。最快，也是快速运动的唯一诚实选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個源影格都被保留。最快，也是快速運動的唯一誠實選擇。"
          }
        }
      }
    },
