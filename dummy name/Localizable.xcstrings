    "Analyzes this clip on your device. A fixed crop keeps the edges clean. Your original video and audio stay intact." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysiert diesen Clip auf deinem Gerät. Ein fester Beschnitt hält die Ränder sauber. Originalvideo und Ton bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyzes this clip on your device. A fixed crop keeps the edges clean. Your original video and audio stay intact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza el clip en tu dispositivo. Un recorte fijo mantiene los bordes limpios. El vídeo y audio originales se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysoi leikkeen laitteellasi. Kiinteä rajaus pitää reunat siisteinä. Alkuperäinen video ja ääni säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse ce clip sur votre appareil. Un recadrage fixe préserve les bords. La vidéo et l’audio d’origine restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza la clip sul dispositivo. Un ritaglio fisso mantiene i bordi puliti. Video e audio originali restano intatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上でクリップを解析します。固定クロップできれいな端を保ちます。元の動画と音声は保持されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyserar klippet på din enhet. En fast beskärning håller kanterna rena. Ursprunglig video och ljud bevaras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设备上分析此片段，采用固定裁切保持画面边缘整洁，原始视频和音频均保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在裝置上分析此片段，採用固定裁切保持畫面邊緣整潔，原始影片和音訊均保持不變。"
          }
        }
      }
    },
