    "Hue vs Hue" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色相対色相"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色相对色相"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色相對色相"
          }
        }
      }
    },
    "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat and Sat vs Luma — the curves that target one colour without touching the rest. Master, Red, Green and Blue stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat und Sat vs Luma — die Kurven, die eine Farbe treffen, ohne den Rest anzufassen. Master, Rot, Grün und Blau bleiben kostenlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat y Sat vs Luma: las curvas que actúan sobre un color sin tocar los demás. Master, Rojo, Verde y Azul siguen siendo gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hue vs Hue vs Hue vs Sat, Hue vs Luma, Luma vs Sat vs Sat ja Sat vs Luma – käyrät, jotka kohdistavat yhden värin koskematta muuhun. Master, Red, Green ja Blue pysyvät vapaina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat et Sat vs Luma — les courbes qui ciblent une couleur sans toucher aux autres. Master, Rouge, Vert et Bleu restent gratuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat e Sat vs Luma: le curve che agiscono su un colore senza toccare gli altri. Master, Rosso, Verde e Blu restano gratuiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色相対色相、色相対彩度、色相対輝度、輝度対彩度、彩度対彩度、彩度対輝度で、他の色を保ちながら特定の色を調整できます。マスター、赤、緑、青のカーブは無料です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat och Sat vs Luma — kurvorna som träffar en enda färg utan att röra resten. Master, Röd, Grön och Blå förblir gratis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat 和 Sat vs Luma — 针对一种颜色而不触及其余颜色的曲线。大师、红色、绿色和蓝色免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat 和 Sat vs Luma — 針對一種顏色而不觸及其餘顏色的曲線。大師、紅色、綠色和藍色免費。"
          }
        }
      }
    },
