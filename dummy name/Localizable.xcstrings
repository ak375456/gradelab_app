    "Higher bitrate uses more storage. Quality presets choose an average target automatically; actual file size varies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine höhere Bitrate braucht mehr Speicher. Qualitäts-Presets wählen automatisch einen Durchschnittswert; die tatsächliche Dateigröße variiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tasa de bits más alta ocupa más almacenamiento. Los preajustes de calidad eligen un objetivo medio automáticamente; el tamaño real del archivo varía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un débit plus élevé occupe plus de stockage. Les préréglages de qualité choisissent une cible moyenne automatiquement ; la taille réelle du fichier varie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bitrate più alto occupa più spazio. I preset di qualità scelgono automaticamente un obiettivo medio; la dimensione reale del file varia."
          }
        }
      }
    },
