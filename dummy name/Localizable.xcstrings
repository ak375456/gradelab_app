          "stringUnit" : {
            "state" : "translated",
            "value" : "輪郭が小さすぎます。対象全体を囲んでください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den konturen var för liten. Rita hela vägen runt objektet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那个轮廓太小了。绕着物体画一路。"
