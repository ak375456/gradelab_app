    "This project has only one clip, so there is nothing on the timeline to match to. Import a reference image instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt hat nur einen Clip, es gibt also auf der Timeline nichts, worauf abgeglichen werden könnte. Importiere stattdessen ein Referenzbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto solo tiene un clip, así que no hay nada en la línea de tiempo con lo que ajustar. Importa en su lugar una imagen de referencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tässä projektissa on vain yksi klippi, joten aikajanalla ei ole mitään sopivaa. Tuo sen sijaan viitekuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce projet n'a qu'un seul plan, il n'y a donc rien sur la timeline avec quoi faire correspondre. Importez plutôt une image de référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo progetto ha un solo clip, quindi non c'è nulla sulla timeline con cui abbinare. Importa invece un'immagine di riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトにはクリップが1つしかないため、タイムライン内の参照を選べません。代わりに参照画像を読み込んでください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här projektet har bara ett klipp, så det finns inget på tidslinjen att matcha mot. Importera en referensbild i stället."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个项目只有一个片段，所以时间线上没有任何东西可以匹配。改为导入参考图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個專案只有一個片段，所以時間軸上沒有任何東西可以匹配。改為匯入參考影象。"
          }
        }
      }
    },
    "This project is set to %@, but the source declares no Log profile. GradeLab does not apply the Apple Log transform to footage that does not identify itself as Log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt ist auf %@ eingestellt, die Quelle gibt aber kein Log-Profil an. GradeLab wendet die Apple-Log-Transformation nicht auf Material an, das sich nicht selbst als Log ausweist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto está configurado como %@, pero el origen no declara ningún perfil Log. GradeLab no aplica la transformación Apple Log a material que no se identifica como Log."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä projekti on asetettu %@, mutta lähde ei ilmoita Log-profiilia. GradeLab ei sovella Apple Log -muunnosta kuvamateriaaliin, joka ei tunnistaudu Logiksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce projet est réglé sur %@, mais la source ne déclare aucun profil Log. GradeLab n'applique pas la transformation Apple Log à des rushes qui ne s'identifient pas comme Log."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo progetto è impostato su %@, ma la sorgente non dichiara alcun profilo Log. GradeLab non applica la trasformazione Apple Log a girato che non si identifica come Log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトは%@に設定されていますが、ソースにLogプロファイルの指定がありません。GradeLabはLogと確認できない映像にApple Log変換を適用しません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här projektet är inställt på %@, men källan anger ingen Log-profil. GradeLab tillämpar inte Apple Log-transformen på material som inte identifierar sig som Log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目设为 %@，但源素材未标明 Log 配置。GradeLab 不会对未明确标记为 Log 的素材应用 Apple Log 转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此專案設為 %@，但源素材未標明 Log 配置。GradeLab 不會對未明確標記為 Log 的素材應用 Apple Log 轉換。"
          }
        }
      }
    },
    "This project is set to %@, but the source declares no matching Log profile. GradeLab does not infer Log from the picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt ist auf %@ eingestellt, die Quelle gibt aber kein passendes Log-Profil an. GradeLab leitet Log nicht aus dem Bild ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto está configurado como %@, pero el origen no declara ningún perfil Log que coincida. GradeLab no deduce el Log a partir de la imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä projekti on asetettu %@, mutta lähde ei ilmoita vastaavaa Log-profiilia. GradeLab ei kerro Log-profiilia kuvasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce projet est réglé sur %@, mais la source ne déclare aucun profil Log correspondant. GradeLab ne déduit pas le Log à partir de l'image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo progetto è impostato su %@, ma la sorgente non dichiara alcun profilo Log corrispondente. GradeLab non deduce il Log dall'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトは%@に設定されていますが、ソースに一致するLogプロファイルがありません。GradeLabは画像の見た目からLogを推測しません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här projektet är inställt på %@, men källan anger ingen matchande Log-profil. GradeLab sluter sig inte till Log utifrån bilden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目设为 %@，但源素材未标明匹配的 Log 配置。GradeLab 不会根据画面外观推断 Log 类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此專案設為 %@，但源素材未標明匹配的 Log 配置。GradeLab 不會根據畫面外觀推斷 Log 型別。"
          }
        }
      }
    },
    "This project uses %@. The frame counter rolls from %@ to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Projekt verwendet %1$@. Der Frame-Zähler wechselt von %2$@ zu %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proyecto usa %1$@. El contador de fotogramas pasa de %2$@ a %3$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä projekti käyttää taajuutta %1$@. Ruutulaskuri siirtyy arvosta %2$@ arvoon %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce projet utilise %1$@. Le compteur d’images passe de %2$@ à %3$@."
          }
        },
        "it" : {
