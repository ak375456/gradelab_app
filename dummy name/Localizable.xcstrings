    "Some frames could not be tracked confidently. Review cuts, blur and fast movement before exporting." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Bilder konnten nicht zuverlässig verfolgt werden. Prüfe Schnitte, Unschärfe und schnelle Bewegungen vor dem Export."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some frames could not be tracked confidently. Review cuts, blur and fast movement before exporting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron seguir algunos fotogramas con confianza. Revisa cortes, desenfoque y movimientos rápidos antes de exportar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin ruutuja ei voitu seurata luotettavasti. Tarkista leikkaukset, epäterävyys ja nopea liike ennen vientiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines images n’ont pas pu être suivies avec fiabilité. Vérifiez les coupes, le flou et les mouvements rapides avant l’exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni fotogrammi non sono stati tracciati con affidabilità. Controlla tagli, sfocatura e movimenti rapidi prima di esportare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のフレームを確実に追跡できませんでした。書き出す前にカット、ぼけ、速い動きを確認してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa bildrutor kunde inte följas tillförlitligt. Granska klipp, oskärpa och snabba rörelser före export."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分画面无法可靠跟踪。导出前请检查剪切点、模糊和快速运动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分畫面無法可靠追蹤。匯出前請檢查剪下點、模糊和快速運動。"
          }
        }
      }
    },
