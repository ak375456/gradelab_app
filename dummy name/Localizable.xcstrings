          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define un valor en dos instantes distintos y la propiedad se moverá suavemente entre ambos. La animación aquí no es más que eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez une valeur à deux instants différents et la propriété passe doucement de l'une à l'autre. L'animation n'est rien d'autre que cela ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
