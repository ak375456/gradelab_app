    "Requires a supported 8-bit SDR source and a compatible hardware encoder. Try a smaller size or another codec." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert eine unterstützte 8-Bit-SDR-Quelle und einen kompatiblen Hardware-Encoder. Versuche eine kleinere Größe oder einen anderen Codec."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere un origen SDR de 8 bits compatible y un codificador por hardware compatible. Prueba con un tamaño menor u otro códec."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaatii tuetun 8-bittisen SDR-lähteen ja yhteensopivan laitteiston koodaajan. Kokeile pienempää kokoa tai toista koodekia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige une source SDR 8 bits prise en charge et un encodeur matériel compatible. Essayez une taille plus petite ou un autre codec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede una sorgente SDR a 8 bit supportata e un encoder hardware compatibile. Prova una dimensione più piccola o un altro codec."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応する8ビットSDRソースとハードウェアエンコーダーが必要です。サイズを小さくするか、別のコーデックをお試しください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver en 8-bitars SDR-källa som stöds och en kompatibel hårdvarukodare. Prova en mindre storlek eller en annan codec."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要受支持的8位SDR源和兼容的硬件编码器。尝试较小的尺寸或其他编解码器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要受支援的8 位元SDR源和相容的硬體編碼器。嘗試較小的尺寸或其他編解碼器。"
          }
        }
      }
    },
