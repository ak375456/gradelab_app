    "The window and its own colour adjustments are removed. The clip's main grade is untouched, and Undo brings the mask back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster und seine eigenen Farbanpassungen werden entfernt. Das Haupt-Grading des Clips bleibt unberührt, und Widerrufen holt die Maske zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana y sus propios ajustes de color se eliminan. El etalonaje principal del clip no se toca, y Deshacer recupera la máscara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre et ses propres réglages de couleur sont retirés. L'étalonnage principal du clip n'est pas touché, et Annuler ramène le masque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra e le sue regolazioni di colore vengono rimosse. Il grading principale della clip non viene toccato, e Annulla riporta indietro la maschera."
          }
        }
      }
    },
    "There are keyframes elsewhere. Tap to add one at the playhead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An anderer Stelle gibt es Keyframes. Tippe, um hier am Abspielkopf einen hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay fotogramas clave en otros puntos. Toca para añadir uno en el cabezal."
