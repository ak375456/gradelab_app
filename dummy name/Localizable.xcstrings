    "This clip is too long for one stabilization pass. Split it into shorter clips and analyze each one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Clip ist zu lang für einen Stabilisierungsdurchlauf. Teile ihn in kürzere Clips und analysiere sie einzeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clip is too long for one stabilization pass. Split it into shorter clips and analyze each one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clip es demasiado largo para una pasada de estabilización. Divídelo en clips más cortos y analiza cada uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leike on liian pitkä yhteen vakautusanalyysiin. Jaa se lyhyempiin leikkeisiin ja analysoi ne erikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce clip est trop long pour une seule analyse. Divisez-le en clips plus courts et analysez chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clip è troppo lunga per una sola analisi. Dividila in clip più brevi e analizzale singolarmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の解析にはクリップが長すぎます。短いクリップに分割し、それぞれ解析してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippet är för långt för en stabiliseringsanalys. Dela upp det i kortare klipp och analysera dem var för sig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此片段超出单次防抖分析的时长限制。请分割为较短片段后分别分析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此片段超出單次防手震分析的時長限制。請分割為較短片段後分別分析。"
          }
        }
      }
    },
    "This clip is too short for both, so they have been scaled to %.2fs in and %.2fs out." : {
      "comment" : "A warning message that appears when the duration of the in- and out-animation of a text clip is too short to allow for a smooth transition.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Clip ist für beide zu kurz, daher wurden sie auf %1$.2f s ein und %2$.2f s aus angepasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This clip is too short for both, so they have been scaled to %1$.2fs in and %2$.2fs out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este clip es demasiado corto para las dos, así que se han ajustado a %1$.2f s de entrada y %2$.2f s de salida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä leike on liian lyhyt molemmille, joten ne on sovitettu: %1$.2f s sisään ja %2$.2f s ulos."
          }
        },
        "fr" : {
