    "This device does not have the memory to hold several frames of this project at once. Spatial reduction is still available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat nicht den Speicher, um mehrere Frames dieses Projekts gleichzeitig zu halten. Die räumliche Reduzierung bleibt verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
