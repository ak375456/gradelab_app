    "Your original recording is safe in GradeLab. Retry opening it or share the original from Home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Originalaufnahme ist in GradeLab sicher. Versuche erneut, sie zu öffnen, oder teile das Original von der Startseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your original recording is safe in GradeLab. Retry opening it or share the original from Home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu grabación original está a salvo en GradeLab. Intenta abrirla de nuevo o comparte el original desde Inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkuperäinen tallenne on turvassa GradeLabissa. Yritä avata se uudelleen tai jaa alkuperäinen aloitusnäytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre enregistrement original est en sécurité dans GradeLab. Réessayez de l’ouvrir ou partagez l’original depuis l’accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione originale è al sicuro in GradeLab. Riprova ad aprirla o condividi l’originale da Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の録画はGradeLabに保管されています。もう一度開くか、ホームからオリジナルを共有してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din originalinspelning är säker i GradeLab. Försök öppna den igen eller dela originalet från Hem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始录制文件已保存在 GradeLab 中。请重新尝试打开，或从首页分享原始文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始錄製檔案已儲存在 GradeLab 中。請重新嘗試開啟，或從首頁分享原始檔案。"
          }
        }
      }
    },
    "Your originals are kept here until a project is saved." : {
