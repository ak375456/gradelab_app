    "Finishing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird abgeschlossen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalizando"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viimeistely"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalisation"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalizzazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕上げ"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutför"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质感"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質感"
          }
        }
      }
    },
    "Finishing effects. Fade lifts the blacks toward a matte print. Sharpen adds edge detail. Bloom, glow and halation spread light out of bright areas — halation is the red halo film gets. Grain is strongest through the midtones, as film is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finishing-Effekte. Fade hebt das Schwarz in Richtung eines matten Prints an. Schärfen fügt Kantendetails hinzu. Bloom, Glow und Halation streuen Licht aus hellen Bereichen – Halation ist der rote Lichthof, den Film bekommt. Das Korn ist in den Mitteltönen am stärksten, wie bei Film."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efectos de acabado. Fade levanta los negros hacia una copia mate. La nitidez añade detalle en los bordes. Bloom, glow y halation esparcen la luz fuera de las zonas claras: la halation es el halo rojo que produce la película. El grano es más fuerte en los tonos medios, como en la película."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viimeistelytehosteet. Fade nostaa mustat kohti mattaprinttiä. Sharpen lisää reunaan yksityiskohtia. Bloom, hohto ja halaatio levittävät valoa kirkkailta alueilta – halaatio on punainen halofilmi. Vilja on voimakkainta keskisävyjen läpi, kuten elokuva on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effets de finition. Fade relève les noirs vers un tirage mat. La netteté ajoute du détail sur les contours. Bloom, glow et halation diffusent la lumière hors des zones claires — la halation est le halo rouge qu’obtient la pellicule. Le grain est le plus marqué dans les tons moyens, comme sur la pellicule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effetti di finitura. Fade solleva i neri verso una stampa opaca. La nitidezza aggiunge dettaglio sui bordi. Bloom, glow e halation diffondono la luce fuori dalle aree luminose — la halation è l’alone rosso tipico della pellicola. La grana è più intensa nei mezzitoni, come nella pellicola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕上げのエフェクト。「フェード」は黒を持ち上げてマットな質感に、「シャープ」は輪郭を鮮明にします。ブルーム、グロー、ハレーションは明るい部分から光をにじませます。ハレーションはフィルム特有の赤い光輪です。粒子はフィルムのように中間調で最も強く現れます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutande effekter. Fade lyfter svärtan mot en matt kopia. Skärpa lägger till kantdetalj. Bloom, glow och halation sprider ljus ut från ljusa partier — halation är den röda glorian som film får. Kornet är starkast genom mellantonerna, som hos film."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为画面添加质感。褪色抬高黑位，营造哑光印片效果；锐化增强边缘细节。泛光、辉光和光晕让高光向周围扩散，其中光晕模拟胶片常见的红色晕染。颗粒在中间调最明显，接近胶片表现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為畫面新增質感。褪色抬高黑位，營造霧面印片效果；銳利化增強邊緣細節。泛光、輝光和光暈讓亮部向周圍擴散，其中光暈模擬底片常見的紅色暈染。顆粒在中間調最明顯，接近底片表現。"
          }
        }
      }
    },
    "Finishing the recording took too long. Captured footage has been kept for recovery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abschließen der Aufnahme dauerte zu lange. Aufgenommenes Material bleibt zur Wiederherstellung erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finishing the recording took too long. Captured footage has been kept for recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalizar la grabación tardó demasiado. El material capturado se conserva para su recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennuksen viimeistely kesti liian kauan. Kuvattu materiaali säilytetään palautusta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finalisation a pris trop de temps. Les images capturées sont conservées pour récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il completamento ha richiesto troppo tempo. Il filmato acquisito è stato conservato per il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画の終了処理に時間がかかりすぎました。撮影済みの映像は復旧用に保管されています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tog för lång tid att slutföra inspelningen. Materialet har behållits för återställning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成录制处理超时。已保留录到的素材，可尝试恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成錄製處理超時。已保留錄到的素材，可嘗試恢復。"
          }
        }
      }
    },
