    "Swipe animation: keyframe Position X, move the playhead, then drag the line across the picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe-Animation: Setze einen Keyframe auf Position X, bewege den Abspielkopf und zieh dann die Linie über das Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animación de barrido: pon un fotograma clave en Posición X, mueve el cabezal y arrastra la línea a través de la imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pyyhkäise animaatio: avainkuva sijainti X, liikuta toistokohta ja vedä viiva kuvan yli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animation de balayage : posez une image clé sur Position X, déplacez la tête de lecture, puis faites glisser la ligne à travers l'image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animazione a scorrimento: metti un fotogramma chiave su Posizione X, sposta la testina, poi trascina la linea attraverso l'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプのアニメーション：X位置にキーフレームを設定し、再生ヘッドを移動してから線を画像の反対側へドラッグします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svepanimering: sätt en keyframe på Position X, flytta uppspelningshuvudet och dra sedan linjen över bilden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动动画：关键帧位置 X，移动播放头，然后将线条拖过图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動動畫：關鍵影格位置 X，移動播放頭，然後將線條拖過圖片。"
          }
        }
      }
    },
    "Swipe up or down to adjust. Use the Reset action to return to neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streich nach oben oder unten, um anzupassen. Mit „Zurücksetzen“ geht es zurück auf neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo para ajustar. Usa la acción Restablecer para volver a neutro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pyyhi ylös tai alas säätääksesi. Käytä Reset-toimintoa palataksesi neutraaliksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou vers le bas pour ajuster. Utilisez l'action Réinitialiser pour revenir au neutre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto o verso il basso per regolare. Usa l'azione Reimposta per tornare al neutro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下にスワイプして調整します。「リセット」でニュートラルに戻せます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt eller nedåt för att justera. Använd Återställ för att gå tillbaka till neutral."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上或向下滑动以进行调整。使用“重置”操作返回至中性状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上或向下滑動以進行調整。使用「重置」操作返回至中性狀態。"
          }
        }
      }
    },
    "Swipe up or down to seek one second. Pinch to zoom. Hold a clip and drag sideways to move it or vertically to move it to another layer." : {
      "comment" : "Accessibility label for the timeline canvas.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche nach oben oder unten, um eine Sekunde zu springen. Ziehe zum Zoomen auf. Halte einen Clip und ziehe ihn seitwärts, um ihn zu verschieben, oder vertikal, um ihn auf eine andere Ebene zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo para avanzar un segundo. Pellizca para hacer zoom. Mantén pulsado un clip y arrástralo en horizontal para moverlo, o en vertical para llevarlo a otra capa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pyyhkäise ylös tai alas, jotta voit hakea yhden sekunnin. Tähystä zoomaamaan. Pitele klippiä ja vedä sivuttain siirtääksesi sitä tai pystysuunnassa siirtääksesi sen toiseen kerrokseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas pour vous déplacer d’une seconde. Pincez pour zoomer. Maintenez un clip et faites-le glisser latéralement pour le déplacer, ou verticalement pour le faire changer de calque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l’alto o il basso per spostarti di un secondo. Pizzica per fare zoom. Tieni premuta una clip e trascinala lateralmente per spostarla, o verticalmente per portarla su un altro livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下のスワイプで1秒移動、ピンチでズームします。クリップを長押しして横にドラッグすると移動、縦にドラッグすると別レイヤーへ移せます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt eller nedåt för att söka en sekund. Knip för att zooma. Håll på ett klipp och dra i sidled för att flytta det, eller vertikalt för att flytta det till ett annat lager."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上或向下滑动以寻找一秒钟。捏紧缩放。握住片段并横向拖动以移动它，或垂直拖动以将其移动到另一个图层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上或向下滑動以尋找一秒鐘。捏緊縮放。握住片段並橫向拖動以移動它，或垂直拖動以將其移動到另一個圖層。"
          }
        }
      }
    },
