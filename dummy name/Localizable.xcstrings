    "Blue channel. Raising adds blue; lowering leans yellow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blaukanal. Anheben fügt Blau hinzu; Absenken neigt zu Gelb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal azul. Subirlo añade azul; bajarlo tira hacia el amarillo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sininen kanava. Nousu lisää sinistä, laskeminen on keltaista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal bleu. Monter ajoute du bleu ; descendre tire vers le jaune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canale blu. Alzarlo aggiunge blu; abbassarlo tende al giallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青チャンネル。上げると青が増え、下げると黄色に近づきます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blå kanal. Höj för mer blått; sänk för att luta mot gult."
