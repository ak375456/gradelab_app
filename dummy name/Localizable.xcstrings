    "Subtle skin-tone shaping with restrained color for portraits." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色を抑えながら肌の色調を繊細に整える、ポートレート向けのルック。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微妙的肤色塑造与肖像的克制色彩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微妙的膚色塑造與肖像的剋制色彩。"
          }
        }
      }
    },
    "Sunset warmth with amber highlights and turquoise blues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnenuntergangswärme mit bernsteinfarbenen Lichtern und Türkisblau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunset warmth with amber highlights and turquoise blues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calidez de atardecer con luces ámbar y azules turquesa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auringonlaskun lämpöä, meripihkan sävyisiä huippuvaloja ja turkoosia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaleur du couchant, hautes lumières ambrées et bleus turquoise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calore del tramonto con alte luci ambrate e blu turchesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕焼けの暖かさに、琥珀色のハイライトとターコイズブルーを添えます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
