    "Elevation 90° is light from the camera, 0° is pure side light, and below zero it comes from behind the subject." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 90° Höhe kommt das Licht aus Richtung der Kamera, bei 0° ist es reines Seitenlicht, unter null kommt es von hinter dem Motiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una elevación de 90° es luz desde la cámara, 0° es luz lateral pura y por debajo de cero llega desde detrás del sujeto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Korkeus 90° on valoa kameran suunnasta, 0° on puhdasta sivuvaloa ja nollan alapuolella valo tulee kohteen takaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une élévation de 90° éclaire depuis la caméra, 0° est une lumière purement latérale, et en dessous de zéro elle vient de derrière le sujet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’elevazione di 90° è luce dalla fotocamera, 0° è luce puramente laterale e sotto lo zero arriva da dietro il soggetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仰角90°はカメラ方向、0°は真横からの光です。マイナスにすると被写体の背後から照らします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höjd 90° är ljus från kameran, 0° är rent sidoljus och under noll kommer det bakifrån motivet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度90°是来自相机的光，0°是纯侧光，零以下是来自主体后面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度90°是來自相機的光，0°是純側光，零以下是來自主體後面。"
          }
        }
      }
    },
