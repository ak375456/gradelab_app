    "Bounce" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebote"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebond"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimbalzo"
          }
        }
      }
    },
    "Bright areas bleed into what surrounds them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle Bereiche laufen in ihre Umgebung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las zonas luminosas se derraman sobre lo que las rodea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones lumineuses débordent sur ce qui les entoure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le zone luminose sbordano su ciò che le circonda."
          }
        }
      }
    },
    "Brightness by saturation. Lowering the right darkens the most colorful areas and leaves neutrals alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit nach Sättigung. Die rechte Seite abzusenken dunkelt die farbigsten Bereiche ab und lässt Neutraltöne unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillo según la saturación. Bajar la derecha oscurece las zonas más coloridas y deja intactos los neutros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité en fonction de la saturation. Baisser la droite assombrit les zones les plus colorées et laisse les neutres intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità in base alla saturazione. Abbassare la destra scurisce le aree più colorate e lascia intatti i neutri."
          }
        }
      }
    },
    "Brightness of one color. Pick a hue, then drag down to darken it — a deeper sky, for instance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeit einer einzelnen Farbe. Wähle einen Farbton und zieh nach unten, um ihn abzudunkeln — für einen tieferen Himmel zum Beispiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillo de un solo color. Elige un tono y arrastra hacia abajo para oscurecerlo: un cielo más profundo, por ejemplo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité d'une seule couleur. Choisissez une teinte, puis faites glisser vers le bas pour l'assombrir — un ciel plus profond, par exemple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità di un singolo colore. Scegli una tonalità, poi trascina verso il basso per scurirla: un cielo più profondo, per esempio."
          }
        }
      }
    },
    "Bring your own typography." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deine eigene Typografie mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae tu propia tipografía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apportez votre propre typographie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta la tua tipografia."
          }
        }
      }
    },
    "Bring your signature look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deinen eigenen Look mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae tu look característico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apportez votre look signature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta il tuo look distintivo."
          }
        }
      }
    },
    "Built for %@ footage. Applied before the other tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@-Material gebaut. Wird vor den anderen Werkzeugen angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensado para material %@. Se aplica antes que las demás herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu pour les rushes %@. Appliqué avant les autres outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensato per il girato %@. Applicato prima degli altri strumenti."
          }
        }
      }
    },
    "Built into GradeLab" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In GradeLab integriert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrado en GradeLab"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégré à GradeLab"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrato in GradeLab"
          }
        }
      }
    },
    "Buy now and it stays yours forever, whatever the price becomes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauf jetzt, und er bleibt für immer deiner — ganz gleich, wie sich der Preis entwickelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómpralo ahora y será tuyo para siempre, sea cual sea el precio después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
