    "Angle follows frame rate. Flicker presets lock exposure to whole lighting cycles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Winkel folgt der Bildrate. Flimmer-Vorgaben sperren die Belichtung auf vollständige Lichtzyklen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angle follows frame rate. Flicker presets lock exposure to whole lighting cycles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ángulo sigue la frecuencia de fotogramas. Los ajustes antiparpadeo fijan la exposición a ciclos completos de iluminación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulma seuraa kuvataajuutta. Välkynnän esiasetukset lukitsevat valotuksen kokonaisiin valojaksoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’angle suit la fréquence d’images. Les préréglages anti-scintillement verrouillent l’exposition sur des cycles lumineux complets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’angolo segue la frequenza dei fotogrammi. I preset antisfarfallio bloccano l’esposizione su cicli luminosi completi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アングルはフレームレートに追従します。フリッカー低減のプリセットは照明の周期に合わせて露出を固定します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinkeln följer bildfrekvensen. Flimmerförval låser exponeringen till hela ljuscykler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角度跟随帧率。闪烁预设将曝光锁定到整个照明周期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角度跟隨影格率。閃爍預設將曝光鎖定到整個照明週期。"
          }
        }
      }
    },
