    "Trace around the object on the picture. The shape closes itself when you lift your finger." : {
      "comment" : "A description of how to use the lasso tool in the background removal panel.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahre im Bild um das Objekt herum. Die Form schließt sich selbst, wenn du den Finger hebst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traza alrededor del objeto en la imagen. La forma se cierra sola al levantar el dedo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jäljitä esine kuvan ympärille. Muoto sulkeutuu, kun nostat sormeasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracez autour de l’objet sur l’image. La forme se referme d’elle-même lorsque vous levez le doigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia attorno all’oggetto sull’immagine. La forma si chiude da sola quando sollevi il dito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ objektets kant på bilden. Formen sluts av sig själv när du lyfter fingret."
          }
        }
      }
    },
    "Trace around the object on the preview. The shape closes itself when you lift your finger." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahre in der Vorschau um das Objekt herum. Die Form schließt sich selbst, wenn du den Finger hebst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traza alrededor del objeto en la previsualización. La forma se cierra sola al levantar el dedo."
          }
        },
        "fi" : {
          "stringUnit" : {
