        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio estándar de por vida es de %@ US. Este precio es solo para la semana de lanzamiento, como agradecimiento a nuestros primeros usuarios. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
