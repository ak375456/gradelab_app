        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra formen för att flytta den, eller dess handtag för att ändra storlek, rotera och mjuka upp den."
          }
        }
      }
    },
    "Drag to compare. Every look in GradeLab is this one gesture away." : {
      "localizations" : {
