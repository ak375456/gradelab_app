    "Soft, slightly faded look with lifted blacks, muted colour and smooth highlights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weicher, leicht ausgeblichener Look mit angehobenen Schwarztönen, gedämpfter Farbe und sanften Lichtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look suave y ligeramente desvaído, con negros levantados, color apagado y altas luces suaves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pehmeä, hieman haalistunut ilme kohotetuilla mustilla, vaimealla värillä ja sileillä kohokohdilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look doux et légèrement délavé, avec des noirs remontés, des couleurs atténuées et des hautes lumières douces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look morbido e leggermente slavato, con neri alzati, colore smorzato e alte luci dolci."
