    "Builds from slow motion into speed." : {
      "comment" : "Description of a time remap preset that builds from slow motion into speed.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baut von Zeitlupe zu vollem Tempo auf."
