    "Removes manual and tracked position, size, rotation, corner radius, feather and strength keyframes. Keeps the current shape and all local grading animation. Undo restores the motion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt manuelle und getrackte Keyframes für Position, Größe, Drehung, Eckenradius, weiche Kante und Stärke. Die aktuelle Form und die gesamte lokale Grading-Animation bleiben erhalten. Widerrufen stellt die Bewegung wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita los fotogramas clave de posición, tamaño, rotación, radio de esquina, suavizado e intensidad, tanto manuales como obtenidos por seguimiento. Conserva la forma actual y toda la animación de etalonaje local. Deshacer recupera el movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire les images clés de position, taille, rotation, rayon d'angle, adoucissement et intensité, qu'elles soient manuelles ou issues du suivi. Conserve la forme actuelle et toute l'animation d'étalonnage local. Annuler rétablit le mouvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove i fotogrammi chiave di posizione, dimensione, rotazione, raggio degli angoli, sfumatura e intensità, sia manuali sia ottenuti dal tracciamento. Conserva la forma attuale e tutta l'animazione di grading locale. Annulla ripristina il movimento."
          }
        }
      }
    },
    "Removes the keyframe here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt den Keyframe hier"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el fotograma clave de aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire l'image clé ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove il fotogramma chiave qui"
          }
        }
      }
    },
