          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已經擁有Pro。使用「管理訂閱」來檢視您的計劃。"
          }
        }
      }
    },
    "You can switch between Compact and Classic anytime. Open the ••• menu at the top of the editor → %@ → iPhone Color workspace." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以随时在Compact和Classic之间切换。打开编辑器顶部的•••菜单→%@→iPhone颜色工作区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以隨時在Compact和Classic之間切換。開啟編輯器頂部的•••選單→%@→iPhone顏色工作區。"
          }
        }
      }
    },
    "You’re ready to create." : {
