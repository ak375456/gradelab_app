            "value" : "Toca puntos o arrastra alrededor del sujeto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napauta pisteitä tai vedä kohteen ympäri"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez des points ou tracez autour du sujet"
          }
        },
        "it" : {
