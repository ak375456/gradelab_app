    "Tracking could not lock onto this outline. Draw it around an object with visible detail, or around more of the subject." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tracking konnte diese Kontur nicht erfassen. Zeichne sie um ein Objekt mit sichtbaren Details oder um mehr vom Motiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rastreo no ha podido fijarse en este contorno. Dibújalo alrededor de un objeto con detalle visible o abarcando más del sujeto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seuraaminen ei voinut kiinnittyä tähän ääriviivaan. Piirrä se näkyvällä yksityiskohdalla varustetun esineen tai useamman kohteen ympärille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
