    },
    "Following clips move later by %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後続のクリップが%@遅くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后续片段将向后移动 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後續片段將向後移動 %@。"
          }
        }
      }
    },
    "Following clips on this track move with their embedded audio. On the main track, later text and overlays move too. Separate audio stays in place." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトラックの後続クリップは内蔵音声と一緒に移動します。メイントラックでは後続のテキストやオーバーレイも移動します。独立した音声は移動しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此轨道上的后续片段与嵌入的音频一起移动。在主轨道上，后面的文本和叠加层也会移动。单独的音频保持原位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此軌道上的後續片段與嵌入的音訊一起移動。在主軌道上，後面的文字和疊加層也會移動。單獨的音訊保持原位。"
          }
        }
      }
    },
