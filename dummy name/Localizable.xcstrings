    "Temperature balances warm and cool. Tint balances green and magenta. Vibrance gently boosts quieter colors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Temperatur gleicht warm und kühl aus. Die Tönung gleicht Grün und Magenta aus. Die Dynamik hebt zurückhaltende Farben sanft an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura equilibra el cálido y el frío. El matiz equilibra el verde y el magenta. Vibrance realza suavemente los colores más apagados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lämpötila tasapainottaa lämmintä ja viileää. Tint tasapainottaa vihreää ja magentaa. Vibrence lisää hellävaraisesti hiljaisempia värejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La température équilibre le chaud et le froid. La nuance équilibre le vert et le magenta. La vibrance renforce doucement les couleurs les plus discrètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura bilancia caldo e freddo. La tinta bilancia verde e magenta. La vividezza esalta delicatamente i colori più spenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色温度は暖色と寒色、色かぶりは緑とマゼンタのバランスを調整します。「自然な彩度」は落ち着いた色を穏やかに鮮やかにします。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatur balanserar varmt och kallt. Färgton balanserar grönt och magenta. Lyster lyfter försiktigt de tystare färgerna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度平衡温暖和凉爽。色调平衡了绿色和洋红色。活力温和地提升了更安静的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫度平衡溫暖和涼爽。色調平衡了綠色和洋紅色。活力溫和地提升了更安靜的顏色。"
          }
        }
      }
    },
