        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フリーハンドマスクには3つ以上のポイントが必要です。被写体の周囲をタップして描いてください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En frihandsmask behöver minst tre punkter. Tryck runt motivet för att rita en."
