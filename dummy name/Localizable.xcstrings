    "Position and size animation will be replaced only over successfully tracked frames. Rotation, feather, strength and local grading are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positions- und Größenanimation werden nur über erfolgreich getrackte Frames ersetzt. Drehung, weiche Kante, Stärke und lokales Grading bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La animación de posición y tamaño se sustituirá solo en los fotogramas seguidos con éxito. La rotación, el suavizado, la intensidad y el etalonaje local se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asema- ja koko-animaatio korvataan vain onnistuneesti jäljitetyillä karmeilla. Kierto, höyhen, vahvuus ja paikallinen luokitus säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'animation de position et de taille ne sera remplacée que sur les images suivies avec succès. La rotation, l'adoucissement, l'intensité et l'étalonnage local sont préservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'animazione di posizione e dimensione verrà sostituita solo sui fotogrammi tracciati con successo. Rotazione, sfumatura, intensità e grading locale vengono conservati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animering av position och storlek ersätts bara över bildrutor som spårats framgångsrikt. Rotation, mjuk kant, styrka och lokal grading bevaras."
          }
        }
      }
    },
    "Position moves every selected shape together, so they keep their spacing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position bewegt alle ausgewählten Formen gemeinsam, sodass ihre Abstände erhalten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posición mueve todas las formas seleccionadas a la vez, de modo que conservan su separación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sijainti siirtää kaikkia valittuja muotoja yhdessä, joten niiden välit säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
