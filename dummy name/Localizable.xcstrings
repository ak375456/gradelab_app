    "Start Grading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grading starten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar a etalonar"
          }
        },
