          }
        }
      }
    },
    "Drag to compare. Every look in GradeLab is this one gesture away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh zum Vergleichen. Jeder Look in GradeLab ist nur diese eine Geste entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para comparar. Todos los looks de GradeLab están a un solo gesto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jokainen GradeLabin katse on tämän yhden eleen päässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour comparer. Chaque look de GradeLab est à un seul geste."
