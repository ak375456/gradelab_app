    "Negative light takes light away — a flag or negative fill." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negatives Licht nimmt Licht weg – wie eine Flag oder ein Negative Fill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz negativa quita luz, como una bandera o un relleno negativo."
