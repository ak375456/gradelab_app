        }
      }
    },
    "Blend modes other than Normal are not available in HDR projects yet. They are defined on 0-1 values, and an HDR image is not." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Mischmodi als Normal sind in HDR-Projekten noch nicht verfügbar. Sie sind auf Werten von 0 bis 1 definiert, ein HDR-Bild ist das nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modos de fusión distintos de Normal todavía no están disponibles en proyectos HDR. Se definen sobre valores de 0 a 1, y una imagen HDR no lo está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modes de fusion autres que Normal ne sont pas encore disponibles dans les projets HDR. Ils sont définis sur des valeurs de 0 à 1, ce qui n'est pas le cas d'une image HDR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I metodi di fusione diversi da Normale non sono ancora disponibili nei progetti HDR. Sono definiti su valori da 0 a 1, e un'immagine HDR non lo è."
          }
        }
      }
    },
    "Blending between source frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überblendung zwischen Quellframes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusión entre fotogramas de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion entre les images sources."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusione tra i fotogrammi sorgente."
          }
        }
      }
    },
    "Blends adjacent frames instead of repeating them, which removes the stepping in slow motion on footage that was not shot at a high frame rate. Fast movement softens rather than gaining detail — no new frames are invented." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet benachbarte Frames ineinander, statt sie zu wiederholen. Das entfernt das Ruckeln in Zeitlupen aus Material, das nicht mit hoher Bildrate aufgenommen wurde. Schnelle Bewegung wird weicher, statt an Detail zu gewinnen — es werden keine neuen Frames erfunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusiona los fotogramas contiguos en lugar de repetirlos, lo que elimina el salto de la cámara lenta en material que no se grabó a alta frecuencia. El movimiento rápido se suaviza en vez de ganar detalle: no se inventa ningún fotograma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionne les images voisines au lieu de les répéter, ce qui supprime les saccades du ralenti sur des rushes qui n'ont pas été tournés à haute fréquence. Les mouvements rapides s'adoucissent au lieu de gagner en détail — aucune image n'est inventée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonde i fotogrammi adiacenti invece di ripeterli, eliminando gli scatti dello slow motion su girato non ripreso ad alta frequenza. Il movimento rapido si ammorbidisce anziché guadagnare dettaglio: nessun fotogramma viene inventato."
          }
        }
      }
    },
    "Bloom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
