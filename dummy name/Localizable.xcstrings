    "A fill color with zero opacity leaves an outline-only shape. Set a stroke width under Stroke." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Füllfarbe mit null Deckkraft ergibt eine Form, die nur aus ihrer Kontur besteht. Die Konturstärke stellst du unter „Kontur“ ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un color de relleno con opacidad cero deja una forma hecha solo de contorno. Ajusta el grosor en Contorno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Täyteväri, jossa ei ole sameutta, jättää vain ääriviivan muodon. Aseta ääriviiva leveys ääriviiva alle."
