    "4:3 sensor modes appear only when this camera exposes them. Frame guides do not change the recorded size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:3-Sensormodi werden nur angezeigt, wenn diese Kamera sie anbietet. Bildrahmen ändern die Aufnahmegröße nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:3 sensor modes appear only when this camera exposes them. Frame guides do not change the recorded size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modos de sensor 4:3 solo aparecen si esta cámara los ofrece. Las guías no cambian el tamaño grabado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:3-kennotilat näkyvät vain, jos kamera tarjoaa ne. Rajausoppaat eivät muuta tallennuksen kokoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
