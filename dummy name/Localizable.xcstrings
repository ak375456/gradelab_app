    "The grade and GradeLab’s imported copy of the footage are removed. The clip in your photo library is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Grading und GradeLabs importierte Kopie des Materials werden entfernt. Der Clip in deiner Fotomediathek bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan el etalonaje y la copia importada del material por GradeLab. El clip de tu fototeca no se toca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuva-aineistosta poistetaan luokka ja GradeLabós -tuodut kopiot. Kuvakirjastosi klippi on koskematon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’étalonnage et la copie importée du métrage par GradeLab sont supprimés. Le clip de votre photothèque reste intact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grading e la copia del filmato importata da GradeLab vengono rimossi. La clip nella tua libreria foto resta intatta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradingen och GradeLabs importerade kopia av materialet tas bort. Klippet i ditt bildbibliotek påverkas inte."
          }
        }
      }
    },
    "The grade and GradeLab’s imported copy of the picture are removed. The photograph in your photo library is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
