    "Everything outside the outline is removed. Turn on Invert to cut out the object instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles außerhalb der Kontur wird entfernt. Aktiviere „Invertieren“, um stattdessen das Objekt auszuschneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimina todo lo que queda fuera del contorno. Activa Invertir para recortar el objeto en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui se trouve hors du contour est supprimé. Activez Inverser pour découper l’objet à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene rimosso tutto ciò che sta fuori dal contorno. Attiva Inverti per ritagliare invece l’oggetto."
          }
        }
      }
    },
