    "Matches exposure and white balance as closely as the footage allows. For clips from the same scene or a second camera." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht Belichtung und Weißabgleich so genau ab, wie es das Material zulässt. Für Clips aus derselben Szene oder von einer zweiten Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la exposición y el balance de blancos tan de cerca como el material lo permite. Para clips de la misma escena o de una segunda cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Täsmää valotus- ja valkotasapainoon niin tarkasti kuin kuvamateriaali sallii. Samasta kohtauksesta tai toisesta kamerasta otetuille nauhoille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait correspondre l'exposition et la balance des blancs d'aussi près que les images le permettent. Pour des plans de la même scène ou d'une seconde caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina esposizione e bilanciamento del bianco quanto il materiale consente. Per clip della stessa scena o di una seconda camera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像の範囲内で、露出とホワイトバランスをできるだけ近づけます。同じシーンや別のカメラのクリップ向け。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchar exponering och vitbalans så nära materialet tillåter. För klipp från samma scen eller en andra kamera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能匹配镜头允许的曝光和白平衡。用于来自同一场景或第二个摄像头的片段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儘可能匹配鏡頭允許的曝光和白平衡。用於來自同一場景或第二個相機的片段。"
          }
        }
      }
    },
