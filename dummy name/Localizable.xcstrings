    "Requires a supported 8-bit SDR source and a compatible hardware encoder. Try a smaller size or another codec." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert eine unterstützte 8-Bit-SDR-Quelle und einen kompatiblen Hardware-Encoder. Versuche eine kleinere Größe oder einen anderen Codec."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere un origen SDR de 8 bits compatible y un codificador por hardware compatible. Prueba con un tamaño menor u otro códec."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige une source SDR 8 bits prise en charge et un encodeur matériel compatible. Essayez une taille plus petite ou un autre codec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede una sorgente SDR a 8 bit supportata e un encoder hardware compatibile. Prova una dimensione più piccola o un altro codec."
