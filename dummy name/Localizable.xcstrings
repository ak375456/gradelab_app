    "Gentle contrast, soft warmth and mellow teal shadows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfter Kontrast, weiche Wärme und dezente türkisfarbene Schatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle contrast, soft warmth and mellow teal shadows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraste suave, calidez delicada y sombras verde azulado tenues."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hellä kontrasti, pehmeä lämpö ja hillityt sinivihreät varjot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
