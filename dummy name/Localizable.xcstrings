    "Tapping a preset replaces the current grade. You can keep editing afterwards, and the preset stays as it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen auf ein Preset ersetzt das aktuelle Grading. Du kannst danach weiter bearbeiten, und das Preset bleibt so, wie es gesichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar un preajuste sustituye el etalonaje actual. Puedes seguir editando después, y el preajuste se queda tal y como se guardó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetuksen valinta korvaa nykyisen värimäärittelyn. Voit jatkaa muokkausta sen jälkeen; tallennettu esiasetus säilyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher un préréglage remplace l'étalonnage actuel. Vous pouvez continuer à modifier ensuite, et le préréglage reste tel qu'il a été enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccare un preset sostituisce il grading attuale. Puoi continuare a modificare dopo, e il preset resta come è stato salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットをタップすると現在のグレードを置き換えます。その後も編集でき、保存済みのプリセットは変わりません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att trycka på en förinställning ersätter den aktuella gradingen. Du kan fortsätta redigera efteråt, och förinställningen förblir som den sparades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击预设会替换当前调色。之后您可以继续编辑，预设将保持保存状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選預設會替換當前調色。之後您可以繼續編輯，預設將保持儲存狀態。"
          }
        }
      }
    },
    "Target bit rate is approximate. Actual file size varies with the scene." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zielbitrate ist ein Richtwert. Die tatsächliche Dateigröße hängt vom Motiv ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target bit rate is approximate. Actual file size varies with the scene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tasa objetivo es aproximada. El tamaño real del archivo varía según la escena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavoitebittinopeus on arvio. Tiedoston todellinen koko vaihtelee näkymän mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le débit cible est approximatif. La taille réelle du fichier varie selon la scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bitrate di destinazione è indicativo. Le dimensioni effettive variano in base alla scena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレートは目安です。実際のファイルサイズは撮影内容によって変わります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
