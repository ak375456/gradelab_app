          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta LUT usa un dominio distinto de 0 a 1, lo que suele indicar que es una LUT de conversión log o de cámara y no un look."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette LUT utilise un domaine autre que 0 à 1, ce qui indique généralement une LUT de conversion log ou caméra plutôt qu'un look."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa LUT usa un dominio diverso da 0-1, il che di solito indica una LUT di conversione log o di camera anziché un look."
          }
        }
      }
    },
    "This mask is placed, but its grade is neutral." : {
