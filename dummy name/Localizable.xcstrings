    "Buy now and it stays yours forever, whatever the price becomes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauf jetzt, und er bleibt für immer deiner — ganz gleich, wie sich der Preis entwickelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómpralo ahora y será tuyo para siempre, sea cual sea el precio después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osta nyt, niin Pro pysyy sinulla pysyvästi hinnan myöhemmistä muutoksista riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achetez maintenant et c'est à vous pour toujours, quel que soit le prix par la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compralo ora e resta tuo per sempre, qualunque prezzo avrà poi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今購入すれば、今後価格が変わってもずっと使えます。"
          }
        },
        "sv" : {
