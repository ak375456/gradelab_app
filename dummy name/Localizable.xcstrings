    "Light + Shading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht + Schattierung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz + sombreado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valo + varjostus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumière + ombrage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luce + ombreggiatura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光と陰影"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljus + skuggning"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光照与明暗"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光照與明暗"
          }
        }
      }
    },
    "Light + Shading also darkens the side of a form turned away from this light. It shapes; it does not cast shadows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht + Schattierung dunkelt außerdem die von diesem Licht abgewandte Seite einer Form ab. Es formt, wirft aber keine Schatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz + sombreado también oscurece el lado de una forma que no mira a esta luz. Modela, no proyecta sombras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valo + varjostus tummentaa myös muodon valosta poispäin olevaa puolta. Se muotoilee, mutta ei luo varjoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumière + ombrage assombrit aussi le côté d’une forme opposé à cette lumière. Il modèle, il ne projette pas d’ombres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luce + ombreggiatura scurisce anche il lato di una forma rivolto lontano da questa luce. Modella, non proietta ombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「光と陰影」は、ライトと反対を向く面も暗くします。立体感を表現しますが、投影される影は生成しません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljus + skuggning gör även den sida av en form som vetter bort från ljuset mörkare. Det formar men kastar inga skuggor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光+阴影也会使形状的侧面变暗，远离这种光线。它塑造；它不会投下阴影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光+陰影也會使形狀的側面變暗，遠離這種光線。它塑造；它不會投下陰影。"
          }
        }
      }
    },
