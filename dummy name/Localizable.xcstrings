    "The stored depth is deleted at both qualities. Your lights are kept; they light nothing until the scene is analysed again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Tiefe wird in beiden Qualitäten gelöscht. Deine Lichter bleiben erhalten, beleuchten aber nichts, bis die Szene erneut analysiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra la profundidad guardada en ambas calidades. Tus luces se conservan, pero no iluminan nada hasta que se vuelva a analizar la escena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennettu syvyys poistetaan molemmilla laaduilla. Valosi säilyvät, mutta ne eivät valaise mitään ennen kuin kohtaus analysoidaan uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur enregistrée est supprimée dans les deux qualités. Vos lumières sont conservées, mais n’éclairent rien tant que la scène n’est pas réanalysée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondità salvata viene eliminata in entrambe le qualità. Le tue luci restano, ma non illuminano nulla finché la scena non viene rianalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両画質の保存済み深度を削除します。ライトは保持しますが、再解析するまで効果は表示されません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sparade djupet raderas i båda kvaliteterna. Dina ljus behålls men lyser inte upp något förrän scenen har analyserats igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储的深度在两种质量上都被删除。你的灯光被保留着；在再次分析场景之前，它们什么都不亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存的深度在兩種品質上都被刪除。你的燈光被保留著；在再次分析場景之前，它們什麼都不亮。"
          }
        }
      }
    },
    "The temporary file will be removed. Save a copy using Save to Files, Save to Photos, or Share first." : {
      "comment" : "A message displayed when the user closes an export that hasn't been saved.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
