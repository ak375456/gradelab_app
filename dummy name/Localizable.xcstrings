      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips werden in die Arbeitsfläche eingepasst. Mit „Transformieren“ kannst du sie neu positionieren oder vergrößern. „Original exportieren“ behält diese Arbeitsflächengröße bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips se ajustan dentro del lienzo. Usa Transformar para recolocarlos o agrandarlos. Exportar Original conserva este tamaño de lienzo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kankaan sisään mahtuvat Clipsit. Aseta ne uudelleen tai suurenna Transformilla. Vie alkuperäinen säilyttää tämän kokoisen kankaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips s'ajustent à l'intérieur du canevas. Utilisez Transformer pour les repositionner ou les agrandir. L'export Original conserve cette taille de canevas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip si adattano all'interno del canvas. Usa Trasforma per riposizionarle o ingrandirle. L'esportazione Originale conserva questa dimensione del canvas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップをキャンバス内に収めます。「変形」で位置やサイズを変更できます。「元の解像度」で書き出すと、このキャンバスサイズが維持されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippen passas in i arbetsytan. Använd Transform för att flytta eller förstora dem. Exportera original bevarar den här arbetsytans storlek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夹子适合画布内。使用变换来重新定位或放大它们。导出原件保留此画布尺寸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夾子適合畫布內。使用變換來重新定位或放大它們。匯出原件保留此畫布尺寸。"
          }
        }
      }
    },
    "Clips on the same track cannot overlap. Use an overlay track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips auf derselben Spur dürfen sich nicht überlappen. Nutze eine Overlay-Spur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips de la misma pista no pueden solaparse. Usa una pista de superposición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Samalla raidalla olevat letkut eivät voi olla päällekkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips d’une même piste ne peuvent pas se chevaucher. Utilisez une piste de superposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip sulla stessa traccia non possono sovrapporsi. Usa una traccia di sovrapposizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じトラックのクリップは重ねられません。オーバーレイトラックを使用してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipp på samma spår kan inte överlappa. Använd ett överläggsspår."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一轨道上的片段不能重叠。使用叠加轨道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一軌道上的片段不能重疊。使用疊加軌道。"
