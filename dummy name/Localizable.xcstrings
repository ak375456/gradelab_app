        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aseta toistokohta äänilukon sisälle, pois sen reunoilta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez la tête de lecture dans le clip audio, à l’écart de ses bords."
