        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma sobre la imagen para colocarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piirrä kuvan muoto ja aseta se paikalleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
