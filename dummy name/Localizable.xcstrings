    "Drag the shape to move it, or its handles to resize, rotate and soften it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form, um sie zu bewegen, oder ihre Griffe, um sie zu skalieren, zu drehen und weichzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma para moverla, o sus tiradores para redimensionarla, girarla y suavizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme pour la déplacer, ou ses poignées pour la redimensionner, la faire pivoter et l'adoucir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la forma per spostarla, o le sue maniglie per ridimensionarla, ruotarla e ammorbidirla."
          }
        }
      }
    },
    "Drag to compare. Every look in GradeLab is this one gesture away." : {
