            "value" : "Diese Quelle meldet %lld Bit Präzision und benötigt den erweiterten Pfad daher nicht."
          }
        }
      }
    },
    "This timeline is %@, but this clip is %@. A timeline cannot mix the two Log formats." : {
      "localizations" : {
