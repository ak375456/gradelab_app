    "Answers there often come faster than by email, and feature requests get discussed in the open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort kommen Antworten oft schneller als per E-Mail, und Feature-Wünsche werden öffentlich diskutiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allí las respuestas suelen llegar antes que por correo, y las peticiones de funciones se debaten a la vista de todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses y arrivent souvent plus vite que par e-mail, et les demandes de fonctionnalités s'y discutent au grand jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lì le risposte arrivano spesso prima che via e-mail, e le richieste di funzioni si discutono alla luce del sole."
          }
        }
      }
    },
