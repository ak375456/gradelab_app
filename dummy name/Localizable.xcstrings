        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab non è riuscito a leggere questa immagine."
          }
        }
      }
    },
    "GradeLab couldn’t read this video’s technical information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab konnte die technischen Informationen dieses Videos nicht lesen."
          }
