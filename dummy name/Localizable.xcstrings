          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tracciamento non è riuscito ad agganciare questo contorno. Disegnalo attorno a un oggetto con dettagli visibili, o attorno a una parte più ampia del soggetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この輪郭で対象を認識できませんでした。細部がはっきりした対象や、被写体のより広い範囲を囲んでください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårningen kunde inte låsa på den här konturen. Rita den runt ett objekt med synlig detalj, eller runt mer av motivet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟踪无法锁定此大纲。在具有可见细节的物体周围绘制，或围绕更多主题绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
