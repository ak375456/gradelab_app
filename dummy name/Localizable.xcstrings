    "Record a video with an editable GradeLab look" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制视频并保留可继续编辑的 GradeLab 风格"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製影片並保留可繼續編輯的 GradeLab 風格"
          }
        }
      }
    },
    "Record on iPhone and iPad with live LUT previews and manual focus, white balance and exposure. Camera previews and controls stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm auf iPhone und iPad mit Live-LUT-Vorschau sowie manuellem Fokus, Weißabgleich und Belichtung auf. Vorschau und Kamerasteuerung bleiben kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record on iPhone and iPad with live LUT previews and manual focus, white balance and exposure. Camera previews and controls stay free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba en iPhone y iPad con LUTs en directo y enfoque, balance de blancos y exposición manuales. La vista previa y los controles siguen siendo gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna iPhonella ja iPadilla reaaliaikaisella LUT-esikatselulla sekä tarkennuksen, valkotasapainon ja valotuksen käsisäädöillä. Esikatselu ja säätimet pysyvät ilmaisina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez sur iPhone et iPad avec aperçu LUT en direct et réglage manuel de la mise au point, de la balance des blancs et de l’exposition. L’aperçu et les commandes restent gratuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra su iPhone e iPad con anteprime LUT in tempo reale e controllo manuale di messa a fuoco, bilanciamento del bianco ed esposizione. Anteprime e controlli restano gratuiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneとiPadで、ライブLUTプレビューとフォーカス、ホワイトバランス、露出の手動調整を使って録画できます。カメラのプレビューとコントロールは引き続き無料です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela in på iPhone och iPad med LUT-förhandsvisning i realtid och manuell fokus, vitbalans och exponering. Förhandsvisning och kontroller förblir gratis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 和 iPad 上录制，支持实时 LUT 预览及手动对焦、白平衡和曝光。相机预览与控制可免费使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 和 iPad 上錄製，支援即時 LUT 預覽及手動對焦、白平衡和曝光。相機預覽與控制可免費使用。"
          }
        }
      }
    },
