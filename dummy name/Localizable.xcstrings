    "Echo repeats the sound. Reverb adds a room tail. Tails end at the clip edge; leave room before trimming." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エコーは音を繰り返し、リバーブは空間の響きを加えます。余韻はクリップの端で終わるため、トリム時は余白を残してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回声重复声音。混响增加了房间尾部。尾部在夹子边缘结束；在修剪前留出空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回聲重複聲音。混響增加了房間尾部。尾部在夾子邊緣結束；在修剪前留出空間。"
          }
        }
      }
    },
