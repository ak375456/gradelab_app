    "%@ export is not supported. Only HLG has a validated 10-bit HDR path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export in %@ wird nicht unterstützt. Nur HLG hat einen validierten 10-Bit-HDR-Pfad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación %@ no es compatible. Solo HLG tiene una cadena HDR de 10 bits validada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'export %@ n'est pas pris en charge. Seul le HLG dispose d'une chaîne HDR 10 bits validée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione %@ non è supportata. Solo HLG ha una catena HDR a 10 bit validata."
          }
        }
      }
    },
    "%@ HDR is decoded, previewed and graded at full 10-bit precision. HDR export is still being validated and stays disabled until then — this source is never converted to SDR without you choosing it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-HDR wird mit voller 10-Bit-Präzision dekodiert, vorgeschaut und gegradet. Der HDR-Export wird noch validiert und bleibt bis dahin deaktiviert – diese Quelle wird nie ohne deine Wahl nach SDR konvertiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El HDR %@ se decodifica, se previsualiza y se etalona con precisión completa de 10 bits. La exportación HDR todavía se está validando y permanece desactivada hasta entonces: este origen nunca se convierte a SDR sin que tú lo elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le HDR %@ est décodé, prévisualisé et étalonné avec une précision 10 bits complète. L’exportation HDR est encore en cours de validation et reste désactivée jusque-là — cette source n’est jamais convertie en SDR sans votre accord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’HDR %@ viene decodificato, mostrato in anteprima e gradato con piena precisione a 10 bit. L’esportazione HDR è ancora in fase di validazione e resta disattivata fino ad allora — questa sorgente non viene mai convertita in SDR senza una tua scelta."
          }
        }
      }
    },
