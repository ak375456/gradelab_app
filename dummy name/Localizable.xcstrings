    "Blue channel. Raising adds blue; lowering leans yellow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blaukanal. Anheben fügt Blau hinzu; Absenken neigt zu Gelb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal azul. Subirlo añade azul; bajarlo tira hacia el amarillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal bleu. Monter ajoute du bleu ; descendre tire vers le jaune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canale blu. Alzarlo aggiunge blu; abbassarlo tende al giallo."
          }
        }
      }
