    "Fills the canvas wherever no clip covers it, and is part of the export. The outline on the preview shows where the canvas ends." : {
      "comment" : "A description of the background colour picker.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt die Arbeitsfläche überall dort, wo kein Clip sie bedeckt, und ist Teil des Exports. Die Kontur in der Vorschau zeigt, wo die Arbeitsfläche endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena el lienzo allí donde ningún clip lo cubre, y forma parte de la exportación. El contorno de la previsualización muestra dónde termina el lienzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplit le canevas partout où aucun clip ne le couvre, et fait partie de l’exportation. Le contour dans l’aperçu montre où s’arrête le canevas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempie il canvas ovunque nessuna clip lo copra, e fa parte dell’esportazione. Il contorno nell’anteprima mostra dove finisce il canvas."
          }
        }
      }
    },
