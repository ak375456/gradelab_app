    "Judge this at 100% or closer, and hold the picture to compare. At preview size a denoiser always looks better than it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beurteile das bei 100 % oder näher und halte das Bild gedrückt, um zu vergleichen. In Vorschaugröße sieht eine Rauschreduzierung immer besser aus, als sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juzga esto al 100 % o más cerca, y mantén pulsada la imagen para comparar. Al tamaño de la previsualización, un reductor de ruido siempre parece mejor de lo que es."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arvioi tämä 100-prosenttisesti tai lähemmäs ja vertaa kuvaa. Esikatselukoossa denomisti näyttää aina paremmalta kuin se on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jugez ceci à 100 % ou de plus près, et maintenez l'image pour comparer. À la taille de l'aperçu, un réducteur de bruit paraît toujours meilleur qu'il ne l'est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giudica questo al 100% o più da vicino, e tieni premuta l'immagine per confrontare. Alla dimensione dell'anteprima un riduttore di rumore sembra sempre migliore di quanto sia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedöm det här vid 100 % eller närmare, och håll på bilden för att jämföra. I förhandsvisningsstorlek ser en brusreducerare alltid bättre ut än den är."
          }
        }
      }
    },
