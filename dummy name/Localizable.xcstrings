            "value" : "Grading anwenden"
          }
        }
      }
    },
    "Apply updates the video layer in both preview and export. X/Y 0.5 centers the video. The canvas pinch zoom is separate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Anwenden“ aktualisiert die Videoebene in Vorschau und Export. X/Y 0,5 zentriert das Video. Der Zoom der Arbeitsfläche ist davon getrennt."
          }
