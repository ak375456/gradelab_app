    "Your grade is baked into the exported frames." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Grading wird fest in die exportierten Frames eingerechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu etalonaje queda integrado en los fotogramas exportados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arvosanasi on upotettu vietyihin ruutu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre étalonnage est intégré aux images exportées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo grading viene integrato nei fotogrammi esportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
