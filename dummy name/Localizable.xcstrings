    "Audio follows the clip and keeps its pitch. Later clips shift to stay in step." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio folgt dem Clip und behält seine Tonhöhe. Spätere Clips verschieben sich, um im Takt zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio sigue al clip y conserva su tono. Los clips posteriores se desplazan para mantener la sincronía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio suit le clip et conserve sa hauteur tonale. Les clips suivants se décalent pour rester synchronisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio segue la clip e ne mantiene l'intonazione. Le clip successive si spostano per restare in sincrono."
          }
        }
      }
    },
