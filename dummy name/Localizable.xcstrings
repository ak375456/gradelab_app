            "state" : "translated",
            "value" : "Dra formen direkt på bilden."
          }
        }
      }
    },
    "Drag the shape in the preview. Pinch to resize; turn with two fingers to rotate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form in der Vorschau. Zusammenziehen ändert die Größe; mit zwei Fingern drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma en la previsualización. Pellizca para redimensionarla; gírala con dos dedos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vedä muoto esikatselussa. Pinch muuttaa kokoa, käännä kahdella sormella pyörimään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
