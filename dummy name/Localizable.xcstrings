          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsualiza LUTs y ajusta enfoque, balance de blancos, ISO y exposición gratis. Pásate a GradeLab Pro para grabar video en iPhone y iPad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esikatsele LUT-tyylejä ja säädä tarkennusta, valkotasapainoa, ISO-arvoa ja valotusta ilmaiseksi. Hanki GradeLab Pro, jotta voit tallentaa videoita iPhonella ja iPadilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévisualisez les LUTs et réglez gratuitement la mise au point, la balance des blancs, l’ISO et l’exposition. Passez à GradeLab Pro pour enregistrer sur iPhone et iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza le LUT e regola gratuitamente messa a fuoco, bilanciamento del bianco, ISO ed esposizione. Passa a GradeLab Pro per registrare video su iPhone e iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LUTのプレビューやフォーカス、ホワイトバランス、ISO、露出の調整は無料です。iPhoneとiPadで動画を録画するにはGradeLab Proにアップグレードしてください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsvisa LUT:ar och justera fokus, vitbalans, ISO och exponering gratis. Uppgradera till GradeLab Pro för att spela in video på iPhone och iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费预览 LUT，调节对焦、白平衡、ISO 和曝光。升级 GradeLab Pro 后即可在 iPhone 和 iPad 上录制视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費預覽 LUT，調節對焦、白平衡、ISO 和曝光。升級 GradeLab Pro 後即可在 iPhone 和 iPad 上錄製影片。"
          }
        }
      }
    },
    "Preview Pro looks freely. Unlock Pro to export them, or remove the look to keep exporting free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir Pro-Looks frei in der Vorschau an. Schalte Pro frei, um sie zu exportieren, oder entferne den Look, um weiterhin kostenlos zu exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsualiza los looks Pro sin límites. Desbloquea Pro para exportarlos, o quita el look para que la exportación siga siendo gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esikatsele Pro-tyylejä vapaasti. Avaa Pro viedäksesi ne tai poista tyyli jatkaaksesi ilmaista vientiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévisualisez librement les looks Pro. Déverrouillez Pro pour les exporter, ou retirez le look pour que l'export reste gratuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova liberamente i look Pro in anteprima. Sblocca Pro per esportarli, oppure rimuovi il look per continuare a esportare gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proルックは自由にプレビューできます。書き出すにはProを購入するか、ルックを外して無料で書き出してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsvisa Pro-looks fritt. Lås upp Pro för att exportera dem, eller ta bort looken för att fortsätta exportera gratis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可自由预览 Pro 风格。解锁 Pro 后即可导出；也可移除该风格，继续免费导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可自由預覽 Pro 風格。解鎖 Pro 後即可匯出；也可移除該風格，繼續免費匯出。"
          }
        }
      }
    },
