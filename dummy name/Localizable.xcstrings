    "Luminance noise within the frame, filtered along edges rather than across them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminanzrauschen innerhalb des Frames, entlang der Kanten gefiltert statt über sie hinweg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruido de luminancia dentro del fotograma, filtrado a lo largo de los bordes y no atravesándolos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Luminanssimelua ruutu, joka suodattuu reunoja pitkin eikä niiden yli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruit de luminance à l'intérieur de l'image, filtré le long des contours plutôt qu'en travers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumore di luminanza all'interno del fotogramma, filtrato lungo i bordi invece che attraverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレーム内の輝度ノイズを抑えます。輪郭を越えず、輪郭に沿って処理します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminansbrus inom bildrutan, filtrerat längs kanterna i stället för tvärs över dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减少单帧内的亮度噪点，沿边缘处理以保留轮廓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減少單影格內的亮度雜訊，沿邊緣處理以保留輪廓。"
          }
        }
      }
    },
    "Luminance noise, across time. The detail people notice losing lives here, so start low." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminanzrauschen, über die Zeit. Die Details, deren Verlust auffällt, wohnen hier – also fang niedrig an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruido de luminancia, a lo largo del tiempo. El detalle cuya pérdida se nota vive aquí, así que empieza bajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yksityiskohta, jonka ihmiset huomaavat menettävänsä henkiä täällä, alkaa olla matala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruit de luminance, dans le temps. Le détail dont on remarque la perte habite ici, alors commencez bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumore di luminanza, nel tempo. Il dettaglio di cui si nota la perdita abita qui, quindi parti basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間方向の輝度ノイズを抑えます。失われると目立つ細部に影響するため、弱い設定から始めてください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminansbrus, över tid. Detaljen folk märker att de förlorar bor här, så börja lågt."
          }
        },
        "zh-Hans" : {
