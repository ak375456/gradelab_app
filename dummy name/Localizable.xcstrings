        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的調色、變換和關鍵影格會結轉。"
          }
        }
      }
    },
    "Your imported clips, photographs and non-destructive grades will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine importierten Clips, Fotos und nicht-destruktiven Gradings erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecerán tus clips importados, tus fotografías y tus etalonajes no destructivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tuodut pätkäsi, valokuvasi ja tuhoutumattomat arvosanasi näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clips importés, vos photographies et vos étalonnages non destructifs apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compariranno le tue clip importate, le tue fotografie e i tuoi grading non distruttivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだ動画、写真、非破壊のグレードがここに表示されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
