    "Saves the whole grade — light, colour, curves, HSL, wheels, vignette, the look and its strength, and the finishing effects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert das gesamte Grading — Licht, Farbe, Kurven, HSL, Wheels, Vignette, den Look und seine Stärke sowie die abschließenden Effekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el etalonaje completo: luz, color, curvas, HSL, ruedas, viñeta, el look y su intensidad, y los efectos de acabado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre tout l'étalonnage — lumière, couleur, courbes, TSL, roues, vignettage, le look et son intensité, ainsi que les effets de finition."
          }
        },
