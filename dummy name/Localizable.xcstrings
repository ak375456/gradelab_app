    "Saves the whole grade — light, colour, curves, HSL, wheels, vignette, the look and its strength, and the finishing effects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert das gesamte Grading — Licht, Farbe, Kurven, HSL, Wheels, Vignette, den Look und seine Stärke sowie die abschließenden Effekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el etalonaje completo: luz, color, curvas, HSL, ruedas, viñeta, el look y su intensidad, y los efectos de acabado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentaa koko värimäärittelyn: valon, värin, käyrät, HSL:n, väripyörät, vinjetin, tyylin ja sen voimakkuuden sekä viimeistelytehosteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre tout l'étalonnage — lumière, couleur, courbes, TSL, roues, vignettage, le look et son intensité, ainsi que les effets de finition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva l'intero grading: luce, colore, curve, HSL, ruote, vignettatura, il look e la sua intensità, e gli effetti di finitura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライト、カラー、カーブ、HSL、ホイール、ビネット、ルックと強さ、仕上げエフェクトをまとめて保存します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar hela gradingen — ljus, färg, kurvor, HSL, hjul, vinjettering, looken och dess styrka, samt de avslutande effekterna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存完整调色，包括光线、色彩、曲线、HSL、色轮、暗角、风格及其强度，以及质感效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存完整調色，包括光線、色彩、曲線、HSL、色輪、暗角、風格及其強度，以及質感效果。"
          }
        }
      }
    },
