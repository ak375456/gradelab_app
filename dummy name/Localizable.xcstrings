    },
    "Add a light, or start from a preset. Directional is a distant source like the sun or a window; Point is a lamp in the scene; Spot is an aimed cone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Licht hinzu oder starte mit einem Preset. Gerichtet ist eine ferne Quelle wie die Sonne oder ein Fenster, Punkt ist eine Lampe in der Szene, Spot ist ein ausgerichteter Lichtkegel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una luz o empieza con un ajuste. Direccional es una fuente lejana como el sol o una ventana; Puntual es una lámpara en la escena; Foco es un cono orientado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisää valo tai aloita esiasetuksesta. Suunnattu on kaukainen lähde, kuten aurinko tai ikkuna. Piste on lamppu kohtauksessa. Kohde on suunnattu valokeila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une lumière ou partez d’un préréglage. Directionnelle est une source lointaine comme le soleil ou une fenêtre ; Ponctuelle est une lampe dans la scène ; Spot est un cône orienté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una luce o parti da un preset. Direzionale è una sorgente lontana come il sole o una finestra; Puntiforme è una lampada nella scena; Spot è un cono orientato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトを追加するか、プリセットから始めましょう。平行光源は太陽や窓のような遠い光源、点光源はシーン内の照明、スポットは狙った方向を円すい状に照らす光源です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till ett ljus eller börja med en förinställning. Riktat är en avlägsen källa som solen eller ett fönster, Punkt är en lampa i scenen och Spot är en riktad kon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加光源，或从预设开始。方向光类似太阳或窗户等远处光源；点光源模拟场景中的灯；聚光灯则照射指定方向的锥形区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增光源，或從預設開始。方向光類似太陽或窗戶等遠處光源；點光源模擬場景中的燈；聚光燈則照射指定方向的錐形區域。"
          }
        }
      }
    },
    "Add a second layer — a title, a shape, a logo or another clip — to use as the matte." : {
      "comment" : "A hint explaining that a second layer is needed to use as a track matte.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
