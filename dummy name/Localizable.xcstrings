    "Import a clip or a photograph, inspect its real format, grade on the GPU, and export at its original dimensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere einen Clip oder ein Foto, sieh dir sein echtes Format an, grade auf der GPU und exportiere in den Originalabmessungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un clip o una fotografía, inspecciona su formato real, etalona en la GPU y exporta a sus dimensiones originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un clip ou une photographie, inspectez son format réel, étalonnez sur le GPU et exportez à ses dimensions d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una clip o una fotografia, ispeziona il suo formato reale, fai il grading sulla GPU ed esporta alle dimensioni originali."
          }
        }
      }
    },
