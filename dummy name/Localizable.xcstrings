    },
    "The clip changed during analysis. Analyze it again to stabilize the current section." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Clip wurde während der Analyse geändert. Analysiere ihn erneut, um den aktuellen Abschnitt zu stabilisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip changed during analysis. Analyze it again to stabilize the current section."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clip cambió durante el análisis. Analízalo de nuevo para estabilizar la sección actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leike muuttui analyysin aikana. Vakauta nykyinen osuus analysoimalla uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip a changé pendant l’analyse. Analysez-le à nouveau pour stabiliser la section actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clip è cambiata durante l’analisi. Analizzala di nuovo per stabilizzare la sezione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解析中にクリップが変更されました。現在の範囲を補正するには再解析してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippet ändrades under analysen. Analysera igen för att stabilisera den aktuella delen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析期间片段发生了变化。请重新分析当前区段以应用防抖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析期間片段發生了變化。請重新分析當前區段以應用防手震。"
          }
        }
      }
    },
    "The clip could not be split at the playhead." : {
      "localizations" : {
