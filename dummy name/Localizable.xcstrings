            "value" : "您匯入的片段、照片和非破壞性調色將顯示在這裡。"
          }
        }
      }
    },
    "Your look stays editable in GradeLab. Photos saves the original without the preview look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Look bleibt in GradeLab bearbeitbar. Fotos sichert das Original ohne den Vorschau-Look."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your look stays editable in GradeLab. Photos saves the original without the preview look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu look sigue siendo editable en GradeLab. Fotos guarda el original sin el look de vista previa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyyli säilyy muokattavana GradeLabissa. Kuvat tallentaa alkuperäisen ilman esikatselutyyliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre look reste modifiable dans GradeLab. Photos enregistre l’original sans le look d’aperçu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo look resta modificabile in GradeLab. Foto salva l’originale senza il look di anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックはGradeLabで編集できます。「写真」にはプレビューのルックを適用せずに元の映像を保存します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
