    "Payment is charged to your Apple Account. Renews automatically until cancelled in account settings at least 24 hours before renewal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung wird über deinen Apple-Account abgerechnet. Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor der Verlängerung in den Account-Einstellungen gekündigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se carga a tu cuenta de Apple. Se renueva automáticamente hasta que la canceles en los ajustes de la cuenta, al menos 24 horas antes de la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement est débité de votre compte Apple. L'abonnement se renouvelle automatiquement jusqu'à sa résiliation dans les réglages du compte, au moins 24 heures avant le renouvellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento viene addebitato sul tuo account Apple. Si rinnova automaticamente finché non lo annulli nelle impostazioni dell'account, almeno 24 ore prima del rinnovo."
          }
        }
      }
    },
