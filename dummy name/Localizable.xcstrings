    "Hue as angle and saturation as distance from centre" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbton als Winkel, Sättigung als Abstand vom Mittelpunkt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tono como ángulo y la saturación como distancia al centro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La teinte comme angle et la saturation comme distance au centre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalità come angolo e la saturazione come distanza dal centro"
          }
        }
      }
    },
    "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat and Sat vs Luma — the curves that target one colour without touching the rest. Master, Red, Green and Blue stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat und Sat vs Luma — die Kurven, die eine Farbe treffen, ohne den Rest anzufassen. Master, Rot, Grün und Blau bleiben kostenlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat y Sat vs Luma: las curvas que actúan sobre un color sin tocar los demás. Master, Rojo, Verde y Azul siguen siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat et Sat vs Luma — les courbes qui ciblent une couleur sans toucher aux autres. Master, Rouge, Vert et Bleu restent gratuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue vs Hue, Hue vs Sat, Hue vs Luma, Luma vs Sat, Sat vs Sat e Sat vs Luma: le curve che agiscono su un colore senza toccare gli altri. Master, Rosso, Verde e Blu restano gratuiti."
          }
        }
      }
    },
