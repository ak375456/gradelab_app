    "Pick a color from the picture" : {
      "comment" : "A button label that lets the user pick a color from the image.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Farbe aus dem Bild aufnehmen"
          }
        },
        "es" : {
          "stringUnit" : {
