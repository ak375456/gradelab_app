    "Set a value at two different moments and the property moves smoothly between them. That is all animation is here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze einen Wert zu zwei verschiedenen Zeitpunkten, und die Eigenschaft bewegt sich weich dazwischen. Mehr ist Animation hier nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define un valor en dos instantes distintos y la propiedad se moverá suavemente entre ambos. La animación aquí no es más que eso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aseta arvo kahteen eri hetkeen, ja kiinteistö liikkuu sujuvasti niiden välillä. Siinä kaikki, mitä animaatiossa on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez une valeur à deux instants différents et la propriété passe doucement de l'une à l'autre. L'animation n'est rien d'autre que cela ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un valore in due istanti diversi e la proprietà si muove dolcemente tra i due. Qui l'animazione non è altro che questo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange ett värde vid två olika ögonblick och egenskapen rör sig mjukt däremellan. Mer än så är animering inte här."
