          "stringUnit" : {
            "state" : "translated",
            "value" : "ディストーションはざらつきを、ビットクラッシャーは粗いデジタル音を加えます。弱い設定から始め、クリップレベルを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
