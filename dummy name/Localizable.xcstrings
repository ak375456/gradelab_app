    "Resizing keeps the canvas shape. Upscaling does not add detail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größenänderung behält die Form der Arbeitsfläche. Hochskalieren fügt keine Details hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio de tamaño mantiene la forma del lienzo. Ampliar no añade detalle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mukautukset pitävät kankaan muodon ennallaan. Upskarointi ei lisää yksityiskohtia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le redimensionnement conserve la forme du canevas. L'agrandissement n'ajoute aucun détail."
