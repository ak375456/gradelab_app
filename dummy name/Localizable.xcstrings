    "GradeLab" : {
      "shouldTranslate" : false
    },
    "GradeLab collects no data. No accounts, no analytics, no advertising and no trackers — your footage never leaves this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab erhebt keine Daten. Keine Accounts, keine Analyse, keine Werbung und keine Tracker — dein Material verlässt dieses Gerät nie."
          }
        }
      }
    },
    "GradeLab is an independent app — no ads, no trackers, no investors. Pro is what funds the work, and every purchase goes straight into the next update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GradeLab ist eine unabhängige App — keine Werbung, keine Tracker, keine Investoren. Pro finanziert die Arbeit, und jeder Kauf fließt direkt in das nächste Update."
          }
        }
      }
    },
