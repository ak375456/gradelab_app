    "Double tap the graph to add a speed point. Drag a point to change its speed and position." : {
      "comment" : "A hint explaining how to use the speed curve view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippe auf die Grafik, um einen Tempopunkt hinzuzufügen. Ziehe einen Punkt, um Tempo und Position zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el gráfico para añadir un punto de velocidad. Arrastra un punto para cambiar su velocidad y su posición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaksoisnapauta käyrää lisätäksesi nopeuspisteen. Vedä pistettä muuttaaksesi sen nopeutta ja sijaintia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois le graphique pour ajouter un point de vitesse. Faites glisser un point pour changer sa vitesse et sa position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il grafico per aggiungere un punto di velocità. Trascina un punto per cambiarne velocità e posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフをダブルタップして速度ポイントを追加します。ポイントをドラッグして速度と位置を変更できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck på grafen för att lägga till en hastighetspunkt. Dra en punkt för att ändra hastighet och läge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击图表以添加一个速度点。拖动一个点来改变其速度和位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙擊圖表以新增一個速度點。拖動一個點來改變其速度和位置。"
          }
        }
      }
    },
