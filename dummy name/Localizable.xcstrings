    "One transition will be removed because the new footage has no extra frames at that cut." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい映像のカット位置に余分なフレームがないため、1個のトランジションが削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
