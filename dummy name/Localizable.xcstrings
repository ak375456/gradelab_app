    "Extend the text clip to use an animation longer than %@." : {
      "comment" : "Explains the duration limit on a text clip shorter than five seconds. The argument includes its time units.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängere den Textclip, um eine Animation zu verwenden, die länger als %@ ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarga el clip de texto para usar una animación de más de %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidennä tekstileikettä, jos haluat käyttää yli %@ kestävää animaatiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allongez le clip de texte pour utiliser une animation de plus de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allunga la clip di testo per usare un’animazione di oltre %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@より長いアニメーションを使うには、テキストクリップを延長してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förläng textklippet för att använda en animation som är längre än %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展文本片段以使用比%@更长的动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擴充套件文字片段以使用比%@更長的動畫。"
          }
        }
      }
    },
    "f means frames. Values show the nearest frame at the project's frame rate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f steht für Frames. Die Werte zeigen den nächstgelegenen Frame bei der Bildrate des Projekts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f significa fotogramas. Los valores muestran el fotograma más cercano según la frecuencia del proyecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f tarkoittaa ruutuja. Arvot näyttävät lähimmän ruudun projektin kuvataajuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f signifie images. Les valeurs indiquent l’image la plus proche à la fréquence du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f indica i fotogrammi. I valori mostrano il fotogramma più vicino alla frequenza del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fはフレームを表します。プロジェクトのフレームレートで最も近いフレームを表示します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f betyder bildrutor. Värdena visar närmaste bildruta vid projektets bildfrekvens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F表示帧。值显示项目帧率下最接近的帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F表示影格。值顯示專案影格率下最接近的影格。"
          }
        }
      }
    },
    "Fade" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
