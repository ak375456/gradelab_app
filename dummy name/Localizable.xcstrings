    "Original timing" : {
      "comment" : "A string describing the video size, frame rate, and codec used in the export. The first argument is the width of the video frame. The second argument is the height of the video frame. The third argument is the frame rate of the video. The fourth argument is the codec used for the video.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
