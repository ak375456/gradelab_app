    "Grain moves with the picture: animating its amount is fine, and the pattern itself stays put frame to frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korn bewegt sich mit dem Bild: Seine Stärke lässt sich problemlos animieren, und das Muster selbst bleibt von Frame zu Frame an Ort und Stelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grano acompaña a la imagen: animar su cantidad no da problemas, y el patrón en sí se mantiene estable de un fotograma a otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le grain suit l'image : animer son intensité ne pose aucun problème, et le motif lui-même reste stable d'une image à l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grana accompagna l'immagine: animarne la quantità non è un problema, e la trama in sé resta ferma da un fotogramma all'altro."
          }
        }
      }
    },
