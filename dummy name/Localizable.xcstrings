    "Choose Auto for a one-tap cutout, Lasso to draw around the exact object you want, or Color for green and blue screen footage." : {
      "comment" : "A description below the mode buttons, explaining their purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Auto“ für einen Freisteller mit einem Tipp, „Lasso“, um genau das gewünschte Objekt zu umfahren, oder „Farbe“ für Green- und Bluescreen-Material."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Auto para un recorte con un toque, Lazo para dibujar alrededor del objeto exacto que quieres, o Color para material de croma verde o azul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Auto pour un détourage en une touche, Lasso pour tracer autour de l’objet voulu, ou Couleur pour un fond vert ou bleu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Auto per uno scontorno con un tocco, Lazo per tracciare attorno all’oggetto che vuoi, o Colore per riprese in green o blue screen."
          }
        }
      }
    },
