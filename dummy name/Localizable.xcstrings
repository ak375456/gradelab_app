            "value" : "Käufe werden möglich, sobald unsere Nutzungsbedingungen und die Datenschutzrichtlinie veröffentlicht sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras se abrirán cuando se publiquen nuestros Términos y nuestra Política de privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ostot avautuvat, kun käyttöehdot ja tietosuojakäytäntö julkaistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats seront ouverts dès la publication de nos Conditions et de notre Politique de confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli acquisti si apriranno quando saranno pubblicati i nostri Termini e la nostra Informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用規約とプライバシーポリシーの公開後に購入できるようになります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp öppnas när våra villkor och vår integritetspolicy är publicerade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
