        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, la exportación usa %lld × %lld y %@. Desactívalo para elegir otro tamaño de salida o frecuencia de fotogramas en Exportar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
