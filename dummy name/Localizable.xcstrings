        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズを変更してもキャンバスの縦横比は維持されます。拡大しても細部は増えません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storleksändringen behåller arbetsytans form. Uppskalning tillför ingen detalj."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整尺寸时保留画布比例。放大不会增加细节。"
