    "Dimmed codecs are unavailable for this camera and format. ProRes uses substantially more storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeblendete Codecs sind für diese Kamera und dieses Format nicht verfügbar. ProRes benötigt deutlich mehr Speicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmed codecs are unavailable for this camera and format. ProRes uses substantially more storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códecs atenuados no están disponibles para esta cámara y formato. ProRes usa mucho más almacenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmennetyt koodekit eivät ole saatavilla tällä kameralla ja muodolla. ProRes käyttää huomattavasti enemmän tallennustilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codecs grisés ne sont pas disponibles pour cette caméra et ce format. ProRes utilise nettement plus d’espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codec attenuati non sono disponibili per questa fotocamera e questo formato. ProRes usa molto più spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄く表示されたコーデックは、このカメラと形式では使用できません。ProResは大幅に多くの保存容量を使用します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtonade kodekar är inte tillgängliga för denna kamera och detta format. ProRes använder betydligt mer lagring."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调暗的编解码器不适用于此相机和格式。ProRes使用的存储空间要大得多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調暗的編解碼器不適用於此相機和格式。ProRes使用的儲存空間要大得多。"
          }
        }
      }
    },
