    "This LUT says it is size %lld but contains %lld entries instead of %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses LUT gibt die Größe %lld an, enthält aber %lld Einträge statt %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta LUT dice ser de tamaño %lld, pero contiene %lld entradas en lugar de %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette LUT annonce une taille de %lld mais contient %lld entrées au lieu de %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa LUT dichiara una dimensione di %lld ma contiene %lld voci invece di %lld."
          }
        }
      }
    },
    "This LUT uses a domain other than 0 to 1, which usually means it is a log or camera conversion LUT rather than a look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses LUT verwendet einen anderen Wertebereich als 0 bis 1. Das bedeutet meist, dass es ein Log- oder Kamera-Konvertierungs-LUT ist und kein Look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta LUT usa un dominio distinto de 0 a 1, lo que suele indicar que es una LUT de conversión log o de cámara y no un look."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette LUT utilise un domaine autre que 0 à 1, ce qui indique généralement une LUT de conversion log ou caméra plutôt qu'un look."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa LUT usa un dominio diverso da 0-1, il che di solito indica una LUT di conversione log o di camera anziché un look."
          }
        }
      }
    },
    "This mask is placed, but its grade is neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
