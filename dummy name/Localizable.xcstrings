    "Red channel. Raising adds red; lowering leans cyan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotkanal. Anheben fügt Rot hinzu; Absenken neigt zu Cyan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canal rojo. Subirlo añade rojo; bajarlo tira hacia el cian."
          }
        },
        "fr" : {
