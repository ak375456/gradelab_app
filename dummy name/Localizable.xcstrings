    "Bold and Italic are available only when this font includes that variation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fett und Kursiv sind nur verfügbar, wenn diese Schrift die jeweilige Variante enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negrita y Cursiva solo están disponibles si esta fuente incluye esa variante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rohkeaa ja kursivoitua on saatavilla vain, jos tämä kirjasin sisältää kyseisen variaation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gras et Italique ne sont disponibles que si cette police contient la variante correspondante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grassetto e Corsivo sono disponibili solo se questo font include quella variante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太字と斜体は、そのフォントに対応するバリエーションがある場合のみ使用できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fet och Kursiv är bara tillgängliga när teckensnittet innehåller den varianten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当此字体包含该变体时，粗体和斜体才可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當此字型包含該變體時，粗體和斜體才可用。"
          }
        }
      }
    },
    "Both" : {
      "comment" : "One of the options for the direction of mask tracking.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Molemmat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambe"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双向"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙向"
          }
        }
      }
    },
    "Both pictures are measured in the same colour space, so an Apple Log clip, an HDR clip, a Rec.709 clip and an imported photograph can be compared honestly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Bilder werden im selben Farbraum gemessen, sodass ein Apple-Log-Clip, ein HDR-Clip, ein Rec.709-Clip und ein importiertes Foto fair verglichen werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas imágenes se miden en el mismo espacio de color, así que un clip Apple Log, un clip HDR, un clip Rec.709 y una fotografía importada pueden compararse con honestidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Molempia kuvia mitataan samanvärisessä tilassa, joten Apple Log -klippiä, HDR-klippiä, Rec.709-klippiä ja tuotua valokuvaa voi verrata rehellisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux images sont mesurées dans le même espace colorimétrique, si bien qu'un plan Apple Log, un plan HDR, un plan Rec.709 et une photographie importée peuvent être comparés loyalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambe le immagini vengono misurate nello stesso spazio colore, così un clip Apple Log, un clip HDR, un clip Rec.709 e una fotografia importata possono essere confrontati lealmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の画像を同じ色空間で測定するため、Apple Log、HDR、Rec.709のクリップや読み込んだ写真も、同じ基準で比較できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda bilderna mäts i samma färgrymd, så ett Apple Log-klipp, ett HDR-klipp, ett Rec.709-klipp och ett importerat fotografi kan jämföras på lika villkor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两张照片都是在同一色彩空间中测量的，因此可以诚实地比较 Apple Log 片段、HDR 片段、Rec.709 片段和导入的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩張照片都是在同一色彩空間中測量的，因此可以誠實地比較 Apple Log 片段、HDR 片段、Rec.709 片段和匯入的照片。"
          }
        }
      }
    },
