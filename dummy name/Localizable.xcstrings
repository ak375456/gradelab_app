    "Recording may stop if the device gets too warm. A lower frame rate or resolution can reduce the camera workload." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme kann bei zu hoher Temperatur stoppen. Eine geringere Bildrate oder Auflösung kann die Kamera entlasten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording may stop if the device gets too warm. A lower frame rate or resolution can reduce the camera workload."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación puede detenerse si el dispositivo se calienta demasiado. Reducir la frecuencia o la resolución puede aliviar la carga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus voi pysähtyä, jos laite kuumenee liikaa. Pienempi kuvataajuus tai tarkkuus voi vähentää kameran kuormitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement peut s’arrêter si l’appareil chauffe trop. Réduire la fréquence d’images ou la résolution peut alléger la charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione può interrompersi se il dispositivo si scalda troppo. Una frequenza o risoluzione inferiore può ridurre il carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが高温になると録画が停止する場合があります。フレームレートや解像度を下げると負荷を軽減できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen kan stoppas om enheten blir för varm. Lägre bildfrekvens eller upplösning kan minska belastningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果设备过热，录制可能会停止。较低的帧率或分辨率可以减少相机的工作量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
