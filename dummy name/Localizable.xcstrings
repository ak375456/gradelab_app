    "Preview keeps the timeline responsive. High is used for export either way." : {
      "comment" : "A description of the optical flow quality setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschau hält die Timeline flüssig. Für den Export wird ohnehin Hoch verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa mantiene la línea de tiempo con respuesta rápida. La exportación usa Alta en cualquier caso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esikatselu pitää aikajanan reagoivana. Korkeaa käytetään vientiin joka tapauksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu garde la timeline réactive. L'export utilise Haute dans tous les cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima mantiene la timeline reattiva. L'esportazione usa Alta in ogni caso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsvisning håller tidslinjen responsiv. Export använder Hög oavsett."
          }
        }
      }
    },
    "Preview Pro looks freely. Unlock Pro to export them, or remove the look to keep exporting free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir Pro-Looks frei in der Vorschau an. Schalte Pro frei, um sie zu exportieren, oder entferne den Look, um weiterhin kostenlos zu exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsualiza los looks Pro sin límites. Desbloquea Pro para exportarlos, o quita el look para que la exportación siga siendo gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esikatsele Pro-tyylejä vapaasti. Avaa Pro viedäksesi ne tai poista tyyli jatkaaksesi ilmaista vientiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévisualisez librement les looks Pro. Déverrouillez Pro pour les exporter, ou retirez le look pour que l'export reste gratuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova liberamente i look Pro in anteprima. Sblocca Pro per esportarli, oppure rimuovi il look per continuare a esportare gratis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsvisa Pro-looks fritt. Lås upp Pro för att exportera dem, eller ta bort looken för att fortsätta exportera gratis."
          }
        }
      }
    },
