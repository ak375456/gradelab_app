        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den konturen var för liten. Rita hela vägen runt objektet."
          }
        }
      }
    },
    "That saves the value you can see right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sichert den Wert, den du gerade siehst."
