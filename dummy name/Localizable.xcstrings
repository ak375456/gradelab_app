            "value" : "Bloom"
          }
        }
      }
    },
    "Bloom, glow, halation and grain. Fade and sharpening stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom, Glow, Halation und Korn. Fade und Schärfen bleiben kostenlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom, glow, halation y grano. El fade y la nitidez siguen siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom, glow, halation et grain. Le fade et la netteté restent gratuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloom, glow, halation e grana. Fade e nitidezza restano gratuiti."
