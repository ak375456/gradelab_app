    "Uses the built-in scene geometry, strongest on people. Runs once, in the background, from the playhead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die integrierte Szenengeometrie, am stärksten bei Personen. Läuft einmal im Hintergrund ab dem Abspielkopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la geometría de escena integrada, que funciona mejor con personas. Se ejecuta una vez, en segundo plano, desde el cabezal de reproducción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käyttää sisäänrakennettua kohtausgeometriaa, joka toimii parhaiten ihmisillä. Suoritetaan kerran taustalla toistokohdasta alkaen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la géométrie de scène intégrée, plus efficace sur les personnes. S’exécute une fois, en arrière-plan, à partir de la tête de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la geometria della scena integrata, più efficace sulle persone. Viene eseguita una volta, in background, dalla testina di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人物に特に適した内蔵のシーン形状推定を使用します。再生ヘッド位置から、バックグラウンドで1回実行します。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder den inbyggda scengeometrin, som fungerar bäst på människor. Körs en gång, i bakgrunden, från uppspelningshuvudet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用内置场景几何估算，对人物效果较好。从播放头位置开始，在后台分析一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用內建場景幾何估算，對人物效果較好。從播放頭位置開始，在後臺分析一次。"
          }
        }
      }
    },
