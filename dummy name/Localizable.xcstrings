    "Lower the threshold for quiet speech. Raise it if background noise keeps the music low." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな声にはしきい値を下げます。背景ノイズで音楽が下がり続ける場合は上げてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻声说话时可降低阈值。如果背景噪声导致音乐持续变小，请提高阈值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕聲說話時可降低閾值。如果背景雜訊導致音樂持續變小，請提高閾值。"
          }
        }
      }
    },
    "Lower this clip under a voice. Select music here, then choose the voice clip below." : {
