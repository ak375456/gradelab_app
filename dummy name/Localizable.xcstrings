        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera masken över ditt motiv. Spårningen börjar vid uppspelningshuvudet."
          }
        }
      }
    },
    "Place the playhead inside the %@ clip." : {
      "localizations" : {
