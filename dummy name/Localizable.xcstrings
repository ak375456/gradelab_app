    "Matte does not cover the entire clip. Outside the matte there is no coverage, so this layer is transparent there." : {
      "comment" : "A warning label explaining that the matte doesn't cover the entire clip, so the layer is transparent outside it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Matte deckt nicht den gesamten Clip ab. Außerhalb der Matte gibt es keine Abdeckung, daher ist diese Ebene dort transparent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máscara no cubre todo el clip. Fuera de la máscara no hay cobertura, así que ahí esta capa es transparente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Matte ei peitä koko leike pintaa. Ullan ulkopuolella ei ole peitettä, joten tämä kerros on läpinäkyvä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache ne couvre pas tout le clip. En dehors du cache il n’y a aucune couverture, ce calque y est donc transparent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maschera non copre l’intera clip. Fuori dalla maschera non c’è copertura, quindi lì questo livello è trasparente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matten täcker inte hela klippet. Utanför matten finns ingen täckning, så det här lagret är genomskinligt där."
          }
        }
      }
    },
