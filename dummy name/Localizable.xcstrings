    "Everything outside the outline is removed. Turn on Invert to cut out the object instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles außerhalb der Kontur wird entfernt. Aktiviere „Invertieren“, um stattdessen das Objekt auszuschneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
