            "value" : "Klippet kunde inte delas vid uppspelningshuvudet."
          }
        }
      }
    },
    "The clip or mask changed. Place the playhead and start tracking again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clip oder Maske haben sich geändert. Setze den Abspielkopf und starte das Tracking neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clip o la máscara han cambiado. Coloca el cabezal y vuelve a iniciar el rastreo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leikkaus tai maski vaihdettiin. Aseta toistokohta ja aloita seuranta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip ou le masque a changé. Placez la tête de lecture et relancez le suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clip o la maschera sono cambiate. Posiziona la testina e riavvia il tracciamento."
