    "Colour blotches within the frame. Guided by the luminance, so colour edges stay where the picture's edges are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbflecken innerhalb des Frames. Von der Luminanz geführt, damit Farbkanten dort bleiben, wo die Kanten des Bildes sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchas de color dentro del fotograma. Guiado por la luminancia, así que los bordes de color se quedan donde están los bordes de la imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ruutu sisällä on värisävyjä, joita valovoima ohjaa, joten värien reunat pysyvät kuvan reunoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taches de couleur à l'intérieur de l'image. Guidé par la luminance, si bien que les contours de couleur restent là où sont ceux de l'image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macchie di colore all'interno del fotogramma. Guidato dalla luminanza, così i bordi di colore restano dove sono quelli dell'immagine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgfläckar inom bildrutan. Styrs av luminansen, så färgkanter stannar där bildens kanter är."
          }
        }
      }
    },
    "Colour mode" : {
