    "This LUT says it is size %lld but contains %lld entries instead of %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses LUT gibt die Größe %lld an, enthält aber %lld Einträge statt %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta LUT dice ser de tamaño %lld, pero contiene %lld entradas en lugar de %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette LUT annonce une taille de %lld mais contient %lld entrées au lieu de %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa LUT dichiara una dimensione di %lld ma contiene %lld voci invece di %lld."
          }
        }
      }
    },
    "This LUT uses a domain other than 0 to 1, which usually means it is a log or camera conversion LUT rather than a look." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
