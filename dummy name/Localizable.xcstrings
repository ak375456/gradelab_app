    "A transition must connect one adjacent pair of video clips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Übergang muss genau ein benachbartes Paar Videoclips verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una transición debe conectar un único par de clips de vídeo adyacentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siirtymän täytyy yhdistää yksi viereinen videopätkäpari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une transition doit relier une seule paire de clips vidéo adjacents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una transizione deve collegare una sola coppia di clip video adiacenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランジションは隣接する2つの動画クリップをつなぐ必要があります。"
          }
        },
        "sv" : {
